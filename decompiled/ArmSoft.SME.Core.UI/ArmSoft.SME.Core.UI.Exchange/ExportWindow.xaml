<?xml version="1.0" encoding="utf-8"?>
<dx:ThemedWindow x:Class="ArmSoft.SME.Core.UI.Exchange.ExportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions" Title="ExportDataWindow" Width="650" Height="610" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" xmlns:exchange="clr-namespace:ArmSoft.SME.Core.UI.Exchange" Icon="{ext:ASImage export_16.svg}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="IconCellTemplate">
        <dx:DXImage Width="16" Height="16" Source="{Binding Path=Value}" />
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <DockPanel LastChildFill="True">
      <Grid DockPanel.Dock="Bottom">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button Name="StartButton" Grid.Row="0" Grid.Column="1" MinWidth="100" Margin="15,0,15,10" HorizontalContentAlignment="Center" UseLayoutRounding="True">Start</Button>
        <Button Name="CancelButton" Grid.Row="0" Grid.Column="2" MinWidth="100" Margin="15,0,15,10" IsCancel="True" UseLayoutRounding="True">Cancel</Button>
      </Grid>
      <dxlc:LayoutControl Name="LayoutControl" VerticalAlignment="Stretch" Orientation="Vertical">
        <dxlc:LayoutGroup>
          <dxg:GridControl Name="ExportDataRowsGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AllowLiveDataShaping="True" AutoGenerateColumns="None" SelectionMode="Cell">
            <dxg:GridControl.Columns>
              <dxg:GridColumn Name="Selected" Width="40" FieldName="Selected" Header="">
                <dxg:ColumnBase.EditSettings>
                  <dxe:CheckEditSettings AllowNullInput="False" />
                </dxg:ColumnBase.EditSettings>
              </dxg:GridColumn>
              <dxg:GridColumn Name="Data" Width="300" AllowEditing="False" FieldName="DataName" />
              <dxg:GridColumn Name="ProgressCount" Width="100" AllowEditing="False" FieldName="ProgressCount">
                <dxg:ColumnBase.EditSettings>
                  <dxe:CalcEditSettings Mask=" #,###,###,##0" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                </dxg:ColumnBase.EditSettings>
              </dxg:GridColumn>
              <dxg:GridColumn Width="32" CellTemplate="{StaticResource IconCellTemplate}" FieldName="IconUnbound" Header="" UnboundType="Object" />
              <dxg:GridColumn Name="ErrorsCount" Width="100" AllowEditing="False" FieldName="ErrorsCount">
                <dxg:ColumnBase.EditSettings>
                  <dxe:CalcEditSettings Mask=" #,###,###,##0" MaskType="Numeric" MaskUseAsDisplayFormat="True" />
                </dxg:ColumnBase.EditSettings>
              </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
              <dxg:TableView Name="ExportDataRowsView" AllowBestFit="True" AllowColumnFiltering="False" EditorButtonShowMode="ShowOnlyInEditor" EditorShowMode="MouseDown" EnterMoveNextColumn="True" IsGroupPanelMenuEnabled="False" IsRowCellMenuEnabled="True" IsTotalSummaryMenuEnabled="False" NavigationStyle="Cell" NewItemRowPosition="None" ShowFocusedRectangle="False" ShowGroupPanel="False" ShowGroupedColumns="False" ShowIndicator="false" ShowTotalSummary="False" />
            </dxg:GridControl.View>
          </dxg:GridControl>
        </dxlc:LayoutGroup>
      </dxlc:LayoutControl>
    </DockPanel>
  </Grid>
</dx:ThemedWindow>
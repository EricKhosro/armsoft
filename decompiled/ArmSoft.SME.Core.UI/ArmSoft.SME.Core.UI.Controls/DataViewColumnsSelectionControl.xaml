<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ArmSoft.SME.Core.UI.Controls.DataViewColumnsSelectionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:local="clr-namespace:ArmSoft.SME.Core.UI.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Name="TBAvailableColumns" Grid.Row="0" Grid.Column="0" Margin="0,0,0,5" HorizontalAlignment="Center" Text="Available columns" UseLayoutRounding="True" />
    <TextBlock Name="TBColumns" Grid.Row="0" Grid.Column="2" Margin="0,0,0,5" HorizontalAlignment="Center" Text="Show columns" UseLayoutRounding="True" />
    <TreeView Name="AvailableColumns" Grid.Row="1" Grid.RowSpan="9" Grid.Column="0" Margin="0,1,0,0" UseLayoutRounding="True" />
    <dx:SimpleButton Name="btAdd" Grid.Row="2" Grid.Column="1" Margin="10" UseLayoutRounding="True">Add</dx:SimpleButton>
    <dx:SimpleButton Name="btRemove" Grid.Row="3" Grid.Column="1" Margin="10,5" UseLayoutRounding="True">Remove</dx:SimpleButton>
    <dx:SimpleButton Name="btMoveUp" Grid.Row="5" Grid.Column="1" Margin="10,5" UseLayoutRounding="True">Up</dx:SimpleButton>
    <dx:SimpleButton Name="btMoveDown" Grid.Row="6" Grid.Column="1" Margin="10,5" UseLayoutRounding="True">Down</dx:SimpleButton>
    <dx:SimpleButton Name="btReset" Grid.Row="8" Grid.Column="1" Margin="10" UseLayoutRounding="True">Reset</dx:SimpleButton>
    <ListBox Name="SelectedColumns" Grid.Row="1" Grid.RowSpan="9" Grid.Column="2" UseLayoutRounding="True" />
    <TextBlock Name="lblFilter" Grid.Row="10" Grid.Column="0" Margin="0,5,10,5" Text="Filter string" UseLayoutRounding="True" />
    <local:TextEditExt x:Name="txtFilter" Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3" Margin="1,1,1,1" HorizontalAlignment="Stretch" VerticalAlignment="Center" ShowBorder="True" Text="" TextWrapping="NoWrap" UseLayoutRounding="True" />
  </Grid>
</UserControl>
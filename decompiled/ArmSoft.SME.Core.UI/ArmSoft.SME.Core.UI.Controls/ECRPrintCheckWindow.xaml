<?xml version="1.0" encoding="utf-8"?>
<dxc:ThemedWindow x:Class="ArmSoft.SME.Core.UI.Controls.ECRPrintCheckWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" Title="ECRTrackingWindow" Width="500" Height="320" ResizeMode="NoResize" ShowIcon="False" ShowInTaskbar="False" SizeToContent="WidthAndHeight" UseLayoutRounding="True" WindowStartupLocation="CenterOwner" xmlns:controls="clr-namespace:ArmSoft.SME.Core.UI.Controls;assembly=ArmSoft.SME.Core.UI">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Label Name="ConnectLabel" Grid.Row="0" Grid.Column="0" Height="22" Margin="15,9,0,9" HorizontalAlignment="Stretch" VerticalAlignment="Center" UseLayoutRounding="True" Content="{Binding Converter={StaticResource CoreResourceConverter}, ConverterParameter=Connecting}" />
    <dxc:DXImage Name="ConnectImage" Grid.Row="0" Grid.Column="1" Width="20" Height="20" Margin="30,0" VerticalAlignment="Center" Stretch="None" UseLayoutRounding="True" />
    <Label Name="LoginLabel" Grid.Row="1" Grid.Column="0" Height="22" Margin="15,7,0,7" HorizontalAlignment="Stretch" VerticalAlignment="Center" UseLayoutRounding="True" Content="{Binding Converter={StaticResource CoreResourceConverter}, ConverterParameter=OperatorLogin}" />
    <dxc:DXImage Name="LoginImage" Grid.Row="1" Grid.Column="1" Width="20" Height="20" Margin="30,0" VerticalAlignment="Center" Stretch="None" UseLayoutRounding="True" />
    <Label Name="PrintingLabel" Grid.Row="2" Grid.Column="0" Height="22" Margin="15,7,0,7" HorizontalAlignment="Stretch" VerticalAlignment="Center" UseLayoutRounding="True" Content="{Binding Converter={StaticResource CoreResourceConverter}, ConverterParameter=PrintingAndGettingNumber}" />
    <dxc:DXImage Name="PrintingImage" Grid.Row="2" Grid.Column="1" Width="20" Height="20" Margin="30,0" VerticalAlignment="Center" Stretch="None" UseLayoutRounding="True" />
    <Label Name="LogoutLabel" Grid.Row="3" Grid.Column="0" Height="22" Margin="15,7,0,7" HorizontalAlignment="Stretch" VerticalAlignment="Center" UseLayoutRounding="True" Content="{Binding Converter={StaticResource CoreResourceConverter}, ConverterParameter=OperatorLogout}" />
    <dxc:DXImage Name="LogoutImage" Grid.Row="3" Grid.Column="1" Width="20" Height="20" Margin="30,0" VerticalAlignment="Center" Stretch="None" UseLayoutRounding="True" />
    <Label Name="DisconnectLabel" Grid.Row="4" Grid.Column="0" Height="22" Margin="15,7,0,7" HorizontalAlignment="Stretch" VerticalAlignment="Center" UseLayoutRounding="True" Content="{Binding Converter={StaticResource CoreResourceConverter}, ConverterParameter=Disconnecting}" />
    <dxc:DXImage Name="DisconnectImage" Grid.Row="4" Grid.Column="1" Width="20" Height="20" Margin="30,0" VerticalAlignment="Center" Stretch="None" UseLayoutRounding="True" />
    <Grid Row="5" ColumnSpan="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Name="CancelButton" Grid.Column="1" MinWidth="100" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Top" UseLayoutRounding="True" Click="CancelButton_Click">
        <StackPanel Orientation="Horizontal">
          <dxc:DXImage Name="ImageCancel" Height="16" Stretch="Uniform" />
          <Label Name="LabelCancel" Margin="5,0,0,1" VerticalAlignment="Center" Content="Cancel" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</dxc:ThemedWindow>
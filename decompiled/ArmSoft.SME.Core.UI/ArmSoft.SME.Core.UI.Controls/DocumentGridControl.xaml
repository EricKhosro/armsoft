<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ArmSoft.SME.Core.UI.Controls.DocumentGridControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:ArmSoft.SME.Core.UI.Converters" xmlns:core="clr-namespace:ArmSoft.SME.Core.UI.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <conv:ConvertStringToImage x:Key="ConvertStringToImage" />
      <conv:DeletedRowTextStyle x:Key="DeletedRowTextStyle" />
      <conv:NumericValueToIsNegative x:Key="NumericValueToIsNegative" />
      <conv:GetCurrentForegroundBrush x:Key="ForegroundBrush" />
      <conv:SelectedBackground x:Key="SelectedBackground" />
      <conv:FocusedRowBackground x:Key="FocusedRowBackground" />
      <Style x:Key="RowStyle" TargetType="{x:Type dxg:RowControl}">
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding Path=IsReadOnly, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=core:DocumentGridControl, Mode=FindAncestor}}">
            <Setter Property="Foreground" Value="#FF7F7F7F" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="FocusedCellStyle" TargetType="{x:Type dxg:LightweightCellEditor}" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
        <Setter Property="FrameworkElement.Tag" Value="{Binding Column.Name}" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsSelected}">
            <Setter Property="dxg:LightweightCellEditor.Background" Value="{Binding Converter={StaticResource SelectedBackground}}" />
          </DataTrigger>
          <Trigger Property="dxg:DataViewBase.IsFocusedCell" Value="True">
            <Setter Property="dxg:LightweightCellEditor.Background" Value="{Binding Converter={StaticResource FocusedRowBackground}}" />
            <Setter Property="dxg:LightweightCellEditorBase.Foreground" Value="{Binding Converter={StaticResource ForegroundBrush}}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <DataTemplate x:Key="DateEditTemplate">
        <core:DateEditControl x:Name="PART_Editor" AllowSpin="False" IsCalledFromGrid="True" ShowBorder="False" UseLongDate="False" />
      </DataTemplate>
      <DataTemplate x:Key="DateLongEditTemplate">
        <core:DateEditControl x:Name="PART_Editor" AllowSpin="False" IsCalledFromGrid="True" ShowBorder="False" UseLongDate="True" />
      </DataTemplate>
      <ControlTemplate x:Key="ImageButton" TargetType="{x:Type Button}">
        <dx:DXImage Width="16" Height="16" SnapsToDevicePixels="True" Source="{TemplateBinding Content, Converter={StaticResource ConvertStringToImage}}" />
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsEnabled" Value="True">
            <Setter Property="UIElement.Opacity" Value="1" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter Property="UIElement.Opacity" Value="0.5" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <ControlTemplate x:Key="NumericColumnTemplate">
        <TextBlock Name="PART_Editor" Padding="2,2,3,2" Foreground="{Binding Path=EditValue, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NumericValueToIsNegative}}" TextDecorations="{Binding Path=DataContext.RowData.Row.IsDeleted, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DeletedRowTextStyle}}" />
      </ControlTemplate>
      <ControlTemplate x:Key="TextColumnTemplate">
        <TextBlock Name="PART_Editor" Padding="2,2,3,2" TextDecorations="{Binding Path=DataContext.RowData.Row.IsDeleted, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DeletedRowTextStyle}}" />
      </ControlTemplate>
      <DataTemplate x:Key="Column2RowHeaderTemplate">
        <TextBox Margin="-4,-2,-2,-2" AutoWordSelection="False" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0" Focusable="True" IsReadOnly="True" MaxLines="2" SelectionBrush="#00FFFFFF" TextWrapping="Wrap" Text="{Binding Mode=OneWay}" ToolTip="{Binding Mode=OneWay}" MouseDoubleClick="PreventMouseClick" MouseLeftButtonDown="PreventMouseClick">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type TextBox}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Name="border" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
                      <ScrollViewer Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="TextBoxBase.IsReadOnly" Value="True">
                        <Setter TargetName="border" Property="UIElement.Opacity" Value="1" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </FrameworkElement.Style>
        </TextBox>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid dxb:BarNameScope.IsScopeOwner="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <dxb:ToolBarControl Name="ButtonsToolbar" AllowCustomizationMenu="False" AllowQuickCustomization="False" GlyphSize="Small" IsMultiLine="True" IsTabStop="False">
        <dxb:BarButtonItem Name="ButtonAdd" ToolTipService.ShowOnDisabled="True" Glyph="{ext:ASImage add_16.svg}" />
        <dxb:BarButtonItem Name="ButtonViewEdit" ToolTipService.ShowOnDisabled="True" Glyph="{ext:ASImage edit_16.svg}" />
        <dxb:BarButtonItem Name="ButtonDelete" ToolTipService.ShowOnDisabled="True" Glyph="{ext:ASImage delete_16.svg}" />
        <dxb:BarButtonItem Name="ButtonDuplicate" ToolTipService.ShowOnDisabled="True" Glyph="{ext:ASImage doc_copy_16.svg}" />
        <dxb:BarButtonItem Name="ButtonInsert" ToolTipService.ShowOnDisabled="True" Glyph="{ext:ASImage table_row_insert.svg}" />
        <dxb:BarButtonItem Name="ButtonMoveUp" ToolTipService.ShowOnDisabled="True" Glyph="{ext:ASImage arrow_up_16.svg}" />
        <dxb:BarButtonItem Name="ButtonMoveDown" ToolTipService.ShowOnDisabled="True" Glyph="{ext:ASImage arrow_down_16.svg}" />
      </dxb:ToolBarControl>
    </Grid>
    <dxg:GridControl Name="InnerGrid" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AllowLiveDataShaping="True" AutoGenerateColumns="None" SelectionMode="Cell">
      <dxg:GridControl.View>
        <dxg:TableView Name="InnerView" AllowBestFit="True" AllowColumnFiltering="False" AllowConditionalFormattingManager="True" AllowConditionalFormattingMenu="True" AllowFormatConditionFiltersMenu="False" AllowLeaveFocusOnTab="True" CellStyle="{StaticResource FocusedCellStyle}" EditorButtonShowMode="ShowForFocusedCell" EditorShowMode="MouseDown" EnterMoveNextColumn="True" IsGroupPanelMenuEnabled="False" IsRowCellMenuEnabled=" True" IsTotalSummaryMenuEnabled="False" NavigationStyle="Cell" NewItemRowPosition="None" ScrollBarAnnotationMode="InvalidRows" SearchPanelParseMode="Mixed" ShowFocusedRectangle="False" ShowGroupPanel="False" ShowGroupedColumns="False" ShowTotalSummary="False" VerticalScrollbarVisibility="Auto" />
      </dxg:GridControl.View>
    </dxg:GridControl>
  </Grid>
</UserControl>
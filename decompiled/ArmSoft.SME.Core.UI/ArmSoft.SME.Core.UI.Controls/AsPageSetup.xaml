<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ArmSoft.SME.Core.UI.Controls.AsPageSetup" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxl="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="clr-namespace:ArmSoft.SME.Core.UI.Controls">
  <Control.Background>
    <SolidColorBrush />
  </Control.Background>
  <Grid IsSharedSizeScope="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" SharedSizeGroup="First" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <dxl:LayoutControl Grid.Row="0" Grid.Column="0" Margin="-5">
      <dxl:LayoutGroup Name="gbPaperOrientation" Padding="5" VerticalAlignment="Stretch" Header="Paper Orientation" Orientation="Vertical" UseLayoutRounding="True" View="GroupBox">
        <dxl:LayoutItem>
          <RadioButton Name="chkPortrait" VerticalContentAlignment="Center" GroupName="Group2">
            <ContentControl.Content>
              <StackPanel Orientation="Horizontal">
                <dx:DXImage Width="32" Height="32" Margin="5" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{ext:ASImage print_portrait_32.svg}" />
                <TextBlock Name="txtPortrait" Margin="0,10,0,10" HorizontalAlignment="Center" VerticalAlignment="Center">Portrait</TextBlock>
              </StackPanel>
            </ContentControl.Content>
          </RadioButton>
        </dxl:LayoutItem>
        <dxl:LayoutItem>
          <RadioButton Name="chkLandscape" VerticalContentAlignment="Center" GroupName="Group2">
            <ContentControl.Content>
              <StackPanel Orientation="Horizontal">
                <dx:DXImage Width="32" Height="32" Margin="5" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{ext:ASImage print_landscape_32.svg}" />
                <TextBlock Name="txtLandscape" Margin="0,10,0,10" VerticalAlignment="Center">Landscape</TextBlock>
              </StackPanel>
            </ContentControl.Content>
          </RadioButton>
        </dxl:LayoutItem>
      </dxl:LayoutGroup>
    </dxl:LayoutControl>
    <dxl:LayoutControl Grid.Row="0" Grid.Column="1" Margin="-5">
      <dxl:LayoutGroup Name="gbMargins" Padding="5" VerticalAlignment="Stretch" Header="Margins" Orientation="Vertical" UseLayoutRounding="True" View="GroupBox">
        <dxl:LayoutItem Name="MarginsLeft" Label="Left">
          <ContentControl HorizontalAlignment="Left">
            <dxe:PopupCalcEdit Name="txtMarginsLeft" Width="70" />
          </ContentControl>
        </dxl:LayoutItem>
        <dxl:LayoutItem Name="MarginsRight" Label="Right">
          <ContentControl HorizontalAlignment="Left">
            <dxe:PopupCalcEdit Name="txtMarginsRight" Width="70" />
          </ContentControl>
        </dxl:LayoutItem>
        <dxl:LayoutItem Name="MarginsTop" Label="Top">
          <ContentControl HorizontalAlignment="Left">
            <dxe:PopupCalcEdit Name="txtMarginsTop" Width="70" />
          </ContentControl>
        </dxl:LayoutItem>
        <dxl:LayoutItem Name="MarginsBottom" Label="Bottom">
          <ContentControl HorizontalAlignment="Left">
            <dxe:PopupCalcEdit Name="txtMarginsBottom" Width="70" />
          </ContentControl>
        </dxl:LayoutItem>
      </dxl:LayoutGroup>
    </dxl:LayoutControl>
    <dxl:LayoutControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="-5,0,-5,0" Padding="12,0,12,0" VerticalAlignment="Stretch">
      <dxl:LayoutGroup Name="gbPrintTitle" Header="Print Title" Orientation="Vertical" UseLayoutRounding="True" View="GroupBox">
        <dxl:LayoutGroup Orientation="Horizontal" View="Group">
          <dxl:LayoutItem Name="LPrintTitleAlways">
            <ContentControl>
              <RadioButton Name="PrintTitleAlways" Content="Print always" GroupName="Grouptitle" />
            </ContentControl>
          </dxl:LayoutItem>
          <dxl:LayoutItem Name="LPrintTitleIfOpen">
            <ContentControl>
              <RadioButton Name="PrintTitleIfOpen" Margin="5,0,0,0" Content="Print if open" GroupName="Grouptitle" />
            </ContentControl>
          </dxl:LayoutItem>
          <dxl:LayoutItem Name="LPrintTitleDoNotPrint">
            <ContentControl>
              <RadioButton Name="PrintTitleDoNotPrint" Margin="5,0,0,0" Content="Do not print" GroupName="Grouptitle" />
            </ContentControl>
          </dxl:LayoutItem>
        </dxl:LayoutGroup>
        <dxl:LayoutGroup>
          <dxl:LayoutItem>
            <dxe:CheckEdit Name="PrintFilter" Margin="0,5,0,0" Content="Print grid rows filter" />
          </dxl:LayoutItem>
        </dxl:LayoutGroup>
      </dxl:LayoutGroup>
    </dxl:LayoutControl>
    <dxl:LayoutControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="-5" VerticalAlignment="Stretch">
      <dxl:LayoutGroup Name="gbAilMain" Orientation="Horizontal" UseLayoutRounding="True" View="GroupBox">
        <dxl:LayoutGroup Name="gbAil" Orientation="Vertical" View="Group">
          <dxl:LayoutItem>
            <dxe:CheckEdit Name="PrintDate" Content="Print Date" />
          </dxl:LayoutItem>
          <dxl:LayoutItem>
            <dxe:CheckEdit Name="PrintPageNumbers" Margin="0,5,0,0" Content="Print Page Numbers" />
          </dxl:LayoutItem>
          <dxl:LayoutItem>
            <dxe:CheckEdit Name="BreakPages" Margin="0,5,0,0" Content="Enable page breaks" />
          </dxl:LayoutItem>
        </dxl:LayoutGroup>
        <dxl:LayoutGroup Name="gbAilInfo" Orientation="Vertical" View="Group">
          <dxl:LayoutItem>
            <dxe:CheckEdit Name="CompanyName" Content="Print company name" />
          </dxl:LayoutItem>
          <dxl:LayoutItem>
            <dxe:CheckEdit Name="AsInfo" Margin="0,5,0,0" Content="Print AS system caption" />
          </dxl:LayoutItem>
          <dxl:LayoutItem>
            <dxe:CheckEdit Name="ShowLines" Margin="0,5,0,0" Content="Show gridlines in printable forms" />
          </dxl:LayoutItem>
          <dxl:LayoutItem Name="Scale" Label="Scale percent">
            <ContentControl HorizontalAlignment="Left">
              <dxe:SpinEdit Name="txtScale" Width="70" AllowSpinOnMouseWheel="False" Increment="5" MaxValue="150" MinValue="10" Value="100" />
            </ContentControl>
          </dxl:LayoutItem>
          <dxl:LayoutItem>
            <dxe:CheckEdit Name="FitToPage" Margin="0,5,0,0" Content="Fit to page width" />
          </dxl:LayoutItem>
        </dxl:LayoutGroup>
      </dxl:LayoutGroup>
    </dxl:LayoutControl>
  </Grid>
</UserControl>
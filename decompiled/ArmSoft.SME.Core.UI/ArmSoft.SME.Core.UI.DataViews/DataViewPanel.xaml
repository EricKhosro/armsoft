<?xml version="1.0" encoding="utf-8"?>
<core:DataViewRibbonSupportedPanel x:Class="ArmSoft.SME.Core.UI.DataViews.DataViewPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:ArmSoft.SME.Core.UI.Converters" xmlns:core="clr-namespace:ArmSoft.SME.Core.UI" xmlns:coreCommon="clr-namespace:ArmSoft.SME.Common;assembly=ArmSoft.SME.Common" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys" xmlns:dxp="http://schemas.devexpress.com/winfx/2008/xaml/printing" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions" xmlns:local="clr-namespace:ArmSoft.SME.Core.UI.DataViews" Caption=" ">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <conv:IntegerToString x:Key="IntegerToString" />
      <conv:SummaryTypeTyText x:Key="SummaryTypeTyText" />
      <conv:LabelWidthBySummaryType x:Key="LabelWidthBySummaryType" />
      <conv:SummaryToFormattedText x:Key="SummaryToFormattedText" />
      <conv:SummaryToFontWeight x:Key="SummaryToFontWeight" />
      <conv:SelectedBackground x:Key="SelectedBackground" />
      <conv:GetFontFamily x:Key="GetFontFamily" />
      <conv:GetFontSize x:Key="GetFontSize" />
      <conv:FocusedRowBackground x:Key="FocusedRowBackground" />
      <conv:CoreResourceConverter x:Key="CoreResourceConverter" />
      <conv:ImageSourceToVisibility x:Key="ImageSourceToVisibility" />
      <conv:ColorConverter x:Key="ColorConverter" />
      <local:TotalSummaryConverter x:Key="TotalSummaryConverter" />
      <conv:GetForegroundLinkBrush x:Key="ForegroundLinkBrush" />
      <conv:GetForegroundFilterBrush x:Key="ForegroundFilterBrush" />
      <conv:GetIsNewBackgroundBrush x:Key="IsNewBackgroundBrush" />
      <DataTemplate x:Key="EmptyTemplate">
        <Label Visibility="Collapsed" Content="{Binding Value}" />
      </DataTemplate>
      <DataTemplate x:Key="GroupRowHeaderTemplate">
        <TextBlock Margin="10,0,0,0" Text="{Binding Value}" />
      </DataTemplate>
      <local:MySelector x:Key="mySelector" EmptyTemplate="{StaticResource EmptyTemplate}" />
      <ControlTemplate x:Key="{dxgt:GridCardThemeKey ResourceKey=HeaderPanelTemplate, IsThemeIndependent=True}" TargetType="{x:Type ContentControl}" />
      <Style x:Key="MyPrintEditStyle" TargetType="{x:Type dxe:BaseEdit}" BasedOn="{StaticResource {dxgt:TableViewThemeKey ResourceKey=DefaultPrintCellStyle}}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{Binding Converter={StaticResource GetFontFamily}}" />
      </Style>
      <Style x:Key="PrintColumnHeaderStyle" TargetType="{x:Type dxe:BaseEdit}" BasedOn="{StaticResource {dxgt:TableViewThemeKey ResourceKey=DefaultPrintStyleBase}}">
        <Setter Property="Background" Value="{Binding Converter={StaticResource FocusedRowBackground}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="50" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextBlock.TextAlignment" Value="Center" />
      </Style>
      <Style x:Key="PrintTotalSummaryStyle" TargetType="{x:Type dxe:TextEdit}" BasedOn="{StaticResource {dxgt:TableViewThemeKey ResourceKey=DefaultPrintTotalSummaryStyle}}">
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="{x:Type dxg:GroupValueSeparator}" TargetType="{x:Type dxg:GroupValueSeparator}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="2,0,0,0" />
      </Style>
      <Style x:Key="CheckboxSelectorColumStyle" TargetType="{x:Type dxg:GridColumn}">
        <Style.Triggers>
          <Trigger Property="dxg:ColumnBase.FieldName" Value="{x:Static dxg:TableView.CheckBoxSelectorColumnName}">
            <Setter Property="dxg:ColumnBase.CellTemplate">
              <Setter.Value>
                <DataTemplate>
                  <dxe:CheckEdit Name="PART_Editor" Margin="0" Padding="0">
                    <FrameworkElement.LayoutTransform>
                      <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                    </FrameworkElement.LayoutTransform>
                  </dxe:CheckEdit>
                </DataTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="CellStyle" TargetType="{x:Type dxg:LightweightCellEditor}" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
        <Setter Property="FrameworkElement.Tag" Value="{Binding Column.Name}" />
      </Style>
      <Style x:Key="AutoFilterCellStyle" TargetType="{x:Type dxg:FilterCellContentPresenter}" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=CellStyle}}">
        <Setter Property="FrameworkElement.Tag" Value="{Binding Column.Name}" />
      </Style>
      <DataTemplate x:Key="SelectorColumnHeaderTemplate">
        <dxe:CheckEdit Name="chkFilter" Padding="0,0,-1,0" IsEnabled="True" IsHitTestVisible="True" IsThreeState="False" IsChecked="{Binding Path=SelectedFilter, RelativeSource={RelativeSource FindAncestor, AncestorType=local:DataViewPanel}}" ToolTip="{Binding ConverterParameter=Filter, Converter={StaticResource CoreResourceConverter}}" EditValueChanged="FilterSelectedChecked" />
      </DataTemplate>
      <DataTemplate x:Key="SelectorColumnHeaderWin11Template">
        <dxe:CheckEdit Name="chkFilter" Padding="-3,0,-2,0" IsEnabled="True" IsHitTestVisible="True" IsThreeState="False" IsChecked="{Binding Path=SelectedFilter, RelativeSource={RelativeSource FindAncestor, AncestorType=local:DataViewPanel}}" ToolTip="{Binding ConverterParameter=Filter, Converter={StaticResource CoreResourceConverter}}" EditValueChanged="FilterSelectedChecked" />
      </DataTemplate>
      <DataTemplate x:Key="Column2RowHeaderTemplate">
        <TextBlock Margin="0" TextWrapping="Wrap" Text="{Binding}" />
      </DataTemplate>
      <DataTemplate x:Key="ColumnToImage">
        <dxc:DXImage Name="PART_Editor" Width="16" Height="16" Margin="0" Stretch="Fill" Source="{Binding Path=Value}" Tag="{Binding Path=RowData.Row}" MouseEnter="ShowTooltip" MouseLeave="CloseToolTip" />
      </DataTemplate>
      <DataTemplate x:Key="ColumnTemplate">
        <TextBlock FontSize="10" FontStretch="Condensed" FontStyle="Italic" FontWeight="Heavy" Foreground="#FFFF0000" Text="{Binding Path=Column.ColSortIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource IntegerToString}}" />
      </DataTemplate>
      <Style x:Key="RowStyle" TargetType="{x:Type dxg:RowControl}">
        <Setter Property="FontWeight" Value="Normal" />
        <Style.Triggers>
          <Trigger Property="dxg:DataViewBase.IsFocusedRow" Value="True">
            <Setter Property="Background" Value="{Binding Converter={StaticResource FocusedRowBackground}}" />
          </Trigger>
          <DataTrigger Value="True" Binding="{Binding Path=IsSelected}">
            <Setter Property="Background" Value="{Binding Converter={StaticResource SelectedBackground}}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="GroupGridRowContentStyle" TargetType="{x:Type dxg:GroupRowControl}">
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding Path=IsSelected}">
            <Setter Property="Background" Value="#00FFFFFF" />
          </DataTrigger>
          <Trigger Property="dxg:DataViewBase.IsFocusedRow" Value="True">
            <Setter Property="Background" Value="{Binding Converter={StaticResource FocusedRowBackground}}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SelectedTreeRowStyle" TargetType="{x:Type dxg:RowControl}">
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding Path=IsChecked, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
            <Setter Property="Background" Value="{Binding Converter={StaticResource SelectedBackground}}" />
          </DataTrigger>
          <Trigger Property="dxg:DataViewBase.IsFocusedRow" Value="True">
            <Setter Property="Background" Value="{Binding Converter={StaticResource FocusedRowBackground}}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SelectedSummaryStyle" TargetType="{x:Type dxc:DataContentPresenter}">
        <Setter Property="ContentTemplate">
          <Setter.Value>
            <DataTemplate x:Name="TotalsTemplate">
              <ListBox Name="TotalSummaryList" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Path=Column.TotalSummaries}" Tag="{Binding Path=Column.FieldName, Converter={StaticResource TotalSummaryConverter}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel LastChildFill="True">
                      <TextBlock Margin="0,0,1,0" VerticalAlignment="Center" DockPanel.Dock="Left" Width="{Binding Item, Converter={StaticResource LabelWidthBySummaryType}}" Text="{Binding Item, Converter={StaticResource SummaryTypeTyText}}" />
                      <dxe:TextEdit Name="txtTotal" Margin="0" Padding="0" HorizontalContentAlignment="Right" VerticalContentAlignment="Bottom" BorderBrush="#00FFFFFF" DockPanel.Dock="Left" IsReadOnly="True" SelectAllOnGotFocus="True" ShowBorder="True" Visibility="Visible" Background="{Binding Item, Mode=OneWay, Converter={StaticResource SelectedBackground}}" EditValue="{Binding Mode=OneWay, Converter={StaticResource SummaryToFormattedText}}" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemContainerStyle>
                  <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Padding" Value="0" />
                  </Style>
                </ItemsControl.ItemContainerStyle>
              </ListBox>
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="ButtonColumn">
        <Button Name="PART_Editor" Width="Auto" Padding="0" Tag="{Binding Path=RowData.Row}">
          <dxc:DXImage Width="16" Height="16" Margin="0" Stretch="Fill" Source="{ext:ASImage image-icon.svg}" />
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="ReportHeader">
        <StackPanel Orientation="Vertical">
          <dxe:TextEdit HorizontalAlignment="Left" FontSize="12" EditValue="{Binding Content.CompanyName, Mode=OneWay}" FontFamily="{Binding Converter={StaticResource GetFontFamily}}" />
          <dxe:TextEdit HorizontalAlignment="Left" FontSize="14" FontWeight="Bold" EditValue="{Binding Content.Caption, Mode=OneWay}" FontFamily="{Binding Converter={StaticResource GetFontFamily}}" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="PanelsHeader">
        <TextBlock HorizontalAlignment="Left" FontSize="12" Text="{Binding Path=(dxdo:DockLayoutManager.LayoutItem).Caption, RelativeSource={RelativeSource Self}}" />
      </DataTemplate>
      <DataTemplate x:Key="PageFooter">
        <Grid Width="{Binding Path=UsablePageWidth, Mode=OneWay}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <dxe:TextEdit Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" dxp:ExportSettings.TargetType="PageNumber" dxp:PageNumberExportSettings.Kind="Number" IsPrintingMode="True" />
          <dxe:TextEdit Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" dxp:ExportSettings.TargetType="Text" IsPrintingMode="True" EditValue="{Binding Content}" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="ColorConverterTemplate">
        <dxe:TextEdit Name="PART_Editor" Margin="0" Padding="0" BorderThickness="0" Foreground="#00FFFFFF" ShowBorder="False" Background="{Binding Path=Value, Converter={StaticResource ColorConverter}}" />
      </DataTemplate>
      <DataTemplate x:Key="NewFunctionTemplate">
        <StackPanel Orientation="Horizontal" Width="300">
          <TextBlock MaxWidth="250" TextTrimming="CharacterEllipsis" Text="{Binding}" />
          <Border Name="IsNewText" Margin="10,0,10,0" Padding="4,2" VerticalAlignment="Center" HorizontalAlignment="Right" CornerRadius="6" Background="{Binding Converter={StaticResource IsNewBackgroundBrush}}">
            <TextBlock VerticalAlignment="Center" FontSize="9" FontWeight="Regular" Foreground="#FFFFFFFF" LineHeight="12" Text="{x:Static coreCommon:Resources.NewForAddedFeature}" FontFamily="{Binding Converter={StaticResource GetFontFamily}}" />
          </Border>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="FilterTemplate">
        <TextBlock MaxWidth="200" TextTrimming="CharacterEllipsis" Foreground="{Binding Converter={StaticResource ForegroundFilterBrush}}" Text="{Binding}" />
      </DataTemplate>
      <DataTemplate x:Key="CopyTemplate">
        <TextBlock MaxWidth="200" TextTrimming="CharacterEllipsis" Text="{Binding}" />
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <dxdo:BaseLayoutItem.CaptionTemplate>
    <DataTemplate>
      <Grid MaxWidth="{Binding Path=(dxdo:DockLayoutManager.LayoutItem).TabCaptionWidth, RelativeSource={RelativeSource Self}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <dxe:ButtonEdit Grid.Column="0" Margin="0,0,4,0" Padding="0" VerticalAlignment="Center" AllowDefaultButton="False" Background="#00FFFFFF" ShowBorder="False" ShowText="False" Visibility="{Binding Path=(dxdo:DockLayoutManager.LayoutItem).HeaderImage, Converter={StaticResource ImageSourceToVisibility}, RelativeSource={RelativeSource Self}}">
          <dxe:ButtonEdit.Buttons>
            <dxe:LoadingIndicatorButtonInfo />
          </dxe:ButtonEdit.Buttons>
        </dxe:ButtonEdit>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding Path=(dxdo:DockLayoutManager.LayoutItem).Caption, RelativeSource={RelativeSource Self}}" />
      </Grid>
    </DataTemplate>
  </dxdo:BaseLayoutItem.CaptionTemplate>
</core:DataViewRibbonSupportedPanel>
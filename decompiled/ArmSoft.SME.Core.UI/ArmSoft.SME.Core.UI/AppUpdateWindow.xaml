                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:2.70">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/19.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:2.85">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/20.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:3.00">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/21.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:3.15">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/22.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                  </ObjectAnimationUsingKeyFrames>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </FrameworkElement.Triggers>
        </dx:DXImage>
      </Grid>
      <StackPanel VerticalAlignment="Top">
        <TextBlock Name="TBApplicationName" Text="Application name" FontSize="14" FontWeight="Bold" UseLayoutRounding="True" />
        <TextBlock Name="TBUpdateState" Padding="5,0,0,0" FontSize="12" TextWrapping="Wrap" UseLayoutRounding="True" />
      </StackPanel>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
        <TextBlock Name="TBCurrentVersion" HorizontalAlignment="Right" Text="Version 7.X.YY.Z" FontSize="11" UseLayoutRounding="True" />
        <TextBlock Name="TBKey" HorizontalAlignment="Right" Text="Key xxxxxxxx" FontSize="11" UseLayoutRounding="True" />
      </StackPanel>
    </dxlc:LayoutGroup>
    <TextBlock Name="TBUpdateInformation" Margin="0,5,0,0" VerticalAlignment="Top" Text="Update Information" FontSize="14" FontWeight="Bold" UseLayoutRounding="True" />
    <Rectangle Name="Line1" Height="2" />
    <dxlc:LayoutItem Name="LIVersion" Label="Version">
      <TextBlock Name="TBVersion" Margin="10,0,0,0" HorizontalAlignment="Left" />
    </dxlc:LayoutItem>
    <dxlc:LayoutItem Name="LIPublished" Label="Published">
      <TextBlock Name="TBPublished" Margin="10,0,0,0" HorizontalAlignment="Left" />
    </dxlc:LayoutItem>
    <dxlc:LayoutItem Name="LISize" Label="Size">
      <TextBlock Name="TBSize" Margin="10,0,0,0" HorizontalAlignment="Left" />
    </dxlc:LayoutItem>
    <dxlc:LayoutItem Name="LISummary" VerticalAlignment="Stretch" Label="Summary" LabelPosition="Top">
      <TextBox Name="TBSummary" AcceptsReturn="True" IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap" UseLayoutRounding="True" VerticalScrollBarVisibility="Auto" />
    </dxlc:LayoutItem>
    <Grid Name="ButtonsPanel" VerticalAlignment="Bottom">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Name="OkButton" Grid.Row="0" Grid.Column="1" Height="26" MinWidth="100" Margin="15,2,15,-7" HorizontalContentAlignment="Center" UseLayoutRounding="True" Click="OkButton_Click">Check</Button>
      <Button Name="CancelButton" Grid.Row="0" Grid.Column="2" Height="26" MinWidth="100" Margin="15,2,15,-7" IsCancel="True" UseLayoutRounding="True">Cancel</Button>
    </Grid>
  </dxlc:LayoutControl>
</dx:ThemedWindow>
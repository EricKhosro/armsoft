<?xml version="1.0" encoding="utf-8"?>
<dx:ThemedWindow x:Class="ArmSoft.SME.Core.UI.AppUpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions" xmlns:local="clr-namespace:ArmSoft.SME.Core.UI" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="AppUpdateWindow" Width="550" Height="420" ShowIcon="False" WindowStartupLocation="CenterOwner">
  <dxlc:LayoutControl Orientation="Vertical">
    <dxlc:LayoutGroup>
      <Grid Margin="5,0" HorizontalAlignment="Left" VerticalAlignment="Bottom">
        <dx:DXImage Name="popupStaticImage" Grid.Row="0" Grid.Column="0" Width="48" Height="48" VerticalAlignment="Top" Stretch="None" UseLayoutRounding="True" Source="{ext:ASImage checking_update_48.svg}" />
        <dx:DXImage Name="checkingAnimation48" Grid.Row="0" Grid.Column="0" Width="48" Height="48" VerticalAlignment="Top" Stretch="None" UseLayoutRounding="True" Source="{ext:ASImage checking_update_48.svg}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Image}">
              <Setter Property="Visibility" Value="Collapsed" />
            </Style>
          </FrameworkElement.Style>
          <UIElement.Clip>
            <EllipseGeometry Center="24,48" RadiusX="0" RadiusY="0" />
          </UIElement.Clip>
          <FrameworkElement.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation AutoReverse="False" RepeatBehavior="Forever" Storyboard.TargetProperty="(Clip).(EllipseGeometry.RadiusX)" From="0" To="48" Duration="0:0:1" />
                  <DoubleAnimation AutoReverse="False" RepeatBehavior="Forever" Storyboard.TargetProperty="(Clip).(EllipseGeometry.RadiusY)" From="0" To="50" Duration="0:0:1" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </FrameworkElement.Triggers>
        </dx:DXImage>
        <dx:DXImage Name="DownloadAnimation48" Grid.Row="0" Grid.Column="0" Width="48" Height="48" VerticalAlignment="Top" Stretch="None" UseLayoutRounding="True" Source="{ext:ASImage 01.png, AdditionalPath=UpdateDownload}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Image}">
              <Setter Property="Visibility" Value="Collapsed" />
            </Style>
          </FrameworkElement.Style>
          <FrameworkElement.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetProperty="(Image.Source)" Duration="00:00:3.30">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/01.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:0.15">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/02.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:0.30">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/03.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:0.45">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/04.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:0.60">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/05.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:0.75">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/06.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:0.90">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/07.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:1.05">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/08.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:1.20">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/09.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:1.35">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/10.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:1.50">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/11.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:1.65">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/12.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:1.80">

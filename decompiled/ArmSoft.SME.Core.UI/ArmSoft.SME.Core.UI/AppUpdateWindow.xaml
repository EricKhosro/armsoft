                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:2.10">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/15.png" />
                      </ObjectKeyFrame.Value>
                    </DiscreteObjectKeyFrame>
                    <DiscreteObjectKeyFrame KeyTime="00:00:2.25">
                      <ObjectKeyFrame.Value>
                        <BitmapImage UriSource="pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/UpdateDownload/16.png" />

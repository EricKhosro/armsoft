<?xml version="1.0" encoding="utf-8"?>
<dx:ThemedWindow x:Class="ArmSoft.SME.Core.UI.OfflineLoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ArmSoft.SME.Core.UI.Controls" xmlns:conv="clr-namespace:ArmSoft.SME.Core.UI.Converters" xmlns:coreCommon="clr-namespace:ArmSoft.SME.Common;assembly=ArmSoft.SME.Common" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions" xmlns:local="clr-namespace:ArmSoft.SME.Core.UI" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="CloudLoginWindow" Width="568" Height="600" Padding="0" BorderThickness="0" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="False" UseLayoutRounding="True" WindowStartupLocation="CenterOwner" WindowStyle="None">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <conv:SystemSpecificButtonBackgroundColor x:Key="SystemSpecificButtonBackgroundColor" />
      <conv:CloudLoginButtonForegroundColorConverter x:Key="CloudLoginButtonForegroundColorConverter" />
      <conv:LoginBackgroundColor x:Key="LoginBackgroundColor" />
      <Style x:Key="ButtonStyle" TargetType="{x:Type dx:SimpleButton}">
        <Setter Property="Background" Value="{Binding Converter={StaticResource SystemSpecificButtonBackgroundColor}}" />
        <Setter Property="Foreground" Value="{Binding Converter={StaticResource CloudLoginButtonForegroundColorConverter}}" />
        <Setter Property="dx:SimpleButton.CornerRadius" Value="5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="dx:SimpleButton.CornerRadius" Value="4" />
        <Setter Property="Height" Value="40" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{Binding Converter={StaticResource SystemSpecificButtonBackgroundColor}}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="LoginContent" UseLayoutRounding="True" Background="{Binding Converter={StaticResource LoginBackgroundColor}}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="93" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="93" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="66" />
      <RowDefinition Height="80" />
      <RowDefinition Height="40" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="100" />
    </Grid.RowDefinitions>
    <Button Name="CloseTitleButton" Grid.Row="0" Grid.Column="3" Width="22" Height="22" Margin="2,2,2,2" HorizontalAlignment="Right" VerticalAlignment="Top" IsTabStop="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" ToolTip="{x:Static coreCommon:Resources.Close}" UseLayoutRounding="True">
      <dx:DXImage Source="{ext:ASImage close_16.svg}" />
    </Button>
    <dx:DXImage Name="AS_Logo_Image" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="2" Width="106" Height="74" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" UseLayoutRounding="True" Source="{ext:ASImage AS_Logo.svg}" />
    <TextBlock Name="TBWorkBegin" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" FontSize="21" Text="{x:Static coreCommon:Resources.LoginOffline}" UseLayoutRounding="True" />
    <TextBlock Name="TBUserName" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Height="31" Margin="0,10,0,5" VerticalAlignment="Center" FontSize="15" Foreground="#FF808080" Text="{x:Static coreCommon:Resources.UserName}" UseLayoutRounding="True" />
    <dxe:TextEdit Name="LoginName" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Height="50" CornerRadius="4" FontSize="13" FontWeight="Bold" IsReadOnly="True" UseLayoutRounding="True" />
    <TextBlock Name="TBDatabase" Grid.Row="5" Grid.Column="1" Height="31" Margin="0,10,0,5" VerticalAlignment="Top" FontSize="15" Foreground="#FF808080" Text="{x:Static coreCommon:Resources.Database}" UseLayoutRounding="True" />
    <dxe:TextEdit Name="CloudDB" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Height="50" CornerRadius="4" FontSize="13" FontWeight="Bold" IsReadOnly="True" UseLayoutRounding="True" />
    <TextBlock Name="TBPinCode" Grid.Row="7" Grid.Column="1" Height="31" Margin="0,10,0,5" VerticalAlignment="Top" FontSize="15" Foreground="#FF808080" Text="{x:Static coreCommon:Resources.PINCode}" UseLayoutRounding="True" />
    <dxe:PasswordBoxEdit Name="PBPin" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Height="50" CornerRadius="4" FontSize="13" MaxLength="4" ShowCapsLockWarningToolTip="True" ShowPasswordButtonVisibility="Always" UseLayoutRounding="True" />
    <dx:SimpleButton Name="OkButton" Grid.Row="9" Grid.Column="1" Margin="0,0,14,0" Content="{x:Static coreCommon:Resources.Ok}" IsDefault="True" Style="{StaticResource ButtonStyle}" />
    <dx:SimpleButton Name="CancelButton" Grid.Row="9" Grid.Column="2" Margin="14,0,0,0" Content="{x:Static coreCommon:Resources.Cancel}" IsCancel="True" Style="{StaticResource ButtonStyle}" />
  </Grid>
</dx:ThemedWindow>
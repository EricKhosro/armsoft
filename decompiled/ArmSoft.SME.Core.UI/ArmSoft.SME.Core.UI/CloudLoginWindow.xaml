<?xml version="1.0" encoding="utf-8"?>
<dx:ThemedWindow x:Class="ArmSoft.SME.Core.UI.CloudLoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ArmSoft.SME.Core.UI.Controls" xmlns:conv="clr-namespace:ArmSoft.SME.Core.UI.Converters" xmlns:coreCommon="clr-namespace:ArmSoft.SME.Common;assembly=ArmSoft.SME.Common" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions" xmlns:local="clr-namespace:ArmSoft.SME.Core.UI" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="CloudLoginWindow" Width="568" Height="600" Padding="0" BorderThickness="0" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="False" UseLayoutRounding="True" WindowStartupLocation="CenterOwner" WindowStyle="None">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <conv:SystemSpecificButtonBackgroundColor x:Key="SystemSpecificButtonBackgroundColor" />
      <conv:CloudLoginButtonForegroundColorConverter x:Key="CloudLoginButtonForegroundColorConverter" />
      <conv:SystemSpecificCheckedButtonBackgroundColor x:Key="SystemSpecificCheckedButtonBackgroundColor" />
      <conv:HyperlinkBackgroundColor x:Key="HyperlinkBackgroundColor" />
      <conv:LanguageBorderColorConverter x:Key="LanguageBorderColor" />
      <conv:LoginBackgroundColor x:Key="LoginBackgroundColor" />
      <Style x:Key="DBListInnerCodeEditStyle" TargetType="{x:Type dxe:ButtonEdit}">
        <Setter Property="Height" Value="51" />
        <Setter Property="Padding" Value="5,0,0,0" />
        <Setter Property="dxe:BaseEdit.CornerRadius" Value="4" />
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="DBModeButtonStyleR" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="1" CornerRadius="0,5,5,0" BorderBrush="{Binding Converter={StaticResource SystemSpecificButtonBackgroundColor}}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="true">
                  <Setter Property="Background" Value="{Binding Converter={StaticResource SystemSpecificCheckedButtonBackgroundColor}}" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ButtonStyle" TargetType="{x:Type dx:SimpleButton}">
        <Setter Property="Background" Value="{Binding Converter={StaticResource SystemSpecificButtonBackgroundColor}}" />
        <Setter Property="Foreground" Value="{Binding Converter={StaticResource CloudLoginButtonForegroundColorConverter}}" />
        <Setter Property="dx:SimpleButton.CornerRadius" Value="5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="dx:SimpleButton.CornerRadius" Value="4" />
        <Setter Property="Height" Value="40" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{Binding Converter={StaticResource SystemSpecificButtonBackgroundColor}}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="LoginContent" UseLayoutRounding="True" Background="{Binding Converter={StaticResource LoginBackgroundColor}}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="93" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="93" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="66" />
      <RowDefinition Height="80" />
      <RowDefinition Height="40" />
      <RowDefinition Height="40" />
      <RowDefinition Height="50" />
      <RowDefinition Height="36" />
      <RowDefinition Height="40" />
      <RowDefinition Height="52" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="40" />
      <RowDefinition Height="60" />
    </Grid.RowDefinitions>
    <Button Name="CloseTitleButton" Grid.Row="0" Grid.Column="3" Width="22" Height="22" Margin="2,2,2,2" HorizontalAlignment="Right" VerticalAlignment="Top" IsTabStop="False" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" ToolTip="{x:Static coreCommon:Resources.Close}" UseLayoutRounding="True">
      <dx:DXImage Source="{ext:ASImage close_16.svg}" />
    </Button>
    <dx:DXImage Name="AS_Logo_Image" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="2" Width="106" Height="74" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" UseLayoutRounding="True" Source="{ext:ASImage AS_Logo.svg}" />
    <Grid Row="2" Column="1" ColumnSpan="2">
      <TextBlock Name="TBWorkBegin" FontSize="21" Text="{x:Static coreCommon:Resources.Login}" UseLayoutRounding="True" />
      <dxe:ComboBoxEdit Name="language" Width="50" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4" IsTextEditable="False" ShowSizeGrip="False" UseLayoutRounding="True" BorderBrush="{Binding Converter={StaticResource LanguageBorderColor}}">
        <dxe:BaseEdit.StyleSettings>
          <dxe:ComboBoxStyleSettings />
        </dxe:BaseEdit.StyleSettings>
        <dxe:TextEditBase.EditNonEditableTemplate>
          <ControlTemplate>
            <dx:DXImage Width="16" DataContext="{Binding SelectedItem}" Source="{Binding Image}" />
          </ControlTemplate>
        </dxe:TextEditBase.EditNonEditableTemplate>
        <dxe:LookUpEditBase.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <dx:DXImage Margin="0,0,6,0" Source="{Binding Image}" />
              <TextBlock Text="{Binding LanguageCaption}" />
            </StackPanel>
          </DataTemplate>
        </dxe:LookUpEditBase.ItemTemplate>
      </dxe:ComboBoxEdit>
    </Grid>
    <TextBlock Name="TBUserName" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Height="31" Margin="0,10,0,5" VerticalAlignment="Center" FontSize="15" Foreground="#FF808080" Text="{x:Static coreCommon:Resources.UserName}" UseLayoutRounding="True" />
    <dxe:ComboBoxEdit Name="LoginName" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" CornerRadius="4" FocusPopupOnOpen="True" FontSize="13" IsTextEditable="False" ShowSizeGrip="False" UseLayoutRounding="True" ItemsSource="{Binding User}">
      <dxe:BaseEdit.StyleSettings>
        <dxe:ComboBoxStyleSettings />
      </dxe:BaseEdit.StyleSettings>
      <dxe:TextEditBase.EditNonEditableTemplate>
        <ControlTemplate>
          <TextBlock Padding="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Path=(dxe:BaseEdit.OwnerEdit).EditValue}" />
        </ControlTemplate>
      </dxe:TextEditBase.EditNonEditableTemplate>
      <dxe:LookUpEditBase.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Vertical" UseLayoutRounding="True">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Visibility="{Binding UserVisible}">
              <dx:DXImage Width="32" Height="32" Margin="20,0,0,0" Stretch="None" Source="{Binding Image}" />
              <StackPanel Width="270" Orientation="Vertical">
                <Label Height="30" Padding="21,10,0,0" VerticalContentAlignment="Center" FontWeight="Bold" Content="{Binding Name}" />
                <Label Height="30" Padding="21,0,0,10" VerticalContentAlignment="Center" Foreground="#FF808080" Content="{Binding Mail}" />
              </StackPanel>
              <Button Width="28" Height="28" HorizontalAlignment="Right" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" DataContext="{Binding Mail}" Click="RemoveUser_Button_Click">
                <dx:DXImage HorizontalAlignment="Right" Source="{ext:ASImage delete_32.svg}" />
              </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" UseLayoutRounding="True" Visibility="{Binding OtherVisible}">
              <dx:DXImage Name="Users_Image" Width="32" Height="32" Margin="22,0,0,0" HorizontalAlignment="Center" Source="{ext:ASImage users_24in32.svg}" />
              <StackPanel Orientation="Vertical" UseLayoutRounding="True">
                <Label Height="60" Padding="21,0,0,0" VerticalContentAlignment="Center" Content="{Binding Other}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </dxe:LookUpEditBase.ItemTemplate>
    </dxe:ComboBoxEdit>
    <dxe:CheckEdit Name="SaveUser" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Height="22" Margin="0,7,0,8" VerticalAlignment="Center" VerticalContentAlignment="Stretch" Content="{x:Static coreCommon:Resources.SaveUser}" CornerRadius="2" FontSize="13" UseLayoutRounding="True" Foreground="{Binding Converter={StaticResource HyperlinkBackgroundColor}}" />
    <TextBlock Name="TBDatabase" Grid.Row="6" Grid.Column="1" Height="31" Margin="0,10,0,5" VerticalAlignment="Top" FontSize="15" Foreground="#FF808080" Text="{x:Static coreCommon:Resources.Database}" UseLayoutRounding="True" />
    <controls:DropDownControl x:Name="CloudDBList" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" UseLayoutRounding="True" />
    <Grid Row="8" Column="1" ColumnSpan="2" Margin="0,8,0,8" VerticalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="auto" />
        <RowDefinition Height="4" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Name="TBAvailableKeys" Grid.Row="0" FontSize="12" Foreground="#FF808080" Text="{x:Static coreCommon:Resources.AvailableKeys}" UseLayoutRounding="True" />
      <TextBlock Name="TBKeys" Grid.Row="3" FontSize="11" Text="" TextWrapping="Wrap" UseLayoutRounding="True" />
    </Grid>
    <dx:SimpleButton Name="OkButton" Grid.Row="9" Grid.Column="1" Margin="0,0,14,0" Content="{x:Static coreCommon:Resources.Ok}" IsDefault="True" Style="{StaticResource ButtonStyle}" />
    <dx:SimpleButton Name="CancelButton" Grid.Row="9" Grid.Column="2" Margin="14,0,0,0" Content="{x:Static coreCommon:Resources.Cancel}" IsCancel="True" Style="{StaticResource ButtonStyle}" />
    <StackPanel Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Height="60" Margin="0,0,0,0" VerticalAlignment="Bottom" Orientation="Vertical" UseLayoutRounding="True">
      <StackPanel Name="OfferStack" UseLayoutRounding="True">
        <TextBlock Name="TBOffer" Margin="0,15,0,0" FontSize="11" Foreground="#FF808080" Text="" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </Grid>
</dx:ThemedWindow>
<?xml version="1.0" encoding="utf-8"?>
<dxc:ThemedWindow x:Class="ArmSoft.SME.Core.UI.MapWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxm="http://schemas.devexpress.com/winfx/2008/xaml/map" Title="Map" Width="700" Height="500" ShowIcon="False" SizeToContent="Manual" WindowState="Normal" WindowStyle="SingleBorderWindow" xmlns:ui="clr-namespace:ArmSoft.SME.Core.UI;assembly=ArmSoft.SME.Core.UI">
  <DockPanel LastChildFill="True">
    <Grid Name="ButtonsPanel" DockPanel.Dock="Bottom">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Button Name="OkButton" Grid.Row="0" Grid.Column="1" MinWidth="100" Margin="15,5,15,5" HorizontalContentAlignment="Center" Content="OK" IsDefault="True" TabIndex="2" UseLayoutRounding="True" />
      <Button Name="CancelButton" Grid.Row="0" Grid.Column="2" MinWidth="100" Margin="15,5,15,5" Content="Cancel" IsCancel="True" TabIndex="3" UseLayoutRounding="True" />
    </Grid>
    <dxm:MapControl Name="MapControl" IsManipulationEnabled="True" ZoomLevel="18">
      <dxm:MapControl.MapEditor>
        <dxm:MapEditor>
          <dxm:MapEditor.Mode>
            <dxm:MapEditorTransformMode />
          </dxm:MapEditor.Mode>
          <dxm:MapEditor.EditorPanelOptions>
            <dxm:MapEditorPanelOptions Visible="False" />
          </dxm:MapEditor.EditorPanelOptions>
        </dxm:MapEditor>
      </dxm:MapControl.MapEditor>
      <dxm:MapControl.CoordinatesPanelOptions>
        <dxm:CoordinatesPanelOptions Visible="False" />
      </dxm:MapControl.CoordinatesPanelOptions>
      <dxm:MapControl.ScalePanelOptions>
        <dxm:ScalePanelOptions Margin="16,16,16,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" ShowMilesScale="False" />
      </dxm:MapControl.ScalePanelOptions>
      <dxm:ImageLayer>
        <dxm:ImageLayer.DataProvider>
          <dxm:OpenStreetMapDataProvider x:Name="OSMDataProvider" />
        </dxm:ImageLayer.DataProvider>
      </dxm:ImageLayer>
      <dxm:VectorLayer Name="VectorLayer" />
    </dxm:MapControl>
  </DockPanel>
</dxc:ThemedWindow>
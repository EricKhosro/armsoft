<?xml version="1.0" encoding="utf-8"?>
<dxc:ThemedWindow x:Class="ArmSoft.SME.Core.UI.MessageBoxWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions" xmlns:controls="clr-namespace:ArmSoft.SME.Core.UI.Controls" Title="MessageBox" Width="532" Height="140" MaxHeight="800" AutomationProperties.AutomationId="MessageBox" ResizeMode="NoResize" ShowIcon="False" ShowInTaskbar="False" SizeToContent="WidthAndHeight" UseLayoutRounding="True" WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" xmlns:ui="clr-namespace:ArmSoft.SME.Core.UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <dxc:DXImage Name="ImageIcon" Grid.Row="0" Grid.Column="0" Margin="5,5,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Stretch="None" Source="{ext:ASImage information_32.svg}" />
    <StackPanel Name="MsgTextBlockPanel" Grid.Row="0" Grid.Column="1" Margin="5,5,0,0" MaxHeight="500" CanVerticallyScroll="True" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#00FFFFFF">
      <dxe:TextEdit Name="MsgTextBlock" MinWidth="300" MaxWidth="500" MaxHeight="500" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#00FFFFFF" BorderBrush="#00FFFFFF" IsReadOnly="True" IsTabStop="False" ShowBorder="False" Text="Message" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
    </StackPanel>
    <StackPanel Name="RememberTheAnswerPanel" Grid.Row="1" Grid.ColumnSpan="2" Margin="10,0,0,0" Orientation="Horizontal" Visibility="Collapsed">
      <dxe:CheckEdit Name="ButtonRememberTheAnswer" Margin="5" VerticalAlignment="Center" />
      <Label Name="LabelRememberTheAnswer" VerticalAlignment="Center" Content="Also apply the answer to the following" />
    </StackPanel>
    <Grid Row="2" ColumnSpan="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <dxc:SimpleButton Name="OkButton" Grid.Column="1" MinWidth="100" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Top" IsCancel="True" IsDefault="True" UseLayoutRounding="True" Click="OkButton_Click">
        <StackPanel Orientation="Horizontal">
          <dxc:DXImage Name="ImageOK" Height="16" Stretch="Uniform" Source="{ext:ASImage accept_16.svg}" />
          <Label Name="LabelOk" Margin="5,0,0,1" VerticalAlignment="Center" Content="Ok" />
        </StackPanel>
      </dxc:SimpleButton>
      <dxc:SimpleButton Name="YesButton" Grid.Column="2" MinWidth="100" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Top" UseLayoutRounding="True" Click="YesButton_Click">
        <StackPanel Orientation="Horizontal">
          <dxc:DXImage Name="ImageYes" Height="16" Stretch="Uniform" Source="{ext:ASImage accept_16.svg}" />
          <Label Name="LabelYes" Margin="5,0,0,1" VerticalAlignment="Center" Content="Yes" />
        </StackPanel>
      </dxc:SimpleButton>
      <dxc:SimpleButton Name="NoButton" Grid.Column="3" MinWidth="100" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Top" UseLayoutRounding="True" Click="NoButton_Click">
        <StackPanel Orientation="Horizontal">
          <dxc:DXImage Name="ImageNo" Height="16" Stretch="Uniform" Source="{ext:ASImage cancel_16.svg}" />
          <Label Name="LabelNo" Margin="5,0,0,1" VerticalAlignment="Center" Content="No" />
        </StackPanel>
      </dxc:SimpleButton>
      <dxc:SimpleButton Name="CancelButton" Grid.Column="4" MinWidth="100" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Top" UseLayoutRounding="True" Click="CancelButton_Click">
        <StackPanel Orientation="Horizontal">
          <dxc:DXImage Name="ImageCancel" Height="16" Stretch="Uniform" Source="{ext:ASImage cancel_true_16.svg}" />
          <Label Name="LabelCancel" Margin="5,0,0,1" VerticalAlignment="Center" Content="Cancel" />
        </StackPanel>
      </dxc:SimpleButton>
      <dxc:SimpleButton Name="HelpButton" Grid.Column="5" MinWidth="100" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Top" UseLayoutRounding="True" Click="HelpButton_Click">
        <StackPanel Orientation="Horizontal">
          <dxc:DXImage Name="ImageHelp" Height="16" Stretch="Uniform" Source="{ext:ASImage help_16.svg}" />
          <Label Name="LabelHelp" Margin="5,0,0,1" VerticalAlignment="Center" Content="Help" />
        </StackPanel>
      </dxc:SimpleButton>
    </Grid>
  </Grid>
</dxc:ThemedWindow>
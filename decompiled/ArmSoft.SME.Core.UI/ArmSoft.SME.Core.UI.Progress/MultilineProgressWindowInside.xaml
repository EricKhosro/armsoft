<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ArmSoft.SME.Core.UI.Progress.MultilineProgressWindowInside" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:ArmSoft.SME.Core.UI.Converters" xmlns:coreCommon="clr-namespace:ArmSoft.SME.Common;assembly=ArmSoft.SME.Common" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="MltlnProgressWindow" MinWidth="450" MinHeight="70" MaxHeight="800" HorizontalAlignment="Center" VerticalAlignment="Center" xmlns:progress="clr-namespace:ArmSoft.SME.Core.UI.Progress">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <conv:GetFontFamily x:Key="GetFontFamily" />
      <conv:GetFontSize x:Key="GetFontSize" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="MainBorder" Margin="5" CornerRadius="8">
    <UIElement.Effect>
      <DropShadowEffect x:Name="MainBorderShadow" BlurRadius="10" Direction="270" Opacity="0.2" ShadowDepth="5" Color="Black" />
    </UIElement.Effect>
    <Grid Name="MainGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="35" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="35" />
      </Grid.RowDefinitions>
      <FrameworkElement.Style>
        <dxg:DefaultStyle />
      </FrameworkElement.Style>
      <TextBlock Name="Title" Grid.Row="0" Padding="10" HorizontalAlignment="Center" FontWeight="Bold" Text="{x:Static coreCommon:Resources.ExecutionProcess}" FontFamily="{Binding Converter={StaticResource GetFontFamily}}" FontSize="{Binding Converter={StaticResource GetFontSize}}" />
      <dxc:DXBorder Name="LongLoadingDescriptionBorder" Grid.Row="1" Margin="12,0" Padding="6" HorizontalAlignment="Stretch" BorderThickness="1" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <dxe:ButtonEdit VerticalAlignment="Center" AllowDefaultButton="False" Background="#00FFFFFF" Focusable="False" ShowBorder="False" ShowText="False" Visibility="Visible">
            <dxe:ButtonEdit.Buttons>
              <dxe:LoadingIndicatorButtonInfo />
            </dxe:ButtonEdit.Buttons>
          </dxe:ButtonEdit>
          <TextBlock Margin="15,0,0,0" VerticalAlignment="Center" Focusable="False" FontWeight="Bold" Text="{x:Static coreCommon:Resources.ExecutionProcessInside}" TextAlignment="Left" FontFamily="{Binding Converter={StaticResource GetFontFamily}}" FontSize="{Binding Converter={StaticResource GetFontSize}}" />
        </StackPanel>
      </dxc:DXBorder>
      <StackPanel Name="Phases" Grid.Row="2" Margin="10" />
      <Grid Name="ErrorGrid" Row="1" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <dxc:DXImage Name="ImageIcon" Grid.Column="0" Margin="5,5,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Stretch="None" UseLayoutRounding="True" Source="{ext:ASImage error_32.svg}" />
        <dxe:TextEdit Name="MsgTextBlock" Grid.Column="1" MinWidth="300" MaxWidth="440" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#00FFFFFF" BorderBrush="#00FFFFFF" IsReadOnly="True" IsTabStop="False" ShowBorder="False" Text="Message" TextWrapping="Wrap" UseLayoutRounding="True" />
      </Grid>
      <TextBlock Name="TimeTextBlock" Grid.Row="3" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="MM:SS" UseLayoutRounding="True" />
      <dxc:SimpleButton Name="AbortButton" Grid.Row="3" Width="130" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Button" UseLayoutRounding="True" Click="AbortButton_Click" />
    </Grid>
  </Border>
</UserControl>
<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ArmSoft.SME.Core.UI.Progress.MultilineProgressPhaseControl" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Height="25" xmlns:progress="clr-namespace:ArmSoft.SME.Core.UI.Progress;assembly=ArmSoft.SME.Core.UI">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="130" />
      <ColumnDefinition Width="50" />
    </Grid.ColumnDefinitions>
    <dx:DXImage Name="StateImage" Grid.Column="0" Width="20" />
    <TextBlock Name="NameTextBlock" Grid.Column="1" Margin="5,0,5,0" VerticalAlignment="Center" Text="Name" />
    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
      <TextBlock Name="CountTextBlock" Text="10000000" TextAlignment="Right" />
      <TextBlock Name="SlashTextBlock" Text="/" />
      <TextBlock Name="TotalTextBlock" Text="10000000" TextAlignment="Left" />
    </StackPanel>
    <TextBlock Name="TimeTextBlock" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Text="00:00" TextAlignment="Right" />
  </Grid>
</UserControl>
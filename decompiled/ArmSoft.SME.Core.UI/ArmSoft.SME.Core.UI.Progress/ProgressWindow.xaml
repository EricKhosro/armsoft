<?xml version="1.0" encoding="utf-8"?>
<dxc:ThemedWindow x:Class="ArmSoft.SME.Core.UI.Progress.ProgressWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="MainProgressWindow" Title="ProgressWindow" MinWidth="340" ResizeMode="NoResize" ShowIcon="False" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" xmlns:progress="clr-namespace:ArmSoft.SME.Core.UI.Progress;assembly=ArmSoft.SME.Core.UI">

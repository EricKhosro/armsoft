<?xml version="1.0" encoding="utf-8"?>
<dx:ThemedWindow x:Class="ArmSoft.SME.Trade.UI.About" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="AppUpdateWindow" Width="550" Height="280" ShowIcon="False" SizeToContent="Height" WindowStartupLocation="CenterOwner" xmlns:ui="clr-namespace:ArmSoft.SME.Trade.UI;assembly=ArmSoft.SME.Trade.UI">
  <dxlc:LayoutControl Orientation="Vertical">
    <dxlc:LayoutGroup>
      <Grid Margin="5,0" HorizontalAlignment="Left" VerticalAlignment="Top">
        <dx:DXImage Name="popupStaticImage" Grid.Row="0" Grid.Column="0" Width="32" Height="32" VerticalAlignment="Top" Stretch="Fill" UseLayoutRounding="True" Source="{ext:ASImage AS_Logo_32.svg}" />
      </Grid>
      <StackPanel VerticalAlignment="Top">
        <TextBlock Name="TBApplicationName" Text="Application name" FontSize="14" FontWeight="Bold" UseLayoutRounding="True" />
        <TextBlock Name="ArmSoftInfo" FontSize="12" TextWrapping="Wrap" UseLayoutRounding="True" />
        <TextBlock Name="ArmSoftAddress" FontSize="12" TextWrapping="Wrap" UseLayoutRounding="True" />
      </StackPanel>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" />
    </dxlc:LayoutGroup>
    <TextBlock Name="TBInformation" Margin="0,5,0,0" VerticalAlignment="Top" Text="Information" FontSize="14" FontWeight="Bold" UseLayoutRounding="True" />
    <Rectangle Name="Line1" Height="2" />
    <dxlc:LayoutItem Name="LIVersion" Label="Version">
      <TextBlock Name="TBCurrentVersion" Margin="10,0,0,0" HorizontalAlignment="Left" FontWeight="Bold" Text="Version 7.X.YY.Z" UseLayoutRounding="True" />
    </dxlc:LayoutItem>
    <dxlc:LayoutItem Name="LIPublished" Label="Published">
      <TextBlock Name="TBPublished" Margin="10,0,0,0" HorizontalAlignment="Left" FontWeight="Bold" />
    </dxlc:LayoutItem>
    <dxlc:LayoutItem Name="Key" Label="Key">
      <TextBlock Name="TBKey" Margin="10,0,0,0" HorizontalAlignment="Left" FontWeight="Bold" Text="Key xxxxxxxx" UseLayoutRounding="True" />
    </dxlc:LayoutItem>
    <dxlc:LayoutItem Name="WSLimit" Label="Workstation limit">
      <TextBlock Name="TBWSLimit" Margin="10,0,0,0" HorizontalAlignment="Left" FontWeight="Bold" Text="0" UseLayoutRounding="True" />
    </dxlc:LayoutItem>
    <dx:SimpleButton Name="CancelButton" Height="26" MinWidth="100" Margin="15,20,15,-7" HorizontalAlignment="Center" VerticalAlignment="Bottom" Content="Close" IsCancel="True" UseLayoutRounding="True" />
  </dxlc:LayoutControl>
</dx:ThemedWindow>
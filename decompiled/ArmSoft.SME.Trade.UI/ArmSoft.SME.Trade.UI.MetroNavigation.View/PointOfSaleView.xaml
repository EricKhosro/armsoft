<?xml version="1.0" encoding="utf-8"?>
<dxmvvm:ModuleView x:Class="ArmSoft.SME.Trade.UI.MetroNavigation.View.PointOfSaleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:coreconv="clr-namespace:ArmSoft.SME.Core.UI.Converters;assembly=ArmSoft.SME.Core.UI" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvmsample" xmlns:dxrt="http://schemas.devexpress.com/winfx/2008/xaml/ribbon/themekeys" xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:local="clr-namespace:ArmSoft.SME.Trade.UI.MetroNavigation" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="POSView" xmlns:view="clr-namespace:ArmSoft.SME.Trade.UI.MetroNavigation.View">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <coreconv:FontFamilyConverter x:Key="GetSystemFont" />
      <coreconv:SystemSpecificButtonBackgroundColor x:Key="SystemSpecificButtonBackgroundColor" />
      <coreconv:GetCurrentBackgroundBrush x:Key="GetCurrentBackgroundBrush" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Grid.Column="0">
      <dx:SimpleButton Name="PointOfSalePageTitle" Grid.Row="0" Content="PointOfSale" Style="{StaticResource MetroButton}" Command="{Binding Parent.ShowMainCommand}" Glyph="{ext:ASImage Back.svg}" />
      <local:NavigatorView x:Name="TileView" Grid.Column="1" HorizontalAlignment="Right" />
    </DockPanel>
    <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Orientation="Horizontal">
      <dxlc:TileLayoutControl Margin="0" Padding="60,30" HorizontalAlignment="Stretch" AllowItemMoving="False" BreakFlowToFit="False" Orientation="Vertical">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="MainTiles" TargetType="{x:Type dxlc:Tile}">
              <Setter Property="Background" Value="#00FFFFFF" />
              <Setter Property="BorderBrush" Value="#00FFFFFF" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="TextBlock.Foreground" Value="{Binding Converter={StaticResource GetSystemFont}}" />
              <Setter Property="UIElement.Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="12" Direction="-90" Opacity="0.2" ShadowDepth="1" Color="#495768" />
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="TextBlock.Foreground" Value="{Binding Converter={StaticResource GetSystemFont}}" />
                  <Setter Property="UIElement.Effect">
                    <Setter.Value>
                      <DropShadowEffect BlurRadius="20" Direction="-90" Opacity="0.2" ShadowDepth="3" Color="{Binding Converter={StaticResource SystemSpecificButtonBackgroundColor}, Source={x:Reference POSView}}" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </Style.Triggers>
            </Style>
            <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
              <Setter Property="Margin" Value="0,8,0,0" />
              <Setter Property="FontFamily" Value="{Binding Converter={StaticResource GetSystemFont}}" />
              <Setter Property="FontSize" Value="11" />
              <Setter Property="FontWeight" Value="Bold" />
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <dxlc:Tile Name="SaleTile" Width="350" AnimateContentChange="True" Background="#00FFFFFF" Focusable="False" Size="Large" Style="{StaticResource MainTiles}">
          <Border Style="{StaticResource MainSectionsTileBorderStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Style="{StaticResource MainSectionsTileIndicatorColumnDefiniton}" />
                <ColumnDefinition Style="{StaticResource MainSectionsTileContentGridColumnDefiniton}" />
              </Grid.ColumnDefinitions>
              <Rectangle Style="{StaticResource MainSectionsTileIndicatorRectangleStyle}" />
              <StackPanel Grid.Column="1" Margin="0,32,0,0" Orientation="Vertical">
                <dx:DXImage HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" Source="{ext:ASImage POS_SaleSS_56.svg}" />
                <TextBlock Name="SaleTile_TextBlock" Width="140" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontFamily="{Binding Converter={StaticResource GetSystemFont}}" Foreground="{Binding Converter={StaticResource SystemSpecificButtonBackgroundColor}}" />
              </StackPanel>
            </Grid>
          </Border>
        </dxlc:Tile>
        <dxlc:Tile Name="CloseCashierShiftTile" Width="170" Background="#00FFFFFF" Size="Small" Style="{StaticResource MainTiles}">
          <Border Style="{StaticResource MainSectionsTileBorderStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Style="{StaticResource MainSectionsTileIndicatorColumnDefiniton}" />
                <ColumnDefinition Style="{StaticResource MainSectionsTileContentGridColumnDefiniton}" />
              </Grid.ColumnDefinitions>
              <Rectangle Style="{StaticResource MainSectionsTileIndicatorRectangleStyle}" />
              <StackPanel Grid.Column="1" Margin="0,32,0,0" Orientation="Vertical">
                <dx:DXImage Name="CloseCashierShiftImage" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" Source="{ext:ASImage POS_CloseCashierShift_56.svg}" />
                <TextBlock Name="CloseCashierShiftTile_TextBlock" Width="140" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" FontFamily="{Binding Converter={StaticResource GetSystemFont}}" Foreground="{Binding Converter={StaticResource SystemSpecificButtonBackgroundColor}}" />
              </StackPanel>
            </Grid>
          </Border>
        </dxlc:Tile>
        <dxlc:Tile Name="PrintECRReportShiftTile" Width="170" Background="#00FFFFFF" Size="Small" Style="{StaticResource MainTiles}">
          <Border Style="{StaticResource MainSectionsTileBorderStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Style="{StaticResource MainSectionsTileIndicatorColumnDefiniton}" />
                <ColumnDefinition Style="{StaticResource MainSectionsTileContentGridColumnDefiniton}" />
              </Grid.ColumnDefinitions>
              <Rectangle Style="{StaticResource MainSectionsTileIndicatorRectangleStyle}" />
              <StackPanel Grid.Column="1" Margin="0,32,0,0" Orientation="Vertical">
                <dx:DXImage Name="PrintECRReportShiftImage" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" Source="{ext:ASImage POS_PrintECRReportShift_56.svg}" />
                <TextBlock Name="PrintECRReportShiftTile_TextBlock" Width="140" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontFamily="{Binding Converter={StaticResource GetSystemFont}}" Foreground="{Binding Converter={StaticResource SystemSpecificButtonBackgroundColor}}" />
              </StackPanel>
            </Grid>
          </Border>
        </dxlc:Tile>
        <dxlc:Tile Name="ReportsTile" Width="170" Background="#00FFFFFF" Size="Small" Style="{StaticResource MainTiles}">
          <Border Style="{StaticResource MainSectionsTileBorderStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Style="{StaticResource MainSectionsTileIndicatorColumnDefiniton}" />
                <ColumnDefinition Style="{StaticResource MainSectionsTileContentGridColumnDefiniton}" />
              </Grid.ColumnDefinitions>
              <Rectangle Style="{StaticResource MainSectionsTileIndicatorRectangleStyle}" />
              <StackPanel Grid.Column="1" Margin="0,32,0,0" Orientation="Vertical">
                <dx:DXImage Name="ReportsImage" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" Source="{ext:ASImage POS_Reports_56.svg}" />
                <TextBlock Name="ReportsTile_TextBlock" Width="140" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontFamily="{Binding Converter={StaticResource GetSystemFont}}" Foreground="{Binding Converter={StaticResource SystemSpecificButtonBackgroundColor}}" />
              </StackPanel>
            </Grid>
          </Border>
        </dxlc:Tile>
        <dxlc:Tile Name="ECRSetupTile" Width="170" Background="#00FFFFFF" Size="Small" Style="{StaticResource MainTiles}">
          <Border Style="{StaticResource MainSectionsTileBorderStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Style="{StaticResource MainSectionsTileIndicatorColumnDefiniton}" />
                <ColumnDefinition Style="{StaticResource MainSectionsTileContentGridColumnDefiniton}" />
              </Grid.ColumnDefinitions>
              <Rectangle Style="{StaticResource MainSectionsTileIndicatorRectangleStyle}" />
              <StackPanel Grid.Column="1" Margin="0,32,0,0" Orientation="Vertical">
                <dx:DXImage Name="ECRSetupImage" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" Source="{ext:ASImage POS_ECRSetup_56.svg}" />
                <TextBlock Name="ECRSetupTile_TextBlock" Width="140" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontFamily="{Binding Converter={StaticResource GetSystemFont}}" Foreground="{Binding Converter={StaticResource SystemSpecificButtonBackgroundColor}}" />
              </StackPanel>
            </Grid>
          </Border>
        </dxlc:Tile>
        <dxlc:Tile Name="WatchVideoTile" Width="350" Height="79" Background="#00FFFFFF" BorderThickness="0" Style="{StaticResource MainTiles}" MouseEnter="WatchVideoTile_MouseEnter" MouseLeave="WatchVideoTile_MouseLeave">
          <Border Style="{StaticResource MainSectionsTileBorderStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Style="{StaticResource MainSectionsTileIndicatorColumnDefiniton}" />
                <ColumnDefinition Style="{StaticResource MainSectionsTileContentGridColumnDefiniton}" />
              </Grid.ColumnDefinitions>
              <Rectangle Style="{StaticResource MainSectionsTileIndicatorRectangleStyle}" />
              <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal">
                <Border Name="WatchVideoTile_Border" Width="46" Height="46" Margin="0,0,0,0" Background="#83C887" CornerRadius="8">
                  <dx:DXImage Name="WatchVideoImage" Width="21" Height="21" Margin="3,0,0,0" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" Source="{dx:SvgImageSource UsePalette=False, Uri='pack://application:,,,/ArmSoft.SME.Core.UI;component/Images/play.svg'}" />
                </Border>
                <TextBlock Name="WatchVideoTile_TextBlock" Width="140" Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontFamily="{Binding Converter={StaticResource GetSystemFont}}" Foreground="{Binding Converter={StaticResource SystemSpecificButtonBackgroundColor}}" />
              </StackPanel>
            </Grid>
          </Border>
        </dxlc:Tile>
      </dxlc:TileLayoutControl>
    </StackPanel>
  </Grid>
</dxmvvm:ModuleView>
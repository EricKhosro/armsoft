<?xml version="1.0" encoding="utf-8"?>
<dx:ThemedWindow x:Class="ArmSoft.SME.Trade.UI.CustomUIElements.PoleDisplayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:coreCommon="clr-namespace:ArmSoft.SME.Common;assembly=ArmSoft.SME.Common" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxl="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:tradeCommon="clr-namespace:ArmSoft.SME.Trade.Common;assembly=ArmSoft.SME.Trade.Common" Title="PoleDisplayWindow" Width="800" Height="480" HorizontalContentAlignment="Stretch" BorderThickness="0" ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="Manual" WindowState="Normal" WindowStyle="None" xmlns:customuielements="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements;assembly=ArmSoft.SME.Trade.UI" ContextMenu="{x:Null}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="PaymentMethodCaptionTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{ext:ThemeBasedColor #008000#4fad77}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Normal" />
      </Style>
      <Style x:Key="TotalsCaptionTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{ext:ThemeBasedColor #dd0326#fb7376}" />
        <Setter Property="FontSize" Value="38" />
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
      <Style x:Key="PaymentMethodTextBlockStyle" BasedOn="{StaticResource PaymentMethodCaptionTextBlockStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="Bold" />
        <Style.Triggers>
          <Trigger Property="Text" Value="">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
          <Trigger Property="Text" Value="0.00">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="TotalsTextBlockStyle" BasedOn="{StaticResource TotalsCaptionTextBlockStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Style.Triggers>
          <Trigger Property="Text" Value="">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
          <Trigger Property="Text" Value="0.00">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <dxl:LayoutControl VerticalAlignment="Stretch" Orientation="Vertical" ScrollBars="None">
    <dxl:LayoutGroup HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="#00FFFFFF" Orientation="Vertical">
      <dxl:LayoutItem Name="grpHeader" HorizontalAlignment="Center" VerticalAlignment="Top" BorderBrush="#00FFFFFF">
        <ContentControl>
          <TextBlock Name="txtHeader" Width="Auto" Height="Auto" Margin="0,0,0,5" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#00FFFFFF" Focusable="False" FontSize="26" TextAlignment="Right" ContextMenu="{x:Null}" Foreground="{ext:ThemeBasedColor #212121#FFFFFF}" />
        </ContentControl>
      </dxl:LayoutItem>
      <dxl:LayoutItem Name="RowInfoLayoutItem" BorderBrush="#00FFFFFF">
        <ContentControl>
          <TextBlock Name="RowInfoTextBlock" Height="Auto" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#00FFFFFF" Focusable="False" FontSize="30" FontWeight="Bold" ContextMenu="{x:Null}" Foreground="{ext:ThemeBasedColor #212121#FFFFFF}" />
        </ContentControl>
      </dxl:LayoutItem>
    </dxl:LayoutGroup>
    <dxl:LayoutGroup Name="SaleInfoLayout" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Orientation="Horizontal">
      <dxl:LayoutGroup Name="BuyerAndTotalLayout" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#00FFFFFF" Orientation="Vertical">
        <Grid Margin="0,2,0,2">
          <Grid Column="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Name="txtBuyerName" Grid.Row="0" Grid.Column="0" Margin="0,0,0,10" FontSize="22" FontWeight="Bold" />
            <TextBlock Name="txtBonus_lbl" Grid.Row="1" Grid.Column="0" FontSize="18" TextDecorations="UnderLine" />
            <TextBlock Name="txtAccumulatedBonus_lbl" Grid.Row="2" Grid.Column="0" FontSize="18" />
            <TextBlock Name="txtBonusRemain_lbl" Grid.Row="3" Grid.Column="0" FontSize="18" />
            <TextBlock Grid.Row="1" Grid.Column="2" FontSize="18" FontWeight="Bold" />
            <TextBlock Name="txtAccumulatedBonus" Grid.Row="2" Grid.Column="2" FontSize="18" FontWeight="Bold" />
            <TextBlock Name="txtBonusRemain" Grid.Row="3" Grid.Column="2" FontSize="18" FontWeight="Bold" />
          </Grid>
        </Grid>
        <dxl:LayoutItem VerticalAlignment="Bottom" HorizontalContentAlignment="Left" BorderBrush="#00FFFFFF">
          <Grid Column="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Name="TotalCaptionTextBlock" Grid.Row="0" Grid.Column="0" Style="{StaticResource TotalsCaptionTextBlockStyle}" Text="{x:Static tradeCommon:Resources.TotalShort}" Visibility="{Binding ElementName=TotalTextBlock, Path=Visibility}" />
            <TextBlock Name="TotalTextBlock" Grid.Row="0" Grid.Column="2" Style="{StaticResource TotalsTextBlockStyle}" />
            <TextBlock Name="DiscountCaptionTextBlock" Grid.Row="1" Grid.Column="0" Style="{StaticResource PaymentMethodCaptionTextBlockStyle}" Text="{x:Static tradeCommon:Resources.DiscountShort}" Visibility="{Binding ElementName=DiscountTextBlock, Path=Visibility}" />
            <TextBlock Name="DiscountTextBlock" Grid.Row="1" Grid.Column="2" Style="{StaticResource PaymentMethodTextBlockStyle}" />
            <TextBlock Name="CashCaptionTextBlock" Grid.Row="2" Grid.Column="0" Style="{StaticResource PaymentMethodCaptionTextBlockStyle}" Text="{x:Static tradeCommon:Resources.CashPaymentForPrint}" Visibility="{Binding ElementName=CashTextBlock, Path=Visibility}" />
            <TextBlock Name="CashTextBlock" Grid.Row="2" Grid.Column="2" Style="{StaticResource PaymentMethodTextBlockStyle}" />
            <TextBlock Name="NonCashCaptionTextBlock" Grid.Row="3" Grid.Column="0" Style="{StaticResource PaymentMethodCaptionTextBlockStyle}" Text="{x:Static tradeCommon:Resources.PlasticCartPaymentDialog}" Visibility="{Binding ElementName=NonCashTextBlock, Path=Visibility}" />
            <TextBlock Name="NonCashTextBlock" Grid.Row="3" Grid.Column="2" Style="{StaticResource PaymentMethodTextBlockStyle}" />
            <TextBlock Name="UsedBonusCaptionTextBlock" Grid.Row="4" Grid.Column="0" Style="{StaticResource PaymentMethodCaptionTextBlockStyle}" Text="{x:Static tradeCommon:Resources.BonusUse}" Visibility="{Binding ElementName=UsedBonusTextBlock, Path=Visibility}" />
            <TextBlock Name="UsedBonusTextBlock" Grid.Row="4" Grid.Column="2" Style="{StaticResource PaymentMethodTextBlockStyle}" />
            <TextBlock Name="FromPrepayCaptionTextBlock" Grid.Row="5" Grid.Column="0" Style="{StaticResource PaymentMethodCaptionTextBlockStyle}" Text="{x:Static tradeCommon:Resources.PrePayment}" Visibility="{Binding ElementName=FromPrepayTextBlock, Path=Visibility}" />
            <TextBlock Name="FromPrepayTextBlock" Grid.Row="5" Grid.Column="2" Style="{StaticResource PaymentMethodTextBlockStyle}" />
            <TextBlock Name="CreditSaleCaptionTextBlock" Grid.Row="6" Grid.Column="0" Style="{StaticResource PaymentMethodCaptionTextBlockStyle}" Text="{x:Static tradeCommon:Resources.CreditSale}" Visibility="{Binding ElementName=CreditSaleTextBlock, Path=Visibility}" />
            <TextBlock Name="CreditSaleTextBlock" Grid.Row="6" Grid.Column="2" Style="{StaticResource PaymentMethodTextBlockStyle}" />
            <TextBlock Name="ForPayCaptionTextBlock" Grid.Row="7" Grid.Column="0" Style="{StaticResource TotalsCaptionTextBlockStyle}" Visibility="{Binding ElementName=ForPayTextBlock, Path=Visibility}" />
            <TextBlock Name="ForPayTextBlock" Grid.Row="7" Grid.Column="2" Style="{StaticResource TotalsTextBlockStyle}" />
          </Grid>
        </dxl:LayoutItem>
        <dxl:LayoutItem VerticalAlignment="Bottom" BorderBrush="#00FFFFFF">
          <ContentControl>
            <TextBlock Name="txtRowCount" Width="Auto" Height="Auto" Margin="0,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#00FFFFFF" Focusable="False" FontSize="18" TextAlignment="Left" ContextMenu="{x:Null}" Foreground="{ext:ThemeBasedColor #FFFFFF#212121}" />
          </ContentControl>
        </dxl:LayoutItem>
      </dxl:LayoutGroup>
      <dxl:LayoutGroup Name="grpImage" HorizontalAlignment="Center" VerticalAlignment="Bottom" Orientation="Horizontal">
        <dxl:LayoutItem Margin="10,0,0,0" BorderBrush="#00FFFFFF">
          <ContentControl>
            <Viewbox Width="Auto" Height="Auto" MaxWidth="250" MaxHeight="250" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Fill" StretchDirection="Both">
              <dx:DXImage Name="imgGoods" Focusable="False" Stretch="Fill" ContextMenu="{x:Null}" />
            </Viewbox>
          </ContentControl>
        </dxl:LayoutItem>
      </dxl:LayoutGroup>
    </dxl:LayoutGroup>
  </dxl:LayoutControl>
</dx:ThemedWindow>
<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ArmSoft.SME.Trade.UI.CustomUIElements.UserControls.SaleGoodUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:customWindowControls="clr-namespace:ArmSoft.SME.Core.UI.CustomWindowControls;assembly=ArmSoft.SME.Core.UI" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:usercontrols="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.UserControls;assembly=ArmSoft.SME.Trade.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="ButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{ext:ThemeBasedColor #ebebeb#49504b}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="1" CornerRadius="5" BorderBrush="{ext:ThemeBasedColor #b7b7b7#606862}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>
    <dxe:TextEdit Name="TB_GoodName" Grid.Row="0" Margin="-2,0,0,-5" VerticalAlignment="top" FontSize="22" FontStyle="Italic" FontWeight="Bold" IsReadOnly="True" ShowBorder="False" ShowNullText="True" Text="" TextWrapping="Wrap" Foreground="{ext:ThemeBasedColor DarkSlateGrayWhite}" NullTextForeground="{ext:ThemeBasedColor Gray#a6a6a6}" />
    <Grid Row="1" Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.1*" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>
      <dxe:TextEdit Name="TB_GoodRowDetail" Grid.Column="0" Margin="0,0,0,7" VerticalAlignment="Center" FontSize="15" FontStyle="Italic" FontWeight="Bold" IsReadOnly="True" ShowBorder="False" ShowNullText="True" Text="" TextWrapping="Wrap" Foreground="{ext:ThemeBasedColor DarkSlateGrayWhite}" NullTextForeground="{ext:ThemeBasedColor Gray#a6a6a6}" />
      <TextBlock Name="TB_GoodCode" Grid.Column="1" Margin="0,0,0,7" VerticalAlignment="Center" FontSize="15" FontStyle="Italic" FontWeight="Bold" Text="" TextWrapping="Wrap" Foreground="{ext:ThemeBasedColor DarkSlateGrayWhite}" />
    </Grid>
    <Grid Row="2" Margin="0,6,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1.5*" />
        <ColumnDefinition Width="5*" />
      </Grid.ColumnDefinitions>
      <customWindowControls:CWCSimpleButton Name="BE_QtyMinus" Grid.Column="0" Height="30" Margin="5,-6,9,-10" Padding="0" Style="{StaticResource ButtonStyle}" UseLayoutRounding="True" Click="BE_QtyMinus_Click">
        <TextBlock Name="Minus" Width="auto" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Text="Քան. -" TextAlignment="Center" UseLayoutRounding="True" />
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="BE_QtyPlus" Grid.Column="1" Height="30" Margin="5,-6,9,-10" Padding="0" VerticalAlignment="Stretch" Style="{StaticResource ButtonStyle}" UseLayoutRounding="True" Click="BE_QtyPlus_Click">
        <TextBlock Name="Plus" Width="auto" Margin="0,0,0,0" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Text="Քան. +" TextAlignment="Center" UseLayoutRounding="True" />
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="BE_Discount" Grid.Column="2" Height="30" Margin="11,-6,9,-10" Padding="0" Style="{StaticResource ButtonStyle}" UseLayoutRounding="True" Click="BE_Discount_Click">
        <StackPanel>
          <TextBlock Name="DiscountName" Width="auto" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Text="Զեղչ (%, ∑)" TextAlignment="Center" UseLayoutRounding="True" />
        </StackPanel>
      </customWindowControls:CWCSimpleButton>
      <TextBlock Name="TB_GoodRemInfo" Grid.Column="3" Margin="0,0,0,-7" Padding="0,2,7,0" VerticalAlignment="Stretch" FontSize="13" FontStyle="Italic" FontWeight="Bold" Text="" TextAlignment="Right" UseLayoutRounding="True" Foreground="{ext:ThemeBasedColor DarkSlateGray#ffffff}" />
    </Grid>
  </Grid>
</UserControl>
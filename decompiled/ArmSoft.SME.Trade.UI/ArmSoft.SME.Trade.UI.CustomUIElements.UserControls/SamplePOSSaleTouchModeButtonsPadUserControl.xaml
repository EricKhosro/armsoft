<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ArmSoft.SME.Trade.UI.CustomUIElements.UserControls.SamplePOSSaleTouchModeButtonsPadUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:coreCommon="clr-namespace:ArmSoft.SME.Common;assembly=ArmSoft.SME.Common" xmlns:customWindowControls="clr-namespace:ArmSoft.SME.Core.UI.CustomWindowControls;assembly=ArmSoft.SME.Core.UI" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:tradeCommon="clr-namespace:ArmSoft.SME.Trade.Common;assembly=ArmSoft.SME.Trade.Common" xmlns:userControls="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.UserControls" Style="{StaticResource BaseUserControlStyle}">
  <Grid Name="MainGrid">
    <Grid Name="OperationButtonsGrid" Row="0" VerticalAlignment="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource SamplePOSPrimaryButtonsSeparatorColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource SamplePOSPrimaryButtonsSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource SamplePOSPrimaryButtonsSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
      </Grid.RowDefinitions>
      <customWindowControls:CWCSimpleButton Name="ButtonCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource SamplePOSPrimaryButtonStyle}" Click="ButtonCard_Click">
        <Grid Style="{StaticResource SamplePOSButtonWithImageAndTextContentGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonTextColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
          </Grid.ColumnDefinitions>
          <dx:DXImage Grid.Column="0" Style="{StaticResource SamplePOSButtonWithContentImageStyle}" Source="{ext:ASImage pos_customer_card_32.svg}" />
          <TextBlock Name="ButtonCardCaption" Grid.Column="1" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="ButtonSelectMT" Grid.Row="0" Grid.Column="2" Style="{StaticResource SamplePOSPrimaryButtonStyle}" Click="ButtonSelectMT_Click">
        <Grid Style="{StaticResource SamplePOSButtonWithImageAndTextContentGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonTextColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
          </Grid.ColumnDefinitions>
          <dx:DXImage Grid.Column="0" Style="{StaticResource SamplePOSButtonWithContentImageStyle}" Source="{ext:ASImage pos_product_find_32.svg}" />
          <TextBlock Name="ButtonSelectMTCaption" Grid.Column="1" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" Text="{x:Static coreCommon:Resources.Products}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="ButtonReturn" Grid.Row="2" Grid.Column="0" Style="{StaticResource SamplePOSPrimaryButtonStyle}" Click="ButtonReturn_Click">
        <Grid Style="{StaticResource SamplePOSButtonWithImageAndTextContentGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonTextColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
          </Grid.ColumnDefinitions>
          <dx:DXImage Grid.Column="0" Style="{StaticResource SamplePOSButtonWithContentImageStyle}" Source="{ext:ASImage pos_return_32.svg}" />
          <TextBlock Name="ButtonReturnCaption" Grid.Column="1" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" Text="{x:Static tradeCommon:Resources.ReturnWord}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="ButtonDefer" Grid.Row="2" Grid.Column="2" Style="{StaticResource SamplePOSPrimaryButtonStyle}" ToolTip="(Ctrl+Shift+D)" Visibility="Hidden" Click="ButtonDefer_Click">
        <Grid Style="{StaticResource SamplePOSButtonWithImageAndTextContentGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonTextColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
          </Grid.ColumnDefinitions>
          <dx:DXImage Grid.Column="0" Style="{StaticResource SamplePOSButtonWithContentImageStyle}" Source="{ext:ASImage pos_hold_32.svg}" />
          <TextBlock Name="ButtonDeferCaption" Grid.Column="1" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" Text="{x:Static tradeCommon:Resources.Defer}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="ButtonContinue" Grid.Row="2" Grid.Column="2" Style="{StaticResource SamplePOSPrimaryButtonStyle}" Visibility="Visible" Click="ButtonContinue_Click">
        <Grid Style="{StaticResource SamplePOSButtonWithImageAndTextContentGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonTextColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
          </Grid.ColumnDefinitions>
          <dx:DXImage Grid.Column="0" Style="{StaticResource SamplePOSButtonWithContentImageStyle}" Source="{ext:ASImage pos_unhold_32.svg}" />
          <TextBlock Name="ButtonContinueCaption" Grid.Column="1" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" Text="{x:Static tradeCommon:Resources.Continue}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="ButtonOther" Grid.Row="4" Grid.Column="0" Style="{StaticResource SamplePOSOtherOperationButtonStyle}" Click="ButtonOther_Click">
        <Grid>
          <Border Style="{StaticResource FeatureEditedStateBordersStyle}">
            <TextBlock Style="{StaticResource FeatureAddedNewStateTextStyle}" Text="{x:Static coreCommon:Resources.EditedFeature}" />
          </Border>
          <Grid Style="{StaticResource SamplePOSButtonWithImageAndTextContentGridStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
              <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonTextColumnDefintionStyle}" />
              <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
            </Grid.ColumnDefinitions>
            <dx:DXImage Grid.Column="0" Style="{StaticResource SamplePOSButtonWithContentImageStyle}" Source="{ext:ASImage pos_menu_32.svg}" />
            <TextBlock Name="OtherButtonCaption" Grid.Column="1" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" Text="{x:Static coreCommon:Resources.Other}" />
          </Grid>
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="ButtonMTFavorites" Grid.Row="4" Grid.Column="2" Style="{StaticResource SamplePOSPrimaryButtonStyle}" Click="ButtonMTFavorites_Click">
        <Grid Style="{StaticResource SamplePOSButtonWithImageAndTextContentGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonTextColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
          </Grid.ColumnDefinitions>
          <dx:DXImage Grid.Column="0" Style="{StaticResource SamplePOSButtonWithContentImageStyle}" Source="{ext:ASImage pos_favorites_32.svg}" />
          <TextBlock Name="ButtonMTFavoritesCaption" Grid.Column="1" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" Text="{x:Static coreCommon:Resources.RibbonPageFavorites}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
    </Grid>
    <Grid Name="DocumentSavingButtonsGrid" Row="4" VerticalAlignment="Bottom">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource SamplePOSPrimaryButtonsSeparatorColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource SamplePOSPrimaryButtonsSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
      </Grid.RowDefinitions>
      <customWindowControls:CWCSimpleButton Name="PrintButton" Grid.Row="0" Grid.Column="0" Style="{StaticResource SamplePOSImportantOperationButtonStyle}" Click="PrintButton_Click">
        <Grid Style="{StaticResource SamplePOSButtonWithImageAndTextContentGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonTextColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
          </Grid.ColumnDefinitions>
          <dx:DXImage Grid.Column="0" Style="{StaticResource SamplePOSButtonWithContentImageStyle}" Source="{ext:ASImage pos_print_32.svg}" />
          <TextBlock Name="PrintButtonCaption" Grid.Column="1" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" Text="{x:Static tradeCommon:Resources.PrintCheck}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="PrintECRCheckButton" Grid.Row="0" Grid.Column="2" Style="{StaticResource SamplePOSImportantOperationButtonStyle}" Click="PrintECRCheckButton_Click">
        <Grid Style="{StaticResource SamplePOSButtonWithImageAndTextContentGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonTextColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
          </Grid.ColumnDefinitions>
          <dx:DXImage Grid.Column="0" Style="{StaticResource SamplePOSButtonWithContentImageStyle}" Source="{ext:ASImage pos_ecr_print_32.svg}" />
          <TextBlock Name="PrintECRCheckButtonCaption" Grid.Column="1" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" Text="{x:Static coreCommon:Resources.ECRC}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="ButtonSave" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SamplePOSApplyButtonStyle}" Click="ButtonSave_Click">
        <Grid Style="{StaticResource SamplePOSButtonWithImageAndTextContentGridStyle}">
          <TextBlock Name="ButtonSaveCaption" Style="{StaticResource SamplePOSApplyButtonWithContentTextBlockStyle}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
    </Grid>
  </Grid>
</UserControl>
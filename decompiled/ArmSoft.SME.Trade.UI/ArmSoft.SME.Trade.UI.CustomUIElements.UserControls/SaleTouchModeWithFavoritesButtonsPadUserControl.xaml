        <TextBlock Name="ButtonCardCaption1" Grid.Row="1" Style="{StaticResource TouchModeSecondarySimpleButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.Card}" />
        <TextBlock Name="ButtonCardKeyGesture" Grid.Row="2" Style="{StaticResource TouchModeSecondaryKeyGestureButtonTextBlockStyle}" Text="()" />
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="ButtonClearPayment" Grid.Row="4" Grid.Column="8" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ButtonClearPayment_Click">

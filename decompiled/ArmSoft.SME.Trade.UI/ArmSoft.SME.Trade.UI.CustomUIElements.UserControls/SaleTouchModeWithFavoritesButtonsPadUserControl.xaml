      <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
    </Grid.RowDefinitions>
    <userControls:NumericTouchPadControl ButtonClick="NumericTouchPadButton_Click" Grid.Row="0" Grid.RowSpan="7" Grid.Column="0" Grid.ColumnSpan="5" RedesignedHideLastRow="true" />
    <customWindowControls:CWCSimpleButton Name="ButtonQTY" Grid.Row="0" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ButtonQTY_Click">
      <Grid Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
        <Grid.RowDefinitions>
          <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
          <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
        </Grid.RowDefinitions>
        <TextBlock Name="ButtonQTYCaption" Grid.Row="0" Style="{StaticResource TouchModeSecondarySimpleButtonTextBlockStyle}" Text="{x:Static coreCommon:Resources.SummaryCnt}" />
        <TextBlock Name="ButtonQTYKeyGesture" Grid.Row="1" Style="{StaticResource TouchModeSecondaryKeyGestureButtonTextBlockStyle}" Text="(Ctrl+F9)" />
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="ButtonCash" Grid.Row="0" Grid.Column="8" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ButtonCash_Click">
      <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">

          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
          </Grid.RowDefinitions>
          <TextBlock Name="ButtonCashCaption" Grid.Row="0" Style="{StaticResource TouchModePrimarySimpleButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.CashShort}" />
          <TextBlock Name="ButtonCashKeyGesture" Grid.Row="1" Style="{StaticResource TouchModePrimaryKeyGestureButtonTextBlockStyle}" Text="(F6)" />
        </Grid>
        <Rectangle Style="{StaticResource TouchModeApplyButtonBottomLineRectangleStyle}" />
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="ButtonName" Grid.Row="2" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ButtonSelectMT_Click">
      <Grid Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
        <Grid.RowDefinitions>
          <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />

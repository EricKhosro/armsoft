<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ArmSoft.SME.Trade.UI.CustomUIElements.UserControls.FavoritesTouchPadControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:coreCommon="clr-namespace:ArmSoft.SME.Common;assembly=ArmSoft.SME.Common" xmlns:customWindowControls="clr-namespace:ArmSoft.SME.Core.UI.CustomWindowControls;assembly=ArmSoft.SME.Core.UI" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:tradeCommon="clr-namespace:ArmSoft.SME.Trade.Common;assembly=ArmSoft.SME.Trade.Common" x:Name="FavoritesTouchPad" xmlns:usercontrols="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.UserControls;assembly=ArmSoft.SME.Trade.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ControlTemplate x:Key="{dxgt:GridCardThemeKey ResourceKey=ContainerTemplate, IsThemeIndependent=True}" TargetType="{x:Type ContentControl}">
        <Border Name="Root" Margin="0" Padding="0" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
          <ContentPresenter />
        </Border>
      </ControlTemplate>
      <Style x:Key="{dxgt:GridCardThemeKey ResourceKey=ContentPresenterStyle, IsThemeIndependent=True}" TargetType="{x:Type ContentPresenter}">
        <Setter Property="Margin" Value="3" />
      </Style>
      <Style x:Key="{x:Type dxg:GridCardHeaderControl}" TargetType="{x:Type dxg:GridCardHeaderControl}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate>
              <Border Height="0" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="FavoritesToolBarButtonStyle" TargetType="{x:Type dx:SimpleButton}">
        <Setter Property="Background" Value="{ext:ThemeBasedColor #ebebeb#49504b}" />
        <Setter Property="Foreground" Value="#ebebeb" />
        <Setter Property="Width" Value="55" />
        <Setter Property="Height" Value="40" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type dx:SimpleButton}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="1" CornerRadius="5" BorderBrush="{ext:ThemeBasedColor #b7b7b7#606862}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="FavoritesToolBarButtonImageStyle" TargetType="{x:Type dx:DXImage}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
      </Style>
      <Style x:Key="ListSelectedItemNameAsTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ext:ThemeBasedColor #000000#FFFFFF}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="FavoriteProductsGridBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{ext:ThemeBasedColor #FDFDFD#3d443f}" />
        <Setter Property="Border.CornerRadius" Value="12" />
        <Setter Property="Border.Padding" Value="4" />
      </Style>
      <Style x:Key="FavoritesProductsListGridStyle" TargetType="{x:Type customWindowControls:CWCGridControl}">
        <Setter Property="dxg:DataControlBase.ShowBorder" Value="False" />
        <Setter Property="dx:ScrollBarExtensions.ScrollBarMode" Value="TouchOverlap" />
      </Style>
      <Style x:Key="FavoritesProductCardViewStyle" TargetType="{x:Type dxg:CardView}">
        <Setter Property="dxg:CardView.AllowCardResizing" Value="True" />
        <Setter Property="dxg:DataViewBase.AllowColumnFiltering" Value="True" />
        <Setter Property="dxg:DataViewBase.AllowColumnMoving" Value="False" />
        <Setter Property="dxg:DataViewBase.AllowEditing" Value="False" />
        <Setter Property="dxg:GridViewBase.AllowGrouping" Value="False" />
        <Setter Property="dxg:DataViewBase.AllowMoveColumnToDropArea" Value="False" />
        <Setter Property="dxg:DataViewBase.AllowSorting" Value="False" />
        <Setter Property="dxg:CardView.CardAlignment" Value="Near" />
        <Setter Property="dxg:CardView.CardLayout" Value="Rows" />
        <Setter Property="dxg:CardView.MinFixedSize" Value="50" />
        <Setter Property="dxg:DataViewBase.NavigationStyle" Value="Row" />
        <Setter Property="dxg:CardView.PrintAutoCardWidth" Value="False" />
        <Setter Property="dxg:DataViewBase.ScrollingMode" Value="Normal" />
        <Setter Property="dxg:DataViewBase.ShowColumnHeaders" Value="False" />
        <Setter Property="dxg:DataViewBase.ShowEmptyText" Value="True" />
        <Setter Property="dxg:GridViewBase.ShowGroupPanel" Value="False" />
        <Setter Property="dxg:DataViewBase.ScrollingMode" Value="Normal" />
        <Setter Property="dxg:GridViewBase.ShowGroupedColumns" Value="True" />
        <Setter Property="Visibility" Value="Visible" />
      </Style>
      <Style x:Key="FavoriteProductCardBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Border.Padding" Value="0,0,0,4" />
        <Setter Property="Background" Value="{ext:ThemeBasedColor #FDFDFD#212121}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Border.CornerRadius" Value="12" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="12" Opacity="0.35" RenderingBias="Quality" ShadowDepth="2" Color="{ext:ThemeBasedNotBrushedColor #000000#FFFFFF}" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="FavoriteProductCardGridStyle" TargetType="{x:Type Grid}">
        <Setter Property="Height" Value="auto" />
      </Style>
      <Style x:Key="FavoriteProductCardImageStyle" TargetType="{x:Type dx:DXImage}">
        <Setter Property="Margin" Value="4,4,4,0" />
        <Setter Property="Stretch" Value="Uniform" />
      </Style>
      <Style x:Key="FavoriteCardInfoStackPanel" TargetType="{x:Type StackPanel}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="StackPanel.Orientation" Value="Vertical" />
      </Style>
      <Style x:Key="FavoriteCardProductCaptionTextEditStyle" TargetType="{x:Type dxe:TextEdit}">
        <Setter Property="MaxHeight" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="dxe:BaseEdit.IsPrintingMode" Value="True" />
        <Setter Property="dxe:TextEditBase.TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ext:ThemeBasedColor #000000#FFFFFF}" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding Row.IsGroup}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="FavoriteCardProductPriceTextEditStyle" TargetType="{x:Type dxe:TextEdit}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ext:ThemeBasedColor #5C7AB2#58b8fe}" />
        <Setter Property="dxe:BaseEdit.IsPrintingMode" Value="True" />
        <Setter Property="dxe:TextEdit.Mask" Value="n0" />
        <Setter Property="dxe:TextEdit.MaskType" Value="Numeric" />
        <Setter Property="dxe:TextEdit.MaskUseAsDisplayFormat" Value="True" />
        <Setter Property="dxe:TextEditBase.TextWrapping" Value="Wrap" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding Row.IsGroup}">
            <Setter Property="Visibility" Value="Hidden" />
          </DataTrigger>
          <DataTrigger Value="True" Binding="{Binding Row.HasPrice}">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="FavControlGrid" UseLayoutRounding="True">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="auto" />
      <ColumnDefinition Style="{StaticResource SamplePOSPrimaryButtonsSeparatorColumnDefintionStyle}" />
      <ColumnDefinition Width="auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <customWindowControls:CWCSimpleButton Name="BE_Back" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource FavoritesToolBarButtonStyle}" Click="BackButtonEdit_Click">
      <dx:DXImage Style="{StaticResource FavoritesToolBarButtonImageStyle}" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=pos_home_32.svg}" />
    </customWindowControls:CWCSimpleButton>
    <TextBlock Name="GroupName" Grid.Row="0" Grid.Column="1" Style="{StaticResource ListSelectedItemNameAsTitleStyle}" />
    <customWindowControls:CWCSimpleButton Name="BE_Down" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource FavoritesToolBarButtonStyle}" Click="DownButtonEdit_Click">
      <dx:DXImage Style="{StaticResource FavoritesToolBarButtonImageStyle}" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=pos_down_32.svg}" />
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="BE_Up" Grid.Row="0" Grid.Column="4" HorizontalAlignment="Right" Style="{StaticResource FavoritesToolBarButtonStyle}" Click="UpButtonEdit_Click">
      <dx:DXImage Style="{StaticResource FavoritesToolBarButtonImageStyle}" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=pos_up_32.svg}" />
    </customWindowControls:CWCSimpleButton>
    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Style="{StaticResource FavoriteProductsGridBorderStyle}">
      <customWindowControls:CWCGridControl Name="FavoritsTouchGridControl" Style="{StaticResource FavoritesProductsListGridStyle}" PreviewMouseLeftButtonDown="FavoritsTouchGridControlPreview_MouseDown">
        <dxg:GridControl.Columns>
          <dxg:GridColumn FieldName="MTCode" Header="MTCode" />
          <dxg:GridColumn FieldName="Caption" Header="Caption" />
        </dxg:GridControl.Columns>
        <dxg:GridControl.View>
          <dxg:CardView Name="CardView" Style="{StaticResource FavoritesProductCardViewStyle}">
            <dxg:CardView.CardTemplate>
              <DataTemplate>
                <Border Style="{StaticResource FavoriteProductCardBorderStyle}">
                  <Grid Style="{StaticResource FavoriteProductCardGridStyle}" Width="{Binding Path=CardViewWidth, Source={x:Reference FavoritesTouchPad}}">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <dx:DXImage Name="ItemImage" Stretch="Uniform" Source="{Binding Row.ImgStr, Converter={StaticResource MTImageConverter}, Mode=OneWay}">
                      <FrameworkElement.Style>
                        <Style BasedOn="{StaticResource FavoriteProductCardImageStyle}" TargetType="{x:Type dx:DXImage}">
                          <Style.Triggers>
                            <DataTrigger Value="False" Binding="{Binding Row.HasImage}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Value="True" Binding="{Binding Row.HasImage}">
                              <Setter Property="Grid.Row" Value="0" />
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </dx:DXImage>
                    <StackPanel Name="ItemInfo_0">
                      <FrameworkElement.Style>
                        <Style BasedOn="{StaticResource FavoriteCardInfoStackPanel}" TargetType="{x:Type StackPanel}">
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding Row.HasImage}">
                              <Setter Property="Grid.Row" Value="1" />
                              <Setter Property="VerticalAlignment" Value="Top" />
                            </DataTrigger>
                            <DataTrigger Value="False" Binding="{Binding Row.HasImage}">
                              <Setter Property="Grid.Row" Value="0" />
                              <Setter Property="Grid.RowSpan" Value="2" />
                              <Setter Property="VerticalAlignment" Value="Center" />
                              <Setter Property="HorizontalAlignment" Value="Center" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                      <dxe:TextEdit Style="{StaticResource FavoriteCardProductCaptionTextEditStyle}" EditValue="{Binding Row.Caption}" />
                      <dxe:TextEdit Style="{StaticResource FavoriteCardProductPriceTextEditStyle}" EditValue="{Binding Row.Price}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </dxg:CardView.CardTemplate>
            <dxg:DataViewBase.RuntimeLocalizationStrings>
              <dxg:GridRuntimeStringCollection>
                <dxg:RuntimeStringIdInfo Id="NoRecords" Value="{x:Static tradeCommon:Resources.ValidateEmptyMtList}" />
              </dxg:GridRuntimeStringCollection>
            </dxg:DataViewBase.RuntimeLocalizationStrings>
          </dxg:CardView>
        </dxg:GridControl.View>
      </customWindowControls:CWCGridControl>
    </Border>
  </Grid>
</UserControl>
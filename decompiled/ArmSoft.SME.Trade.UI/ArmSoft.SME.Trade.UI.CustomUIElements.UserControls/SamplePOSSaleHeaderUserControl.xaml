<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ArmSoft.SME.Trade.UI.CustomUIElements.UserControls.SamplePOSSaleHeaderUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:coreCommon="clr-namespace:ArmSoft.SME.Common;assembly=ArmSoft.SME.Common" xmlns:customWindowControls="clr-namespace:ArmSoft.SME.Core.UI.CustomWindowControls;assembly=ArmSoft.SME.Core.UI" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:tradeCommon="clr-namespace:ArmSoft.SME.Trade.Common;assembly=ArmSoft.SME.Trade.Common" Padding="1,1" xmlns:usercontrols="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.UserControls;assembly=ArmSoft.SME.Trade.UI">
  <Grid Name="ControlGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="auto" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryFieldsSeparatorLineColumnDefintionStyle}" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryFieldsSeparatorLineColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModeConnectionIndicatorColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryFieldsSeparatorLineColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModeCloseButtonColumnDefintionStyle}" />
    </Grid.ColumnDefinitions>
    <Grid Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryFieldsSeparatorLineColumnDefintionStyle}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <dx:DXImage Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SamplePOSInsideHeaderTitleImageStyle}" Source="{ext:ASImage pos_user_32.svg}" />
      <TextBlock Name="UserNameTextBlock" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SamplePOSHeaderUserInfoTextBlockStyle}" />
    </Grid>
    <StackPanel Grid.Column="2" HorizontalAlignment="Center" Style="{StaticResource TouchModeHorizontalStackPanelStyle}">
      <TextBlock Name="TB_SaleNumCaption" Style="{StaticResource SamplePOSHeaderTextBlockStyle}" Text="{Binding Converter={StaticResource TextWithTwoDotsConverter}, ConverterParameter={x:Static tradeCommon:Resources.SaleNumber}}" />
      <TextBlock Name="TB_SaleNum" Style="{StaticResource SamplePOSHeaderTextBlockStyle}" />
      <TextBlock Name="TB_Separator" Style="{StaticResource SamplePOSHeaderTextBlockStyle}" />
      <TextBlock Name="TB_BaseDoc" Style="{StaticResource SamplePOSHeaderTextBlockStyle}" />
    </StackPanel>
    <Border Name="ConnectionIndicatorBorder" Grid.Column="4" Style="{StaticResource ConnectionIndicatorBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <dx:DXImage Name="ConnectionIndicatorImage" Grid.Column="0" Style="{StaticResource SamplePOSInsideCardTitleImageStyle}" />
        <TextBlock Name="ConnectionIndicatorTextBlock" Grid.Column="1" Style="{StaticResource ConnectionIndicatorTextBlockStyle}" />
      </Grid>
    </Border>
    <customWindowControls:CWCSimpleButton Name="CloseTitleButton" Grid.Column="6" Style="{StaticResource HeaderCloseButtonStyle}" ToolTip="{x:Static coreCommon:Resources.ExitWord}" Click="CloseTitleButton_Click">
      <dx:DXImage Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=delete_20.svg}" />
    </customWindowControls:CWCSimpleButton>
  </Grid>
</UserControl>
<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ArmSoft.SME.Trade.UI.CustomUIElements.UserControls.SaleStatusBarUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:usercontrols="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.UserControls;assembly=ArmSoft.SME.Trade.UI" Background="{ext:ThemeBasedColor #3e7337#3d443f}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Rectangle Grid.Column="0" Grid.ColumnSpan="20" Fill="#00FFFFFF" UseLayoutRounding="True" />
    <TextBlock Name="TB_GridRowInfo" Grid.Column="0" Width="100" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="0/0" UseLayoutRounding="True" />
    <Rectangle Grid.Column="1" Style="{StaticResource StatusBarSeparatorRectangleStyle}" />
    <TextBlock Name="TB_QTYCaption" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="Քան․ " UseLayoutRounding="True" />
    <TextBlock Name="TB_QTY" Grid.Column="3" Width="90" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="0.000" UseLayoutRounding="True" />
    <Rectangle Grid.Column="4" Style="{StaticResource StatusBarSeparatorRectangleStyle}" />
    <dx:DXImage Grid.Column="5" Margin="5,0,5,0" VerticalAlignment="Center" Stretch="None" UseLayoutRounding="True" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=user_white_16.svg}" />
    <TextBlock Name="TB_User" Grid.Column="7" Width="125" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="" UseLayoutRounding="True" />
    <Rectangle Grid.Column="8" Style="{StaticResource StatusBarSeparatorRectangleStyle}" />
    <TextBlock Name="TB_SaleConsultantCaption" Grid.Column="9" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="Վաճառող։ " UseLayoutRounding="True" />
    <TextBlock Name="TB_SaleConsultant" Grid.Column="10" Width="140" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="" UseLayoutRounding="True" />
    <Rectangle Grid.Column="11" Style="{StaticResource StatusBarSeparatorRectangleStyle}" />
    <TextBlock Name="TB_ShiftCaption" Grid.Column="12" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="Հերթ․ N " UseLayoutRounding="True" />
    <TextBlock Name="TB_Shift" Grid.Column="13" Width="250" Margin="0,0,0,5" VerticalAlignment="Bottom" Foreground="#FFFFFFFF" Text="" UseLayoutRounding="True" />
    <Rectangle Grid.Column="15" Style="{StaticResource StatusBarSeparatorRectangleStyle}" />
    <TextBlock Name="TB_TurnedOnb2barmsoftDiscountServer" Grid.Column="16" Margin="5,0,5,0" Padding="4" Background="#F9E075" Foreground="#FF000000" Text="Միացված է b2b.armsoft ԲՍ" TextAlignment="Center" />
    <Rectangle Grid.Column="17" Style="{StaticResource StatusBarSeparatorRectangleStyle}" />
    <dx:DXImage Grid.Column="18" Margin="5,0,5,0" VerticalAlignment="Center" Stretch="None" UseLayoutRounding="True" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=time_white_16.svg}" />
    <TextBlock Name="TB_Time" Grid.Column="19" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="24/04/18 17:15" UseLayoutRounding="True" />
  </Grid>
</UserControl>
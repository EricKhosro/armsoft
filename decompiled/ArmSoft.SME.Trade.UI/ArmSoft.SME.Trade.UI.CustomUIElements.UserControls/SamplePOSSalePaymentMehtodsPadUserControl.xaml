<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ArmSoft.SME.Trade.UI.CustomUIElements.UserControls.SamplePOSSalePaymentMehtodsPadUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:coreCommon="clr-namespace:ArmSoft.SME.Common;assembly=ArmSoft.SME.Common" xmlns:customWindowControls="clr-namespace:ArmSoft.SME.Core.UI.CustomWindowControls;assembly=ArmSoft.SME.Core.UI" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:tradeCommon="clr-namespace:ArmSoft.SME.Trade.Common;assembly=ArmSoft.SME.Trade.Common" xmlns:userControls="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.UserControls" Style="{StaticResource BaseUserControlStyle}">
  <Grid Name="PaymentMethodsGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Style="{StaticResource SamplePOSPrimaryButtonsSeparatorRowDefintionStyle}" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Name="CashInfoGrid" Row="0" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Style="{StaticResource SamplePOSPrimaryButtonColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource SamplePOSPrimaryButtonsSeparatorColumnDefintionStyle}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <customWindowControls:CWCSimpleButton Name="CashButton" Grid.Column="0" VerticalAlignment="Bottom" Style="{StaticResource SamplePOSPrimaryButtonStyle}" Click="ButtonCash_Click">
        <Grid Style="{StaticResource SamplePOSButtonWithImageAndTextContentGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonTextColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
          </Grid.ColumnDefinitions>
          <dx:DXImage Grid.Column="0" Style="{StaticResource SamplePOSButtonWithContentImageStyle}" Source="{ext:ASImage pos_pay_cash_32.svg}" />
          <TextBlock Name="CashButtonCaption" Grid.Column="1" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" Text="{x:Static coreCommon:Resources.CashSum}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="CashQRButton" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SamplePOSPrimaryButtonStyle}" Click="ButtonCash_Click">
        <Grid Style="{StaticResource SamplePOSButtonWithImageAndTextContentGridStyle}">
          <Image Style="{StaticResource SamplePOSButtonWithQRStyle}" Source="{ext:ASImage pay_by_cash_qr.svg}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <Grid Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Style="{StaticResource SamplePOSQRButtonInfoCaptionRowDefinition}" />
          <RowDefinition Style="{StaticResource SamplePOSVerticalValueCaptionSeparatorRowDefinition}" />
          <RowDefinition Style="{StaticResource SamplePOSVerticalValueCaptionSeparatorRowDefinition}" />
          <RowDefinition Style="{StaticResource SamplePOSQRButtonInfoValueRowDefinition}" />
        </Grid.RowDefinitions>
        <TextBlock Name="CashQRButtonCaption" Grid.Row="0" VerticalAlignment="Bottom" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" Text="{x:Static coreCommon:Resources.CashSum}" />
        <Border Name="CashSummTextBorder" Style="{StaticResource TextBlockWithSelectedInfoBorderStyle}">
          <TextBlock Name="TB_Cash" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SamplePOSPrimarySumsTextBlockStyle}" Text="0.00" />
        </Border>
      </Grid>
    </Grid>
    <Grid Name="NonCashInfoGrid" Row="2" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Style="{StaticResource SamplePOSPrimaryButtonColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource SamplePOSPrimaryButtonsSeparatorColumnDefintionStyle}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <customWindowControls:CWCSimpleButton Name="NonCashButton" Grid.Column="0" VerticalAlignment="Bottom" Style="{StaticResource SamplePOSPrimaryButtonStyle}" Click="ButtonNotCash_Click">
        <Grid Style="{StaticResource SamplePOSButtonWithImageAndTextContentGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonTextColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonImageColumnDefintionStyle}" />
          </Grid.ColumnDefinitions>
          <dx:DXImage Grid.Column="0" Style="{StaticResource SamplePOSButtonWithContentImageStyle}" Source="{ext:ASImage pos_pay_card_32.svg}" />
          <TextBlock Grid.Column="1" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" Text="{x:Static coreCommon:Resources.PlCardSum}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="NonCashQRButton" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SamplePOSPrimaryButtonStyle}" Click="ButtonNotCash_Click">
        <Grid Style="{StaticResource SamplePOSButtonWithImageAndTextContentGridStyle}">
          <Image Style="{StaticResource SamplePOSButtonWithQRStyle}" Source="{ext:ASImage pay_by_non_cash_qr.svg}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <Grid Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Style="{StaticResource SamplePOSQRButtonInfoCaptionRowDefinition}" />
          <RowDefinition Style="{StaticResource SamplePOSVerticalValueCaptionSeparatorRowDefinition}" />
          <RowDefinition Style="{StaticResource SamplePOSVerticalValueCaptionSeparatorRowDefinition}" />
          <RowDefinition Style="{StaticResource SamplePOSQRButtonInfoValueRowDefinition}" />
        </Grid.RowDefinitions>
        <TextBlock Name="NonCashQRButtonCaption" Grid.Row="0" VerticalAlignment="Bottom" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" Text="{x:Static coreCommon:Resources.PlCardSum}" />
        <Border Name="NonCashSummTextBorder" Style="{StaticResource TextBlockWithSelectedInfoBorderStyle}">
          <TextBlock Name="TB_NoCash" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SamplePOSPrimarySumsTextBlockStyle}" Text="0.00" />
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
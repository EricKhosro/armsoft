<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ArmSoft.SME.Trade.UI.CustomUIElements.UserControls.SaleTouchModeWithFavoritesAltModeButtonsPadUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:coreCommon="clr-namespace:ArmSoft.SME.Common;assembly=ArmSoft.SME.Common" xmlns:customWindowControls="clr-namespace:ArmSoft.SME.Core.UI.CustomWindowControls;assembly=ArmSoft.SME.Core.UI" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:tradeCommon="clr-namespace:ArmSoft.SME.Trade.Common;assembly=ArmSoft.SME.Trade.Common" xmlns:userControls="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.UserControls" Style="{StaticResource BaseUserControlStyle}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
    </Grid.RowDefinitions>
    <userControls:NumericTouchPadControl ButtonClick="NumericTouchPadButton_Click" Grid.Row="0" Grid.RowSpan="7" Grid.Column="0" Grid.ColumnSpan="5" RedesignedHideLastRow="true" />
    <customWindowControls:CWCSimpleButton Name="ButtonCode" Grid.Row="0" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ButtonCode_Click">
      <Grid>
        <Rectangle Style="{StaticResource TouchModeAltButtonBackgroundRectangleStyle}" />
        <Grid Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
          </Grid.RowDefinitions>
          <TextBlock Name="ButtonCodeCaption" Grid.Row="0" Style="{StaticResource TouchModeSecondarySimpleButtonTextBlockStyle}" Text="{x:Static coreCommon:Resources.Code}" />
          <TextBlock Name="ButtonCodeKeyGesture" Grid.Row="1" Style="{StaticResource TouchModeSecondaryKeyGestureButtonTextBlockStyle}" Text="(F8)" />
        </Grid>
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="ButtonFromPrePay" Grid.Row="0" Grid.Column="8" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ButtonFromPrePay_Click">
      <Grid>
        <Rectangle Style="{StaticResource TouchModeAltButtonBackgroundRectangleStyle}" />
        <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
          </Grid.RowDefinitions>
          <Grid Row="0" Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
            <Grid.RowDefinitions>
              <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
              <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
              <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
            </Grid.RowDefinitions>
            <TextBlock Name="ButtonFromPrePayCaption" Grid.Row="0" Style="{StaticResource TouchModePrimarySimpleButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.UsePrePaymentPart1}" />
            <TextBlock Name="ButtonFromPrePayCaption1" Grid.Row="1" Style="{StaticResource TouchModePrimarySimpleButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.UsePrePaymentPart2}" />
            <TextBlock Name="ButtonFromPrePayKeyGesture" Grid.Row="2" Style="{StaticResource TouchModePrimaryKeyGestureButtonTextBlockStyle}" Text="()" />
          </Grid>
          <Rectangle Name="ButtonFromPrePayRectangle" Style="{StaticResource TouchModeApplyButtonBottomLineRectangleStyle}" />
        </Grid>
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="ButtonBarCode" Grid.Row="2" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ButtonBarCode_Click">
      <Grid>
        <Rectangle Style="{StaticResource TouchModeAltButtonBackgroundRectangleStyle}" />
        <Grid Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
          </Grid.RowDefinitions>
          <TextBlock Name="ButtonBarCodeCaption" Grid.Row="0" Style="{StaticResource TouchModeSecondarySimpleButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.cmdBarCodeEnter}" />
          <TextBlock Name="ButtonBarCodeKeyGesture" Grid.Row="1" Style="{StaticResource TouchModeSecondaryKeyGestureButtonTextBlockStyle}" Text="(F7)" />
        </Grid>
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="ButtonCreditSale" Grid.Row="2" Grid.Column="8" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ButtonCreditSale_Click">
      <Grid>
        <Rectangle Style="{StaticResource TouchModeAltButtonBackgroundRectangleStyle}" />
        <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
          </Grid.RowDefinitions>
          <Grid Row="0" Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
            <Grid.RowDefinitions>
              <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
              <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
            </Grid.RowDefinitions>
            <TextBlock Name="ButtonCreditSaleCaption" Grid.Row="0" Style="{StaticResource TouchModePrimarySimpleButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.CreditSale}" />
            <TextBlock Name="ButtonCreditSaleHotKey" Grid.Row="1" Style="{StaticResource TouchModePrimaryKeyGestureButtonTextBlockStyle}" Text="(Ctrl+F11)" />
          </Grid>
          <Rectangle Style="{StaticResource TouchModeApplyButtonBottomLineRectangleStyle}" />
        </Grid>
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="ButtonUseBonus" Grid.Row="4" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ButtonUseBonus_Click">
      <Grid>
        <Rectangle Style="{StaticResource TouchModeAltButtonBackgroundRectangleStyle}" />
        <Grid Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
          </Grid.RowDefinitions>
          <TextBlock Name="ButtonUseBonusCaption" Grid.Row="0" Style="{StaticResource TouchModeSecondarySimpleButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.RePay}" />
          <TextBlock Name="ButtonUseBonusCaption1" Grid.Row="1" Style="{StaticResource TouchModeSecondarySimpleButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.WithBonus}" />
          <TextBlock Name="ButtonUseBonusKeyGesture" Grid.Row="2" Style="{StaticResource TouchModeSecondaryKeyGestureButtonTextBlockStyle}" Text="()" />
        </Grid>
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="ButtonClearPayment" Grid.Row="4" Grid.Column="8" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ButtonClearPayment_Click">
      <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
        <Grid.RowDefinitions>
          <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
          <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
        </Grid.RowDefinitions>
        <Grid Row="0" Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
          </Grid.RowDefinitions>
          <TextBlock Name="ButtonClearPaymentCaption" Grid.Row="0" Style="{StaticResource TouchModePrimarySimpleButtonTextBlockStyle}" Text="{x:Static coreCommon:Resources.ClearWord}" />
          <TextBlock Name="ButtonClearPaymentCaption1" Grid.Row="1" Style="{StaticResource TouchModePrimarySimpleButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.PaymentShort}" />
          <TextBlock Name="ButtonClearPaymentKeyGesture" Grid.Row="2" Style="{StaticResource TouchModePrimaryKeyGestureButtonTextBlockStyle}" Text="()" />
        </Grid>
        <Rectangle Style="{StaticResource TouchModeCancelButtonBottomLineRectangleStyle}" />
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="ButtonAddToBonus" Grid.Row="6" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ButtonAddToBonus_Click">
      <Grid>
        <Rectangle Style="{StaticResource TouchModeAltButtonBackgroundRectangleStyle}" />
        <Grid Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
          </Grid.RowDefinitions>
          <TextBlock Name="ButtonAddToBonusCaption" Grid.Row="0" Style="{StaticResource TouchModeSecondarySimpleButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.AddShort}" />
          <TextBlock Name="ButtonAddToBonusCaption1" Grid.Row="1" Style="{StaticResource TouchModeSecondarySimpleButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.ToBonus}" />
          <TextBlock Name="ButtonAddToBonusKeyGesture" Grid.Row="2" Style="{StaticResource TouchModeSecondaryKeyGestureButtonTextBlockStyle}" Text="()" />
        </Grid>
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="PrintButton" Grid.Row="6" Grid.Column="8" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="PrintButton_Click">
      <Grid>
        <Rectangle Style="{StaticResource TouchModeAltButtonBackgroundRectangleStyle}" />
        <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
          </Grid.RowDefinitions>
          <Grid Row="0" Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
            <Grid.RowDefinitions>
              <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
              <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
            </Grid.RowDefinitions>
            <TextBlock Name="PrintButtonCaption" Grid.Row="0" Style="{StaticResource TouchModePrimarySimpleButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.PrintCheck}" />
            <TextBlock Name="PrintButtonKeyGesture" Grid.Row="1" Style="{StaticResource TouchModePrimaryKeyGestureButtonTextBlockStyle}" Text="(F11)" />
          </Grid>
          <Rectangle Style="{StaticResource TouchModeImportantOperationButtonBottomLineRectangleStyle}" />
        </Grid>
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="ButtonOther" Grid.Row="8" Grid.Column="0" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ButtonOther_Click">
      <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
        <Grid.RowDefinitions>
          <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
          <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
        </Grid.RowDefinitions>
        <dx:DXImage Style="{StaticResource TouchModeInsideButtonImageStyle}" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=hamburger_horizontal_16.svg}" />
        <Rectangle Style="{StaticResource TouchModeOthersButtonBottomLineRectangleStyle}" />
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="ButtonDefer" Grid.Row="8" Grid.Column="2" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ButtonDefer_Click">
      <Grid Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
        <Grid.RowDefinitions>
          <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
          <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
        </Grid.RowDefinitions>
        <TextBlock Name="ButtonDeferCaption" Grid.Row="0" Style="{StaticResource TouchModeSecondaryKeyGestureButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.DeferShort}" />
        <TextBlock Name="ButtonDeferKeyGesture" Grid.Row="1" Style="{StaticResource TouchModeSecondaryKeyGestureButtonTextBlockStyle}" Text="" />
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="ButtonContinue" Grid.Row="8" Grid.Column="4" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ButtonContinue_Click">
      <Grid Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
        <Grid.RowDefinitions>
          <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
          <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
          <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
        </Grid.RowDefinitions>
        <TextBlock Name="ButtonContinueCaption" Grid.Row="0" Style="{StaticResource TouchModeSecondaryKeyGestureButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.ContinueShort}" />
        <TextBlock Name="ButtonContinueCaption1" Grid.Row="1" Style="{StaticResource TouchModeSecondaryKeyGestureButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.SaleShort}" />
        <TextBlock Name="ButtonContinueKeyGesture" Grid.Row="2" Style="{StaticResource TouchModeSecondaryKeyGestureButtonTextBlockStyle}" Text="()" />
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="ButtonSave" Grid.Row="8" Grid.Column="6" Grid.ColumnSpan="3" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ButtonSave_Click">
      <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
        <Grid.RowDefinitions>
          <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
          <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
        </Grid.RowDefinitions>
        <TextBlock Name="ButtonSaveCaption" Style="{StaticResource TouchModePrimarySimpleButtonTextBlockStyle}" />
        <Rectangle Style="{StaticResource TouchModeApplyButtonBottomLineRectangleStyle}" />
      </Grid>
    </customWindowControls:CWCSimpleButton>
  </Grid>
</UserControl>
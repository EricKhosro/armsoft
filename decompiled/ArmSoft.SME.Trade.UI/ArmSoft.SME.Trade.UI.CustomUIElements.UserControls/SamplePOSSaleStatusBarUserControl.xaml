<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ArmSoft.SME.Trade.UI.CustomUIElements.UserControls.SamplePOSSaleStatusBarUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:usercontrols="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.UserControls;assembly=ArmSoft.SME.Trade.UI" Background="{ext:ThemeBasedColor #217346#3d443f}">

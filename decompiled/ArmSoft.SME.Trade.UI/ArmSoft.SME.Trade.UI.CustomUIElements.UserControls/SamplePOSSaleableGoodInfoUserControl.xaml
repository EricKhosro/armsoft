<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ArmSoft.SME.Trade.UI.CustomUIElements.UserControls.SamplePOSSaleableGoodInfoUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:customWindowControls="clr-namespace:ArmSoft.SME.Core.UI.CustomWindowControls;assembly=ArmSoft.SME.Core.UI" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:tradeCommon="clr-namespace:ArmSoft.SME.Trade.Common;assembly=ArmSoft.SME.Trade.Common" xmlns:usercontrols="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.UserControls;assembly=ArmSoft.SME.Trade.UI">
  <FrameworkElement.Resources>
    <ResourceDictionary />
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Style="{StaticResource SamplePOSInsideControlMainGridSeparatorRowDefinition}" />
      <RowDefinition Height="Auto" />
      <RowDefinition Style="{StaticResource SamplePOSInsideControlMainGridSeparatorRowDefinition}" />
      <RowDefinition Style="{StaticResource SamplePOSWindowGridEditButtonsRowDefinition}" />
    </Grid.RowDefinitions>
    <dxe:TextEdit Name="TB_GoodName" Grid.Row="0" NullText="{x:Static tradeCommon:Resources.ValidateEmptyMtList}" Style="{StaticResource SamplePOSImportantInfoDataGridInfoTextEditTStyle}" />
    <Grid Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <dxe:TextEdit Name="TB_GoodRowDetail" Grid.Column="0" NullText="{x:Static tradeCommon:Resources.POSGoodRowDetail_NullText}" Style="{StaticResource SamplePOSDataGridInfoTextEditTStyle}" Text="" />
      <dxe:TextEdit Name="TB_GoodCode" Grid.Column="1" Style="{StaticResource SamplePOSDataGridInfoTextEditTStyle}" Text="" />
    </Grid>
    <Grid Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryFieldsSeparatorLineColumnDefintionStyle}" />
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryFieldsSeparatorLineColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryFieldsSeparatorLineColumnDefintionStyle}" />
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryFieldsSeparatorLineColumnDefintionStyle}" />
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryFieldsSeparatorLineColumnDefintionStyle}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <customWindowControls:CWCSimpleButton Name="BE_QtyMinus" Grid.Column="0" Style="{StaticResource SamplePOSGridColumnEditButtonStyle}" Click="BE_QtyMinus_Click">
        <Grid Style="{StaticResource SamplePOSGridColumnEditButtonWithImageAndTextContentGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonSeparatorColumnsDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonTextColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonSeparatorColumnsDefintionStyle}" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="Minus" Grid.Column="1" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" Text="{x:Static tradeCommon:Resources.QtyMinus}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="BE_QtyPlus" Grid.Column="2" Style="{StaticResource SamplePOSGridColumnEditButtonStyle}" Click="BE_QtyPlus_Click">
        <Grid Style="{StaticResource SamplePOSGridColumnEditButtonWithImageAndTextContentGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonSeparatorColumnsDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonTextColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonSeparatorColumnsDefintionStyle}" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="Plus" Grid.Column="1" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" Text="{x:Static tradeCommon:Resources.QtyPlus}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="BE_Discount" Grid.Column="5" Style="{StaticResource SamplePOSGridColumnEditButtonStyle}" Click="BE_Discount_Click">
        <Grid Style="{StaticResource SamplePOSGridColumnEditButtonWithImageAndTextContentGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonSeparatorColumnsDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonTextColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonSeparatorColumnsDefintionStyle}" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="DiscountName" Grid.Column="1" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="ButtonQTY" Grid.Column="7" Style="{StaticResource SamplePOSGridColumnEditButtonStyle}" Click="ButtonQTY_Click">
        <Grid Style="{StaticResource SamplePOSGridColumnEditButtonWithImageAndTextContentGridStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonSeparatorColumnsDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonTextColumnDefintionStyle}" />
            <ColumnDefinition Style="{StaticResource SamplePOSInsideButtonSeparatorColumnsDefintionStyle}" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="ButtonQTYCaption" Grid.Column="1" Style="{StaticResource SamplePOSButtonWithContentTextBlockStyle}" Text="{x:Static tradeCommon:Resources.Weight}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <Grid Name="GoodRemInfoGrid" Column="9">
        <dxe:TextEdit Name="TB_GoodRemInfo" Margin="10,0" HorizontalAlignment="Right" Style="{StaticResource SamplePOSSecondaryInfoDataGridInfoTextEditTStyle}" Text="" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
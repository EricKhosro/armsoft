<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ArmSoft.SME.Trade.UI.CustomUIElements.UserControls.SaleTotalUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:usercontrols="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.UserControls;assembly=ArmSoft.SME.Trade.UI">
  <Grid Name="Totals" Margin="0,2,0,2">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="170" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Rectangle Name="TotalFill" Grid.RowSpan="8" Grid.ColumnSpan="4" Fill="{ext:ThemeBasedColor #def0e0#49504b}" />
    <StackPanel Name="DiscountCaptionStack" Grid.Row="0" Grid.Column="0" Margin="20,0,20,0" VerticalAlignment="Center" Orientation="Horizontal">
      <TextBlock Name="TB_DiscountCaption" FontSize="16" FontWeight="Bold" Text="Զեղչ" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    </StackPanel>
    <TextBlock Name="TB_CashCaption" Grid.Row="1" Grid.Column="0" Margin="20,0,20,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Text="Կանխիկ" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Name="TB_NoCashCaption" Grid.Row="2" Grid.Column="0" Margin="20,0,20,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Text="Անկանխիկ" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Name="TB_FromBonusCaption" Grid.Row="3" Grid.Column="0" Margin="20,0,20,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Text="Մարում բոնուսից" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Name="TB_FromPrepayCaption" Grid.Row="4" Grid.Column="0" Margin="20,0,20,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Text="Կանխավճար" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Name="TB_CreditSaleCaption" Grid.Row="5" Grid.Column="0" Margin="20,0,20,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Text="Ապառիկ" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Name="TB_MustPayCaption" Grid.Row="6" Grid.Column="0" Margin="20,0,20,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Text="Վճարման" Foreground="{ext:ThemeBasedColor #dd0326#fb7376}" />
    <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="-" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="-" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="-" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="-" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="-" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="-" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="-" Foreground="{ext:ThemeBasedColor #dd0326#fb7376}" />
    <TextBlock Name="TB_Discount" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Text="0.00" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Name="TB_Cash" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Text="0.00" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Name="TB_NoCash" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Text="0.00" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Name="TB_FromBonus" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Text="0.00" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Name="TB_FromPrePay" Grid.Row="4" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Text="0.00" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Name="TB_CreditSale" Grid.Row="5" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Text="0.00" Foreground="{ext:ThemeBasedColor BlackWhite}" />
    <TextBlock Name="TB_MustPay" Grid.Row="6" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Text="0.00" Foreground="{ext:ThemeBasedColor #dd0326#fb7376}" />
    <TextBlock Name="TB_TotalCaption" Grid.Row="0" Grid.RowSpan="5" Grid.Column="4" Margin="0,10,20,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="18" FontWeight="Bold" Text="Ընդամենը" Foreground="{ext:ThemeBasedColor #3e7337#4fad77}" />
    <TextBlock Name="TB_Total" Grid.Row="0" Grid.RowSpan="7" Grid.Column="4" Margin="0,0,20,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="40" FontWeight="Bold" Text="0.00" Foreground="{ext:ThemeBasedColor #3e7337#4fad77}" />
  </Grid>
</UserControl>
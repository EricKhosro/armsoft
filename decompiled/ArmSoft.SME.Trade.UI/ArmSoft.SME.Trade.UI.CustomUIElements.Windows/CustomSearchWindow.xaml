<?xml version="1.0" encoding="utf-8"?>
<dx:ThemedWindow x:Class="ArmSoft.SME.Trade.UI.CustomUIElements.Windows.CustomSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:coreCommon="clr-namespace:ArmSoft.SME.Common;assembly=ArmSoft.SME.Common" xmlns:customWindowControls="clr-namespace:ArmSoft.SME.Core.UI.CustomWindowControls;assembly=ArmSoft.SME.Core.UI" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:tradeUserControls="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.UserControls" Title="{x:Static coreCommon:Resources.Find}" Width="380" Height="340" MinWidth="360" MinHeight="320" Style="{StaticResource TouchModeBaseThemedWindowStyle}" WindowStartupLocation="CenterOwner" xmlns:windows="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.Windows" Activated="CustomSearchControl_Activated" KeyDown="CustomSearchControl_KeyDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="SearchControlStyle" TargetType="{x:Type dxe:SearchControl}">
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="dxe:SearchControl.NullText" Value="" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="Padding" Value="0,0,0,0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="dxe:SearchControl.ShowClearButton" Value="False" />
        <Setter Property="dxe:SearchControl.ShowMRUButton" Value="False" />
        <Setter Property="dxe:SearchControl.ShowSearchPanelNavigationButtons" Value="False" />
        <Setter Property="dxe:SearchControl.FilterCondition" Value="Contains" />
      </Style>
      <Style x:Key="SearchControlComboBoxEditStyle" TargetType="{x:Type dxe:ComboBoxEdit}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Background" Value="{ext:ThemeBasedColor #ffffb2#49504b}" />
      </Style>
      <SolidColorBrush x:Key="{dxt:ThemedWindowThemeKey ResourceKey=WindowActiveBorderBrush}" Color="{ext:ThemeBasedNotBrushedColor #206f37#206f37}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Style="{StaticResource TouchModeSingleWindowContainerGridStyle}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Style="{StaticResource TouchModePrimaryTextEditRowDefintion}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
    </Grid.RowDefinitions>
    <dxe:SearchControl Name="SearchControl" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" Style="{StaticResource SearchControlStyle}">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="{x:Type dxe:ComboBoxEdit}" BasedOn="{StaticResource SearchControlComboBoxEditStyle}" TargetType="{x:Type dxe:ComboBoxEdit}" />
        </ResourceDictionary>
      </FrameworkElement.Resources>
    </dxe:SearchControl>
    <tradeUserControls:NumericTouchPadControl ButtonClick="NumericTouchPadButton_Click" Grid.Row="2" Grid.RowSpan="7" Grid.Column="0" Grid.ColumnSpan="5" RedesignedHideLastRow="True" />
    <customWindowControls:CWCSimpleButton Name="OKButton" Grid.Row="2" Grid.RowSpan="3" Grid.Column="6" IsDefault="True" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="OKButton_Click">
      <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
        <Grid.RowDefinitions>
          <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
          <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
        </Grid.RowDefinitions>
        <dx:DXImage Grid.Row="0" Style="{StaticResource TouchModeInsideButtonImageStyle}" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=accept_32_bold.svg}" />
        <Rectangle Grid.Row="1" Style="{StaticResource TouchModeApplyButtonBottomLineRectangleStyle}" />
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="BackButton" Grid.Row="6" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="BackButton_Click">
      <dx:DXImage Style="{StaticResource TouchModeInsideButtonImageStyle}" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=backspace.svg}" />
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="SlashButton" Grid.Row="8" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="SlashButton_Click">
      <TextBlock Style="{StaticResource TouchModeImportantButtonTextBlockStyle}" Text="/" />
    </customWindowControls:CWCSimpleButton>
  </Grid>
</dx:ThemedWindow>
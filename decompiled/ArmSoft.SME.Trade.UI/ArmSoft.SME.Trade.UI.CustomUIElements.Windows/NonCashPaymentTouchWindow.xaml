    <customWindowControls:CWCSimpleButton Name="ExitButton" Grid.Row="12" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ExitButton_Click">
      <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
        <Grid.RowDefinitions>
          <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
          <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
        </Grid.RowDefinitions>
        <dx:DXImage Style="{StaticResource TouchModeInsideButtonImageStyle}" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=cancel_32_bold.svg}" />
        <Rectangle Style="{StaticResource TouchModeCancelButtonBottomLineRectangleStyle}" />
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <Grid Row="12" Column="0" ColumnSpan="5" Style="{StaticResource TouchModeBaseContainerGridStyle}">
      <Grid.RowDefinitions>
        <RowDefinition Style="{StaticResource TouchModePrimaryTextBlockRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModeInsideContainerSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryTextBlockRowDefintionStyle}" />
      </Grid.RowDefinitions>
      <TextBlock Name="POSTerminal" Grid.Row="0" VerticalAlignment="Bottom" Style="{StaticResource TouchModePrimaryTextBlockStyle}" />
      <TextBlock Name="AcquaringInfo" Grid.Row="2" VerticalAlignment="Top" Style="{StaticResource TouchModeImportantPrimaryTextBlockStyle}" />
    </Grid>
  </Grid>
</dx:ThemedWindow>
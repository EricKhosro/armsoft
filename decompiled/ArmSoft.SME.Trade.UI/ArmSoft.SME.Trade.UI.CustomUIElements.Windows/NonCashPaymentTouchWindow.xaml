    <customWindowControls:CWCSimpleButton Name="BankCardWithPOS4" Grid.Row="10" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="POSTerminal_Click" MouseDoubleClick="POSTerminal_DoubleClick">

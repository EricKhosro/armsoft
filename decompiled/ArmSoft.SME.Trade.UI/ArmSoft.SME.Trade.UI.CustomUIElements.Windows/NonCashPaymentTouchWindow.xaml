    <dxe:PopupCalcEdit Name="SumPopupCalcEdit" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" HorizontalContentAlignment="Left" ShowEditorButtons="False" Style="{StaticResource TouchModeSearchPopupCalcEditStyle}" />

    <Grid Row="0" Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditCaptionRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditRowDefintion}" />
      </Grid.RowDefinitions>
      <TextBlock Name="TB_Name" Grid.Row="0" Style="{StaticResource TouchModePrimaryTextBlockStyle}" Text="{x:Static coreCommon:Resources.Name}" />

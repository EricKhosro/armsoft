        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
      </Grid.RowDefinitions>
      <tradeUserControls:NumericTouchPadControl ButtonClick="NumericTouchPadControlButton_Click" Grid.Row="0" Grid.RowSpan="9" Grid.Column="0" Grid.ColumnSpan="5" RedesignedHideLastRow="false" />
      <customWindowControls:CWCSimpleButton Name="OKButton" Grid.Row="0" Grid.RowSpan="3" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="OKButton_Click">
        <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
          </Grid.RowDefinitions>
          <dx:DXImage Grid.Row="0" Style="{StaticResource TouchModeInsideButtonImageStyle}" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=accept_32_bold.svg}" />
          <Rectangle Style="{StaticResource TouchModeApplyButtonBottomLineRectangleStyle}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="TabButton" Grid.Row="4" Grid.Column="6" IsDefault="True" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="TabButton_Click">
        <Grid Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
          <TextBlock Style="{StaticResource TouchModePrimarySimpleButtonTextBlockStyle}" Text="Tab" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="ButtonSlash" Grid.Row="6" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="SlashButton_Click">
        <Grid Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
          <TextBlock Style="{StaticResource TouchModeImportantButtonTextBlockStyle}" Text="/" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="ExitButton" Grid.Row="8" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ExitButton_Click">
        <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
          </Grid.RowDefinitions>
          <dx:DXImage Style="{StaticResource TouchModeInsideButtonImageStyle}" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=cancel_32_bold.svg}" />
          <Rectangle Style="{StaticResource TouchModeCancelButtonBottomLineRectangleStyle}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
    </Grid>
  </Grid>

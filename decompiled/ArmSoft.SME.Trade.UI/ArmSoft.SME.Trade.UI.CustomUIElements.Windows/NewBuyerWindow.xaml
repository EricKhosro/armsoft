      <customWindowControls:CWCTextEditControl Name="TE_Birthday" Grid.Row="1" NullText="{x:Static coreCommon:Resources.DateFormat}" ShowNullText="True" Style="{StaticResource TouchModePrimaryTextEditStyle}" LostFocus="TE_Birthday_LostFocus" />
    </Grid>
    <Grid Row="12" Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditCaptionRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditRowDefintion}" />

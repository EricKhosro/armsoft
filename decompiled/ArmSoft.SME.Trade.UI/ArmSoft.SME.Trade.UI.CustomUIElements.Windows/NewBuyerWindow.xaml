    </Grid>
    <Grid Row="14" Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditCaptionRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditRowDefintion}" />
      </Grid.RowDefinitions>
      <dxe:ToggleSwitch Name="TW_IsBonusCard" Grid.Row="1" Style="{StaticResource TouchModePrimaryToggleSwitchStyle}" Checked="TW_IsBonusCard_Checked" Unchecked="TW_IsBonusCard_Unchecked" />
      <TextBlock Name="TB_ISBonusCard" Grid.Row="0" Style="{StaticResource TouchModePrimaryTextBlockStyle}" Text="{x:Static tradeCommon:Resources.BonusCard}" />

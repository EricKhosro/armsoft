      <tradeUserControls:NumericTouchPadControl ButtonClick="NumericTouchPadControlButton_Click" Grid.Row="0" Grid.RowSpan="9" Grid.Column="0" Grid.ColumnSpan="5" KeyboardNavigation.TabNavigation="None" RedesignedHideLastRow="False" />
      <customWindowControls:CWCSimpleButton Name="OKButton" Grid.Row="0" Grid.RowSpan="3" Grid.Column="6" IsDefault="True" IsTabStop="false" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="OKButton_Click">
        <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
          </Grid.RowDefinitions>
          <dx:DXImage Grid.Row="0" Style="{StaticResource TouchModeInsideButtonImageStyle}" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=accept_32_bold.svg}" />
          <Rectangle Style="{StaticResource TouchModeApplyButtonBottomLineRectangleStyle}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="TabButton" Grid.Row="4" Grid.RowSpan="3" Grid.Column="6" IsDefault="True" IsTabStop="false" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="TabButton_Click">
        <Grid Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
          <TextBlock Style="{StaticResource TouchModePrimarySimpleButtonTextBlockStyle}" Text="Tab" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="ExitButton" Grid.Row="8" Grid.Column="6" IsTabStop="false" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ExitButton_Click">
        <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
          </Grid.RowDefinitions>
          <dx:DXImage Style="{StaticResource TouchModeInsideButtonImageStyle}" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=cancel_32_bold.svg}" />
          <Rectangle Style="{StaticResource TouchModeCancelButtonBottomLineRectangleStyle}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
    </Grid>
    <Grid Row="10" Column="0" ColumnSpan="3">
      <Grid.RowDefinitions>
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditCaptionRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditRowDefintion}" />
      </Grid.RowDefinitions>
      <TextBlock Name="TB_Marking" Grid.Row="0" Style="{StaticResource TouchModePrimaryTextBlockStyle}" Text="{x:Static coreCommon:Resources.Marking}" />
      <Grid Name="MarkingContainerGrid" Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Style="{StaticResource TouchModeWithButtonFieldColumnDefintionStyle}" />
          <ColumnDefinition Style="{StaticResource TouchModePrimaryFieldsSeparatorLineColumnDefintionStyle}" />
          <ColumnDefinition Style="{StaticResource TouchModeWithFieldButtonColumnDefintionStyle}" />
        </Grid.ColumnDefinitions>
        <dxe:TextEdit Name="MarkingTextEdit" Grid.Column="0" Style="{StaticResource TouchModePrimaryTextEditStyle}" GotFocus="MarkingTextEdit_GotFocus" PreviewTextInput="MarkingTextEdit_PreviewTextInput" />
        <customWindowControls:CWCSimpleButton Name="MarkingButton" Grid.Column="2" Style="{StaticResource TouchModeWithFieldButtonStyle}" Click="MarkingButton_Click">
          <TextBlock Style="{StaticResource TouchModePrimarySimpleButtonTextBlockStyle}" Text="{x:Static coreCommon:Resources.Add}" />
        </customWindowControls:CWCSimpleButton>
      </Grid>
    </Grid>
    <dxg:GridControl Name="MarkingGrid" Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource MarkingDXGridControlStyle}">
      <dxg:GridControl.View>
        <dxg:TableView Name="MarkingTableView" Style="{StaticResource MarkingDXGridTableViewStyle}" />
      </dxg:GridControl.View>
      <dxg:GridColumn Name="Marking" FieldName="Column">
        <dxg:BaseColumn.HeaderTemplate>
          <DataTemplate>
            <TextBlock Style="{StaticResource MarkingDXGridColumnHeaderTextBlockStyle}" Text="{x:Static coreCommon:Resources.MarkingCodes}" />
          </DataTemplate>
        </dxg:BaseColumn.HeaderTemplate>
      </dxg:GridColumn>
      <dxg:GridColumn Name="DeleteButton" FieldName="DeleteButton" Style="{StaticResource CloseImageButtonColumnStyle}">
        <dxg:ColumnBase.CellTemplate>
          <DataTemplate>
            <Button Style="{StaticResource InsideColumnImageButtonStyle}" Click="DeleteRowButton_Click">
              <dx:DXImage Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=DeleteRowButton_24.svg}" />
            </Button>
          </DataTemplate>
        </dxg:ColumnBase.CellTemplate>
      </dxg:GridColumn>
    </dxg:GridControl>
    <TextBlock Name="CalcInfoTextBlock" Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource TouchModeBigImportantPrimaryFooterTextBlockStyle}" />
  </Grid>
</dx:ThemedWindow>
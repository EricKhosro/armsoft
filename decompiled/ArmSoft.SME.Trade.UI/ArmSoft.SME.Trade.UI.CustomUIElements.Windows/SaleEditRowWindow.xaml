      <Grid.RowDefinitions>
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditCaptionRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditRowDefintion}" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Style="{StaticResource TouchModePrimaryTextBlockStyle}" Text="{x:Static tradeCommon:Resources.MaterialOrService}" />
      <dxe:TextEdit Name="TE_Item" Grid.Row="1" Style="{StaticResource TouchModePrimaryReadonlyTextEditStyle}" />
    </Grid>
    <Grid Row="2" Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditCaptionRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditRowDefintion}" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Style="{StaticResource TouchModePrimaryTextBlockStyle}" Text="{x:Static coreCommon:Resources.Quantity}" />
      <TextBlock Name="ScaleProcessText" Grid.Row="0" HorizontalAlignment="Right" Style="{StaticResource TouchModePrimaryTextBlockStyle}" />
      <Grid Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Style="{StaticResource TouchModeWithFieldOperationButtonColumnDefintionStyle}" />
          <ColumnDefinition Style="{StaticResource TouchModePrimaryFieldsSeparatorLineColumnDefintionStyle}" />
          <ColumnDefinition Style="{StaticResource TouchModeWithButtonFieldColumnDefintionStyle}" />
          <ColumnDefinition Style="{StaticResource TouchModePrimaryFieldsSeparatorLineColumnDefintionStyle}" />
          <ColumnDefinition Style="{StaticResource TouchModeWithFieldOperationButtonColumnDefintionStyle}" />
        </Grid.ColumnDefinitions>
        <customWindowControls:CWCSimpleButton Name="QuantityDecreaseButton" Grid.Column="0" IsTabStop="False" Style="{StaticResource TouchModeWithFieldButtonStyle}" Click="QuantityDecreaseButton_Click">
          <TextBlock Style="{StaticResource TouchModePrimarySimpleButtonTextBlockStyle}" Text="-" />
        </customWindowControls:CWCSimpleButton>
        <dxe:PopupCalcEdit Name="QuantityTextEdit" Grid.Column="2" Mask="#,###,###,###,##0.000" Precision="3" Style="{StaticResource TouchModePrimaryPopupCalcEditStyle}" EditValueChanged="QuantityTextEdit_EditValueChanged" GotFocus="QuantityTextEdit_GotFocus" />
        <customWindowControls:CWCSimpleButton Name="QuantityIncreaseButton" Grid.Column="4" IsTabStop="False" Style="{StaticResource TouchModeWithFieldButtonStyle}" Click="QuantityIncreaseButton_Click">
          <TextBlock Style="{StaticResource TouchModePrimarySimpleButtonTextBlockStyle}" Text="+" />
        </customWindowControls:CWCSimpleButton>
      </Grid>
    </Grid>
    <Grid Row="4" Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditCaptionRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditRowDefintion}" />
      </Grid.RowDefinitions>
      <TextBlock Name="SalePriceTitleTextBlock" Grid.Row="0" Style="{StaticResource TouchModePrimaryTextBlockStyle}" Text="{x:Static coreCommon:Resources.MTTAccSalePrice}" />
      <dxe:PopupCalcEdit Name="PriceTextEdit" Grid.Row="1" Style="{StaticResource TouchModePrimaryPopupCalcEditStyle}" EditValueChanged="PriceTextEdit_EditValueChanged" GotFocus="PriceTextEdit_GotFocus" />
    </Grid>
    <Grid Row="6" Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditCaptionRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditRowDefintion}" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Style="{StaticResource TouchModePrimaryTextBlockStyle}" Text="{x:Static coreCommon:Resources.Unit}" />
      <Grid Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Style="{StaticResource TouchModeWithButtonFieldColumnDefintionStyle}" />
          <ColumnDefinition Style="{StaticResource TouchModePrimaryFieldsSeparatorLineColumnDefintionStyle}" />
          <ColumnDefinition Style="{StaticResource TouchModeWithFieldButtonColumnDefintionStyle}" />
        </Grid.ColumnDefinitions>
        <dxe:TextEdit Name="TE_Unit" Grid.Column="0" Style="{StaticResource TouchModePrimaryReadonlyTextEditStyle}" />
        <customWindowControls:CWCSimpleButton Name="UnitButton" Grid.Column="2" Style="{StaticResource TouchModeWithFieldButtonStyle}" Click="UnitButton_Click">
          <TextBlock Style="{StaticResource TouchModePrimarySimpleButtonTextBlockStyle}" Text="{x:Static coreCommon:Resources.ChooseWord}" />
        </customWindowControls:CWCSimpleButton>
      </Grid>
    </Grid>
    <Grid Row="8" Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditCaptionRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditRowDefintion}" />
      </Grid.RowDefinitions>
      <TextBlock Name="SummTextEditLabel" Grid.Row="0" Style="{StaticResource TouchModePrimaryTextBlockStyle}" Text="{x:Static tradeCommon:Resources.DiscountedSumm}" />
      <dxe:PopupCalcEdit Name="SummTextEdit" Grid.Row="1" Style="{StaticResource TouchModePrimaryPopupCalcEditStyle}" EditValueChanged="SummTextEdit_EditValueChanged" GotFocus="SummTextEdit_GotFocus" />
    </Grid>
    <Grid Row="2" RowSpan="7" Column="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />

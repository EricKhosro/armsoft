<?xml version="1.0" encoding="utf-8"?>
<dx:ThemedWindow x:Class="ArmSoft.SME.Trade.UI.CustomUIElements.Windows.SaleEditRowWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:coreCommon="clr-namespace:ArmSoft.SME.Common;assembly=ArmSoft.SME.Common" xmlns:customWindowControls="clr-namespace:ArmSoft.SME.Core.UI.CustomWindowControls;assembly=ArmSoft.SME.Core.UI" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:tradeCommon="clr-namespace:ArmSoft.SME.Trade.Common;assembly=ArmSoft.SME.Trade.Common" xmlns:tradeUserControls="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.UserControls" Title="{x:Static coreCommon:Resources.Edit}" Width="680" Height="720" MinWidth="680" MinHeight="720" Style="{StaticResource TouchModeBaseThemedWindowStyle}" WindowStartupLocation="CenterOwner" xmlns:windows="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.Windows" PreviewKeyDown="ThemedWindow_PreviewKeyDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="MarkingDXGridControlStyle" TargetType="{x:Type dxg:GridControl}">
        <Setter Property="dxg:DataControlBase.SelectionMode" Value="Cell" />
        <Setter Property="dxg:DataControlBase.AutoGenerateColumns" Value="None" />
      </Style>
      <Style x:Key="MarkingDXGridTableViewStyle" TargetType="{x:Type dxg:TableView}">
        <Setter Property="dxg:TableView.AllowBestFit" Value="True" />
        <Setter Property="dxg:DataViewBase.AllowColumnFiltering" Value="True" />
        <Setter Property="dxg:DataViewBase.AllowColumnMoving" Value="False" />
        <Setter Property="dxg:DataViewBase.AllowEditing" Value="False" />
        <Setter Property="dxg:GridViewBase.AllowGrouping" Value="False" />
        <Setter Property="dxg:DataViewBase.AllowLeaveFocusOnTab" Value="True" />
        <Setter Property="dxg:DataViewBase.AllowMoveColumnToDropArea" Value="False" />
        <Setter Property="dxg:DataViewBase.AllowSorting" Value="False" />
        <Setter Property="dxg:TableView.AutoWidth" Value="True" />
        <Setter Property="dxg:DataViewBase.EditorButtonShowMode" Value="ShowForFocusedCell" />
        <Setter Property="dxg:DataViewBase.EditorShowMode" Value="MouseDown" />
        <Setter Property="dxg:DataViewBase.EnterMoveNextColumn" Value="True" />
        <Setter Property="dxg:GridViewBase.IsGroupPanelMenuEnabled" Value="False" />
        <Setter Property="dxg:DataViewBase.IsRowCellMenuEnabled" Value="True" />
        <Setter Property="dxg:DataViewBase.IsTotalSummaryMenuEnabled" Value="False" />
        <Setter Property="dxg:DataViewBase.NavigationStyle" Value="Row" />
        <Setter Property="dxg:TableView.NewItemRowPosition" Value="None" />
        <Setter Property="dxg:TableView.RowMinHeight" Value="30" />
        <Setter Property="dxg:DataViewBase.ShowFocusedRectangle" Value="False" />
        <Setter Property="dxg:GridViewBase.ShowGroupPanel" Value="False" />
        <Setter Property="dxg:GridViewBase.ShowGroupedColumns" Value="False" />
        <Setter Property="dxg:DataViewBase.ShowTotalSummary" Value="False" />
        <Setter Property="dxg:TableView.UseEvenRowBackground" Value="False" />
        <Setter Property="dxg:TableView.VerticalScrollbarVisibility" Value="Auto" />
      </Style>
      <Style x:Key="CloseImageButtonColumnStyle" TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="dxg:BaseColumn.Width" Value="70" />
        <Setter Property="dxg:BaseColumn.MinWidth" Value="70" />
        <Setter Property="dxg:BaseColumn.MaxWidth" Value="70" />
        <Setter Property="dxg:BaseColumn.Header" Value=" " />
      </Style>
      <Style x:Key="MarkingDXGridColumnHeaderTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="Text" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="InsideColumnImageButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <StackPanel Name="BtnStackPanel">
                <ContentPresenter Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Width}" />
              </StackPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <SolidColorBrush x:Key="{dxt:ThemedWindowThemeKey ResourceKey=WindowActiveBorderBrush}" Color="{ext:ThemeBasedNotBrushedColor #206f37#206f37}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Style="{StaticResource TouchModeSingleWindowContainerGridStyle}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Style="{StaticResource TouchModeWithFieldsWindowFieldsColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryFieldsSeparatorLineColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModeWithFieldsWindowNumPadColumnDefintionStyle}" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Style="{StaticResource TouchModePrimaryTextEditWithCaptionRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryTextEditsSeparatorLineRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryTextEditWithCaptionRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryTextEditsSeparatorLineRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryTextEditWithCaptionRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryTextEditsSeparatorLineRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryTextEditWithCaptionRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryTextEditsSeparatorLineRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryTextEditWithCaptionRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryTextEditsSeparatorLineRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryTextEditWithCaptionRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryTextEditsSeparatorLineRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModeImportantEmptyContentRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryTextEditsSeparatorLineRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModeFooterImportantInfoRowDefintionStyle}" />

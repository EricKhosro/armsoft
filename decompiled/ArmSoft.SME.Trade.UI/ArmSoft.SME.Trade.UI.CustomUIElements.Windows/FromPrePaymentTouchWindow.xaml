<?xml version="1.0" encoding="utf-8"?>
<dx:ThemedWindow x:Class="ArmSoft.SME.Trade.UI.CustomUIElements.Windows.FromPrePaymentTouchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:coreCommon="clr-namespace:ArmSoft.SME.Common;assembly=ArmSoft.SME.Common" xmlns:customWindowControls="clr-namespace:ArmSoft.SME.Core.UI.CustomWindowControls;assembly=ArmSoft.SME.Core.UI" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:tradeCommon="clr-namespace:ArmSoft.SME.Trade.Common;assembly=ArmSoft.SME.Trade.Common" xmlns:tradeUserControls="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.UserControls" Title="{x:Static tradeCommon:Resources.UsePrePayment}" Width="450" Height="560" MinWidth="450" MinHeight="560" Style="{StaticResource TouchModeBaseThemedWindowStyle}" WindowStartupLocation="CenterOwner" xmlns:windows="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.Windows" KeyDown="PrintPrePaymentTouchWindow_KeyDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="PrintModeButtonStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{ext:ThemeBasedColor BlackWhite}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <Border Background="{TemplateBinding Control.Background}" BorderThickness="1" BorderBrush="{ext:ThemeBasedColor Green#606862}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="true">
                  <Setter Property="Background" Value="{ext:ThemeBasedColor #def0e0#49504b}" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="true">
                  <Setter Property="Background" Value="{ext:ThemeBasedColor #86bfa0#626a64}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Style="{StaticResource TouchModeSingleWindowContainerGridStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Row="0" Style="{StaticResource TouchModeBaseContainerGridStyle}">
      <Grid.RowDefinitions>
        <RowDefinition Style="{StaticResource TouchModePrimaryTextBlockRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModeInsideContainerSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryTextBlockRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModeInsideContainerSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryTextBlockRowDefintionStyle}" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Style="{StaticResource TouchModeHorizontalStackPanelStyle}">
        <TextBlock Name="TB_CardCaption" Style="{StaticResource TouchModePrimaryTextBlockStyle}" Text="{Binding Converter={StaticResource TextWithTwoDotsConverter}, ConverterParameter={x:Static tradeCommon:Resources.CardCapitalLetter}}" />
        <TextBlock Name="TB_CardNumber" Style="{StaticResource TouchModePrimaryTextBlockStyle}" />
      </StackPanel>
      <StackPanel Grid.Row="2" Style="{StaticResource TouchModeHorizontalStackPanelStyle}">
        <TextBlock Name="TB_CardHolderCaption" Grid.Row="0" Style="{StaticResource TouchModePrimaryTextBlockStyle}" Text="{Binding Converter={StaticResource TextWithTwoDotsConverter}, ConverterParameter={x:Static coreCommon:Resources.Name}}" />
        <TextBlock Name="TB_CardHolderName" Grid.Row="1" Style="{StaticResource TouchModePrimaryTextBlockStyle}" />
      </StackPanel>
      <StackPanel Grid.Row="4" Style="{StaticResource TouchModeHorizontalStackPanelStyle}">
        <TextBlock Name="TB_PartSummaCaption" Style="{StaticResource TouchModePrimaryTextBlockStyle}" Text="{Binding Converter={StaticResource TextWithTwoDotsConverter}, ConverterParameter={x:Static tradeCommon:Resources.PartnerRem}}" />
        <TextBlock Name="TB_PartSumma" Style="{StaticResource TouchModePrimaryTextBlockStyle}" />
      </StackPanel>
    </Grid>
    <Grid Row="1" Style="{StaticResource TouchModeBaseContainerGridStyle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
        <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Style="{StaticResource TouchModePrimaryTextEditRowDefintion}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
        <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
      </Grid.RowDefinitions>
      <dxe:TextEdit Name="TE_Code" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" Style="{StaticResource TouchModeSearchTextEditStyle}" />
      <tradeUserControls:NumericTouchPadControl ButtonClick="NumericTouchPadButton_Click" Grid.Row="2" Grid.RowSpan="9" Grid.Column="0" Grid.ColumnSpan="5" RedesignedHideLastRow="False" />
      <customWindowControls:CWCSimpleButton Name="ButtonOK1" Grid.Row="2" Grid.RowSpan="3" Grid.Column="6" IsDefault="True" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="OKButton_Click">
        <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
          </Grid.RowDefinitions>
          <dx:DXImage Name="OKButtonImage" Grid.Row="0" Style="{StaticResource TouchModeInsideButtonImageStyle}" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=accept_32_bold.svg}" />
          <Rectangle Style="{StaticResource TouchModeApplyButtonBottomLineRectangleStyle}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="CardButton" Grid.Row="6" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="CardButton_Click">
        <Grid Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
          </Grid.RowDefinitions>
          <TextBlock Name="CardButtonCaption1" Grid.Row="0" Style="{StaticResource TouchModeSecondarySimpleButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.DiscountBonusCard}" />
          <TextBlock Name="CardButtonCaption2" Grid.Row="1" Style="{StaticResource TouchModeSecondarySimpleButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.Card}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="ClearCardButton" Grid.Row="8" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ClearCardButton_Click">
        <Grid Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Name="ClearCardButtonCaption1" Grid.Row="0" Style="{StaticResource TouchModeSecondaryClearButtonTextBlockStyle}" Text="{x:Static coreCommon:Resources.ClearWord}" />
          <TextBlock Name="ClearCardButtonCaption2" Grid.Row="1" Style="{StaticResource TouchModeSecondaryClearButtonTextBlockStyle}" Text="{x:Static tradeCommon:Resources.TheCard}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
      <customWindowControls:CWCSimpleButton Name="ExitButton" Grid.Row="10" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ExitButton_Click">
        <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
            <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
          </Grid.RowDefinitions>
          <dx:DXImage Style="{StaticResource TouchModeInsideButtonImageStyle}" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=cancel_32_bold.svg}" />
          <Rectangle Style="{StaticResource TouchModeCancelButtonBottomLineRectangleStyle}" />
        </Grid>
      </customWindowControls:CWCSimpleButton>
    </Grid>
  </Grid>
</dx:ThemedWindow>
<?xml version="1.0" encoding="utf-8"?>
<dx:ThemedWindow x:Class="ArmSoft.SME.Trade.UI.CustomUIElements.Windows.CashIOTouchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:coreCommon="clr-namespace:ArmSoft.SME.Common;assembly=ArmSoft.SME.Common" xmlns:customWindowControls="clr-namespace:ArmSoft.SME.Core.UI.CustomWindowControls;assembly=ArmSoft.SME.Core.UI" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:tradeUserControls="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.UserControls" Width="400" Height="440" MinWidth="400" MinHeight="420" Style="{StaticResource TouchModeBaseThemedWindowStyle}" WindowStartupLocation="CenterOwner" xmlns:windows="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.Windows">
  <Grid Style="{StaticResource TouchModeSingleWindowContainerGridStyle}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorColumnDefintionStyle}" />
      <ColumnDefinition Style="{StaticResource TouchModePrimaryButtonColumnDefintionStyle}" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Style="{StaticResource TouchModePrimaryTextEditRowDefintion}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonsSeparatorRowDefintionStyle}" />
      <RowDefinition Style="{StaticResource TouchModePrimaryButtonRowDefintionStyle}" />
    </Grid.RowDefinitions>
    <dxe:TextEdit Name="CashAmount" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" Style="{StaticResource TouchModeSearchTextEditStyle}" />
    <tradeUserControls:NumericTouchPadControl ButtonClick="NumericTouchPadControlButton_Click" Grid.Row="2" Grid.RowSpan="9" Grid.Column="0" Grid.ColumnSpan="5" RedesignedHideLastRow="False" />
    <customWindowControls:CWCSimpleButton Name="PrintButton" Grid.Row="2" Grid.RowSpan="3" Grid.Column="6" IsDefault="True" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="PrintButton_Click">
      <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
        <Grid.RowDefinitions>
          <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
          <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
        </Grid.RowDefinitions>
        <Grid Row="0" Style="{StaticResource TouchModePrimaryButtonContainerGridStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
            <RowDefinition Style="{StaticResource TouchModeManyRowedButtonRowDefintionStyle}" />
          </Grid.RowDefinitions>
          <TextBlock Name="TB_PrintButton" Grid.Row="0" Style="{StaticResource TouchModePrimaryBigSimpleButtonTextBlockStyle}" Text="{x:Static coreCommon:Resources.Print}" />
          <TextBlock Name="TB_PrintButtonECRC" Grid.Row="1" Style="{StaticResource TouchModePrimaryBigSimpleButtonTextBlockStyle}" Text="{x:Static coreCommon:Resources.ECRC}" />
        </Grid>
        <Rectangle Style="{StaticResource TouchModeApplyButtonBottomLineRectangleStyle}" />
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="OKButton" Grid.Row="6" Grid.RowSpan="3" Grid.Column="6" IsDefault="True" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="OKButton_Click">
      <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
        <Grid.RowDefinitions>
          <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
          <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
        </Grid.RowDefinitions>
        <dx:DXImage Grid.Row="0" Style="{StaticResource TouchModeInsideButtonImageStyle}" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=accept_32_bold.svg}" />
        <Rectangle Style="{StaticResource TouchModeImportantOperationButtonBottomLineRectangleStyle}" />
      </Grid>
    </customWindowControls:CWCSimpleButton>
    <customWindowControls:CWCSimpleButton Name="ExitButton" Grid.Row="10" Grid.Column="6" Style="{StaticResource TouchModePrimaryButtonStyle}" Click="ExitButton_Click">
      <Grid Style="{StaticResource TouchModeButtonWithBottomLineContainerGridStyle}">
        <Grid.RowDefinitions>
          <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonContentRowDefintion}" />
          <RowDefinition Style="{StaticResource TouchModeUnderlinedButtonBottomLineRowDefintion}" />
        </Grid.RowDefinitions>
        <dx:DXImage Style="{StaticResource TouchModeInsideButtonImageStyle}" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=cancel_32_bold.svg}" />
        <Rectangle Style="{StaticResource TouchModeCancelButtonBottomLineRectangleStyle}" />
      </Grid>
    </customWindowControls:CWCSimpleButton>
  </Grid>
</dx:ThemedWindow>
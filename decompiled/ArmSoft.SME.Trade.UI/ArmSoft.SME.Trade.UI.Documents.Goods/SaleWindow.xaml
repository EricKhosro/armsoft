<?xml version="1.0" encoding="utf-8"?>
<baseDocWindows:BasePOSSaleWindow x:Class="ArmSoft.SME.Trade.UI.Documents.Goods.SaleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:baseDocWindows="clr-namespace:ArmSoft.SME.Trade.UI.Documents.Base" xmlns:coreCommon="clr-namespace:ArmSoft.SME.Common;assembly=ArmSoft.SME.Common" xmlns:coreConverters="clr-namespace:ArmSoft.SME.Core.UI.Converters;assembly=ArmSoft.SME.Core.UI" xmlns:customWindowControls="clr-namespace:ArmSoft.SME.Core.UI.CustomWindowControls;assembly=ArmSoft.SME.Core.UI" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:tradeCommon="clr-namespace:ArmSoft.SME.Trade.Common;assembly=ArmSoft.SME.Trade.Common" xmlns:tradeUserControls="clr-namespace:ArmSoft.SME.Trade.UI.CustomUIElements.UserControls" x:Name="POSSaleWindow" Activated="SaleWindow_Activated" Closed="SaleWindow_Closed" PreviewKeyDown="SaleWindow_PreviewKeyDown" Width="1024" Height="768" BorderThickness="1" FontFamily="Tahoma" ResizeMode="NoResize" WindowState="Normal" xmlns:goods="clr-namespace:ArmSoft.SME.Trade.UI.Documents.Goods" Background="{ext:ThemeBasedColor #f8f8f8#212121}" BorderBrush="{ext:ThemeBasedColor #217346#606862}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="CellStyle" TargetType="{x:Type dxg:LightweightCellEditor}" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
        <Setter Property="FrameworkElement.Tag" Value="{Binding Column.Name}" />
      </Style>
      <Style x:Key="AutoFilterCellStyle" TargetType="{x:Type dxg:FilterCellContentPresenter}" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=CellStyle}}">
        <Setter Property="FrameworkElement.Tag" Value="{Binding Column.Name}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="MainGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="75" />
      <ColumnDefinition Name="CodeColumn" Width="500" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="100" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="285" />
      <RowDefinition Height="25" />
    </Grid.RowDefinitions>
    <tradeUserControls:SaleHeaderUserControl x:Name="SaleHeader" ButtonClick="SaleHeader_ButtonClick" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="12,5,12,5" />
    <tradeUserControls:SaleGoodUserControl x:Name="MaterialInfo" ButtonClick="MaterialInfo_ButtonClick" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="12,0,5,0" />
    <tradeUserControls:SaleBonusInfoUserControl x:Name="BonusInfo" Grid.Row="1" Grid.Column="3" Margin="0,0,12,0" />
    <dxe:TextEdit Name="CodeTextEdit" Grid.Row="2" Grid.Column="3" Margin="0,10,12,5" VerticalAlignment="Top" FontSize="20" FontWeight="Normal" UseLayoutRounding="True" BorderBrush="{ext:ThemeBasedColor #318a58#318a58}" KeyDown="CodeTextEdit_KeyDown" PreviewTextInput="CodeTextEdit_PreviewTextInput" />
    <customWindowControls:CWCSimpleButton Name="BE_TouchPadChange" Grid.Row="2" Grid.Column="2" VerticalAlignment="Top" UseLayoutRounding="True" Click="BE_TouchPadChange_Click">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Button}">
          <Setter Property="Background" Value="{ext:ThemeBasedColor #fdfdfd#49504b}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type Button}">
                <Border Background="{TemplateBinding Control.Background}" BorderThickness="1" CornerRadius="0" BorderBrush="{ext:ThemeBasedColor #b7b7b7#606862}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </FrameworkElement.Style>
      <StackPanel Orientation="Vertical">
        <Image Name="ButtonTouchPadImage" Width="40" Height="28" Margin="0" Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=keyboard_switch_1_32.svg}" />
      </StackPanel>
    </customWindowControls:CWCSimpleButton>
    <dxg:GridControl Name="GridControl" Grid.Row="2" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="12,10,5,0" AllowLiveDataShaping="True" AutoGenerateColumns="None" SelectionMode="Cell">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <coreConverters:DeletedRowTextStyle x:Key="DeletedRowTextStyle" />
          <ControlTemplate x:Key="DeletedColumnTemplate">
            <TextBlock Name="PART_Editor" Padding="2,2,3,2" TextDecorations="{Binding Path=DataContext.RowData.Row.IsDeleted, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DeletedRowTextStyle}}" />
          </ControlTemplate>
          <ControlTemplate x:Key="ClickableColumnTemplate">
            <TextBlock Name="PART_Editor" Padding="2,2,3,2" Foreground="{ext:ThemeBasedColor MediumBlue#58b8fe}" TextDecorations="{Binding Path=DataContext.RowData.Row.IsDeleted, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DeletedRowTextStyle}}" />
          </ControlTemplate>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <dxg:GridControl.View>
        <dxg:TableView Name="InnerView" dx:ScrollBarExtensions.ScrollBarMode="TouchOverlap" AllowBestFit="True" AllowColumnFiltering="False" AllowColumnMoving="False" AllowEditing="False" AllowFormatConditionFiltersMenu="False" AllowGrouping="False" AllowLeaveFocusOnTab="True" AllowMoveColumnToDropArea="False" AllowSorting="False" AutoFilterRowCellStyle="{StaticResource AutoFilterCellStyle}" AutoWidth="True" CellStyle="{StaticResource CellStyle}" EditorButtonShowMode="ShowForFocusedCell" EditorShowMode="MouseDown" EnterMoveNextColumn="True" IsGroupPanelMenuEnabled="False" IsRowCellMenuEnabled=" True" IsTotalSummaryMenuEnabled="False" NavigationStyle="Row" NewItemRowPosition="None" RowMinHeight="30" ShowEmptyText="True" ShowFocusedRectangle="False" ShowGroupPanel="False" ShowGroupedColumns="False" ShowTotalSummary="False" UseEvenRowBackground="False" VerticalScrollbarVisibility="Auto">
          <dxg:DataViewBase.RuntimeLocalizationStrings>
            <dxg:GridRuntimeStringCollection>
              <dxg:RuntimeStringIdInfo Id="NoRecords" Value="{x:Static tradeCommon:Resources.ValidateEmptyMtList}" />
            </dxg:GridRuntimeStringCollection>
          </dxg:DataViewBase.RuntimeLocalizationStrings>
        </dxg:TableView>
      </dxg:GridControl.View>
      <dxg:GridColumn Name="BarCode" Width="80" DisplayTemplate="{StaticResource DeletedColumnTemplate}" FieldName="BarCode" Header="Գծիկավոր կոդ">
        <dxg:BaseColumn.HeaderTemplate>
          <DataTemplate>
            <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{x:Static coreCommon:Resources.BarCode}" TextAlignment="Right" />
          </DataTemplate>
        </dxg:BaseColumn.HeaderTemplate>
      </dxg:GridColumn>
      <dxg:GridColumn Name="ItemCode" Width="50" DisplayTemplate="{StaticResource DeletedColumnTemplate}" FieldName="ItemCode" Header="Կոդ">
        <dxg:BaseColumn.HeaderTemplate>
          <DataTemplate>
            <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{x:Static coreCommon:Resources.Code}" TextAlignment="Right" />
          </DataTemplate>
        </dxg:BaseColumn.HeaderTemplate>
      </dxg:GridColumn>
      <dxg:GridColumn Name="ItemName" Width="200" DisplayTemplate="{StaticResource DeletedColumnTemplate}" FieldName="ItemName" Header="Անվանում">
        <dxg:BaseColumn.HeaderTemplate>
          <DataTemplate>
            <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{x:Static coreCommon:Resources.Name}" TextAlignment="Right" />
          </DataTemplate>
        </dxg:BaseColumn.HeaderTemplate>
      </dxg:GridColumn>
      <dxg:GridColumn Name="Quantity" Width="60" DisplayTemplate="{StaticResource ClickableColumnTemplate}" FieldName="Quantity" Header="Քանակ">
        <dxg:ColumnBase.EditSettings>
          <dxe:TextEditSettings AllowNullInput="False" AllowSpinOnMouseWheel="False" Mask="#,###,###,###,##0.000" MaskType="Numeric" MaskUseAsDisplayFormat="True" ValidateOnTextInput="False" />
        </dxg:ColumnBase.EditSettings>
        <dxg:BaseColumn.HeaderTemplate>
          <DataTemplate>
            <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{x:Static coreCommon:Resources.Quantity}" TextAlignment="Right" />
          </DataTemplate>
        </dxg:BaseColumn.HeaderTemplate>
      </dxg:GridColumn>
      <dxg:GridColumn Name="Price" Width="80" DisplayTemplate="{StaticResource ClickableColumnTemplate}" FieldName="Price" Header="Վաճառքի գին">
        <dxg:ColumnBase.EditSettings>
          <dxe:TextEditSettings AllowNullInput="False" AllowSpinOnMouseWheel="False" Mask="#,###,###,###,##0.00" MaskType="Numeric" MaskUseAsDisplayFormat="True" ValidateOnTextInput="False" />
        </dxg:ColumnBase.EditSettings>
        <dxg:BaseColumn.HeaderTemplate>
          <DataTemplate>
            <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{x:Static coreCommon:Resources.MTTAccSalePrice}" TextAlignment="Right" />
          </DataTemplate>
        </dxg:BaseColumn.HeaderTemplate>
      </dxg:GridColumn>
      <dxg:GridColumn Name="Summa" Width="80" DisplayTemplate="{StaticResource ClickableColumnTemplate}" FieldName="Summa" Header="Զեղչված գումար">
        <dxg:ColumnBase.EditSettings>
          <dxe:TextEditSettings AllowNullInput="False" AllowSpinOnMouseWheel="False" Mask="#,###,###,###,##0.00" MaskType="Numeric" MaskUseAsDisplayFormat="True" ValidateOnTextInput="False" />
        </dxg:ColumnBase.EditSettings>
        <dxg:BaseColumn.HeaderTemplate>
          <DataTemplate>
            <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{x:Static tradeCommon:Resources.DiscountedSumm}" TextAlignment="Right" />
          </DataTemplate>
        </dxg:BaseColumn.HeaderTemplate>
      </dxg:GridColumn>
      <dxg:GridColumn Name="AccumulatedBonus" Width="70" DisplayTemplate="{StaticResource DeletedColumnTemplate}" FieldName="AccumulatedBonus" Header="Բոնուսի կուտակում">
        <dxg:ColumnBase.EditSettings>
          <dxe:TextEditSettings AllowNullInput="False" AllowSpinOnMouseWheel="False" Mask="#,###,###,###,##0.00" MaskType="Numeric" MaskUseAsDisplayFormat="True" ValidateOnTextInput="False" />
        </dxg:ColumnBase.EditSettings>
        <dxg:BaseColumn.HeaderTemplate>
          <DataTemplate>
            <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{x:Static tradeCommon:Resources.BonusAccumulation}" TextAlignment="Right" />
          </DataTemplate>
        </dxg:BaseColumn.HeaderTemplate>
      </dxg:GridColumn>
      <dxg:GridColumn Name="DeleteRowButton" Width="70" MinWidth="70" MaxWidth="70" FieldName="DeleteButton" Header=" ">
        <dxg:ColumnBase.CellTemplate>
          <DataTemplate>
            <Button Width="40" Click="OnDeleteRowButtonClick">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Button}">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="{x:Type Button}">
                        <StackPanel Name="BtnStackPanel">
                          <ContentPresenter Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Width}" />
                        </StackPanel>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </FrameworkElement.Style>
              <dx:DXImage Source="{Binding Converter={StaticResource ImageByNameConverter}, ConverterParameter=DeleteRowButton_24.svg}" />
            </Button>
          </DataTemplate>
        </dxg:ColumnBase.CellTemplate>
      </dxg:GridColumn>
    </dxg:GridControl>
    <tradeUserControls:SaleTotalUserControl x:Name="TotalInfo" Grid.Row="5" Grid.Column="0" Margin="12,10,5,7" />
    <tradeUserControls:SaleStatusBarUserControl x:Name="StatusBar" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" />
  </Grid>
</baseDocWindows:BasePOSSaleWindow>
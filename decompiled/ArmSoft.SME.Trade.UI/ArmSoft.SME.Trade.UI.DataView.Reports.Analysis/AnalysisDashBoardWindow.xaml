<?xml version="1.0" encoding="utf-8"?>
<dxdo:DocumentPanel x:Class="ArmSoft.SME.Trade.UI.DataView.Reports.Analysis.AnalysisDashBoardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:ArmSoft.SME.Core.UI.Converters;assembly=ArmSoft.SME.Core.UI" xmlns:core="clr-namespace:ArmSoft.SME.Core.UI.Controls;assembly=ArmSoft.SME.Core.UI" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts" xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" xmlns:ext="clr-namespace:ArmSoft.SME.Core.UI.Extensions;assembly=ArmSoft.SME.Core.UI" xmlns:local="clr-namespace:ArmSoft.SME.Trade.UI.DataView.Reports.Analysis" xmlns:ve="http://schemas.devexpress.com/winfx/2008/xaml/docking/visualelements">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <conv:GetFontFamily x:Key="GetFontFamily" />
      <conv:GetFontSize x:Key="GetFontSize" />
      <ControlTemplate x:Key="MaximizeButtonTemplate">
        <dx:DXImage Width="16" Height="16" Margin="2" Source="{ext:ASImage expand_16.svg}" />
      </ControlTemplate>
      <ControlTemplate x:Key="RestoreButtonTemplate">
        <dx:DXImage Width="16" Height="16" Margin="2" Source="{ext:ASImage collapse_16.svg}" />
      </ControlTemplate>
      <ControlTemplate x:Key="HideButtonTemplate">
        <dx:DXImage Width="16" Height="16" Margin="2" Source="{ext:ASImage down_16.svg}" />
      </ControlTemplate>
      <ControlTemplate x:Key="UnHideButtonTemplate">
        <dx:DXImage Width="16" Height="16" Margin="2" Source="{ext:ASImage up_16.svg}" />
      </ControlTemplate>
      <local:PanelStateConverter x:Key="PanelStateConverter" />
      <Style x:Key="{x:Type ve:PanelControlBoxControl}" TargetType="{x:Type ve:PanelControlBoxControl}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ve:PanelControlBoxControl}">
              <StackPanel Width="Auto" Orientation="Horizontal">
                <Button Template="{StaticResource HideButtonTemplate}" Click="HidePanel">
                  <UIElement.Visibility>
                    <MultiBinding ConverterParameter="Hide" Converter="{StaticResource PanelStateConverter}">
                      <Binding Path="IsAutoHidden" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource AncestorType=dxdo:LayoutPanel, Mode=FindAncestor}" />
                      <Binding Path="AutoHideGroups.Count" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource AncestorType=dxdo:DockLayoutManager, Mode=FindAncestor}" />
                    </MultiBinding>
                  </UIElement.Visibility>
                </Button>
                <Button Template="{StaticResource UnHideButtonTemplate}" Click="UnHidePanel">
                  <UIElement.Visibility>
                    <MultiBinding ConverterParameter="UnHide" Converter="{StaticResource PanelStateConverter}">
                      <Binding Path="IsAutoHidden" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource AncestorType=dxdo:LayoutPanel, Mode=FindAncestor}" />
                      <Binding Path="AutoHideGroups.Count" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource AncestorType=dxdo:DockLayoutManager, Mode=FindAncestor}" />
                    </MultiBinding>
                  </UIElement.Visibility>
                </Button>
                <Button Template="{StaticResource MaximizeButtonTemplate}" Click="MaximizePanel">
                  <UIElement.Visibility>
                    <MultiBinding ConverterParameter="Maximize" Converter="{StaticResource PanelStateConverter}">
                      <Binding Path="IsAutoHidden" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource AncestorType=dxdo:LayoutPanel, Mode=FindAncestor}" />
                      <Binding Path="AutoHideGroups.Count" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource AncestorType=dxdo:DockLayoutManager, Mode=FindAncestor}" />
                    </MultiBinding>
                  </UIElement.Visibility>
                </Button>
                <Button Template="{StaticResource RestoreButtonTemplate}" Click="RestorePanel">
                  <UIElement.Visibility>
                    <MultiBinding ConverterParameter="Restore" Converter="{StaticResource PanelStateConverter}">
                      <Binding Path="IsAutoHidden" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource AncestorType=dxdo:LayoutPanel, Mode=FindAncestor}" />
                      <Binding Path="AutoHideGroups.Count" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource AncestorType=dxdo:DockLayoutManager, Mode=FindAncestor}" />
                    </MultiBinding>
                  </UIElement.Visibility>
                </Button>
                <ContentPresenter Name="PART_CustomContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </StackPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="RibbonPageHeaderTemplate">
        <StackPanel Orientation="Horizontal">
          <TextBlock Margin="0" VerticalAlignment="Center" FontFamily="{Binding Converter={StaticResource GetFontFamily}}" FontSize="{Binding Converter={StaticResource GetFontSize}}" Text="{Binding}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Style.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter Property="FontWeight" Value="Normal" />
                  </Trigger>
                  <Trigger Property="UIElement.IsMouseOver" Value="False">
                    <Setter Property="FontWeight" Value="Normal" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <dxb:BarManager Name="BarManager">
    <dxb:BarManager.Items>
      <dxb:BarButtonItem Name="bRefreshDataView" Content="Refresh" KeyGesture="Control+R" Glyph="{ext:ASImage refresh_16.svg}" LargeGlyph="{ext:ASImage refresh_32.svg}" ItemClick="HandleButtonClick" />
      <dxb:BarButtonItem Name="bShowDataViewDialog" Content="Show Dialog" KeyGesture="Control+G" Glyph="{ext:ASImage table_refresh_16.svg}" LargeGlyph="{ext:ASImage table_refresh_32.svg}" ItemClick="HandleButtonClick" />
      <dxb:BarButtonItem Name="bRefreshAll" Content="RefreshAll" Glyph="{ext:ASImage refresh_16.svg}" LargeGlyph="{ext:ASImage refresh_32.svg}" ItemClick="HandleButtonClick" />
      <dxb:BarButtonItem Name="bDetails" Content="bDetails" Glyph="{ext:ASImage open_new_window_16.svg}" LargeGlyph="{ext:ASImage open_new_window_32.svg}" ItemClick="HandleButtonClick" />
      <dxb:BarButtonItem Name="BarButtonHelp" Content="Help" KeyGesture="F1" Glyph="{ext:ASImage help_16.svg}" LargeGlyph="{ext:ASImage help_32.svg}" />
    </dxb:BarManager.Items>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" MinHeight="0" />
        <RowDefinition Height="*" MinHeight="0" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <dxr:RibbonControl Name="RibbonControl" Grid.Row="0" Grid.Column="0" AllowCustomization="False" AllowKeyTips="True" RibbonStyle="Office2019" ShowApplicationButton="False" ToolbarShowMode="Default" UseLayoutRounding="True">
        <dxr:RibbonDefaultPageCategory Name="RibbonDefaultPageCategory">
          <dxr:RibbonPage Name="RibbonPageHome" Caption="Home" CaptionTemplate="{StaticResource RibbonPageHeaderTemplate}" MergeType="Replace">
            <dxr:RibbonPageGroup Name="RibbonPageGroupDataView" AllowCollapse="False" Caption="DataView" Glyph="{ext:ASImage table_16.svg}">
              <dxb:BarButtonItemLink BarItemName="bShowDataViewDialog" MergeType="Replace" RibbonStyle="Large" />
              <dxb:BarButtonItemLink BarItemName="bRefreshDataView" MergeType="Replace" RibbonStyle="Large" />
              <dxb:BarButtonItemLink BarItemName="bRefreshAll" MergeType="Replace" RibbonStyle="Large" />
              <dxb:BarButtonItemLink BarItemName="bDetails" MergeType="Replace" RibbonStyle="Large" />
              <dxb:BarItemLinkSeparator />
            </dxr:RibbonPageGroup>
          </dxr:RibbonPage>
          <dxr:RibbonPage Name="RibbonPageHelp" Caption="Help" CaptionTemplate="{StaticResource RibbonPageHeaderTemplate}" MergeOrder="4">
            <dxr:RibbonPageGroup Name="RibbonPageGroupHelp" Caption="Help">
              <dxb:BarButtonItemLink BarItemName="BarButtonHelp" MergeType="Replace" />
            </dxr:RibbonPageGroup>
          </dxr:RibbonPage>
        </dxr:RibbonDefaultPageCategory>
      </dxr:RibbonControl>
      <dxdo:DockLayoutManager Name="dockManager" Grid.Row="1" Grid.Column="0" AutoHideExpandMode="MouseDown">
        <dxdo:LayoutGroup Name="MainGroup" HorizontalAlignment="Stretch" DestroyOnClosingChildren="False" Orientation="Horizontal">
          <dxdo:LayoutGroup Name="LeftGroup" HorizontalAlignment="Stretch" AllowClose="False" ClosingBehavior="HideToClosedPanelsCollection" DestroyOnClosingChildren="False" Orientation="Vertical">
            <dxdo:LayoutPanel Name="BestSellersPanel" MinHeight="500" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AllowClose="False" AllowDock="True" AllowFloat="False" AllowHide="True" Caption="Best Sellers" FloatOnDoubleClick="False">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" MinHeight="0" />
                  <RowDefinition Height="Auto" MinHeight="0" />
                  <RowDefinition Height="*" MinHeight="0" />
                  <RowDefinition Height="2.5*" MinHeight="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel Name="sp" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" LastChildFill="True">
                  <TextBlock Name="txtBestSellersCaption" Grid.Row="0" Margin="3" HorizontalAlignment="Stretch" DockPanel.Dock="Top" TextAlignment="Left" />
                </DockPanel>
                <Border Grid.Row="1" Margin="15,6,11,4" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
                  <StackPanel Margin="6,0,6,3" Orientation="Horizontal">
                    <TextBlock Name="txtCode" Width="80" FontWeight="Bold" Text="Code" />
                    <TextBlock Name="txtCaption" Width="220" FontWeight="Bold" Text="Caption" />
                    <TextBlock Name="txtSumm" Width="120" FontWeight="Bold" Text="Summ" TextAlignment="Right" />
                  </StackPanel>
                </Border>
                <dxe:ListBoxEdit Name="BestSellersList" Grid.Row="2" Margin="4,0,4,0" DockPanel.Dock="Top" SelectedIndex="0" Background="{x:Null}">
                  <dxe:ListBoxEdit.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="12,4,12,4" Orientation="Horizontal">
                        <TextBlock Width="80" TextWrapping="Wrap" Text="{Binding Code}" />
                        <TextBlock Width="220" Margin="0,0,3,0" TextWrapping="Wrap" Text="{Binding Caption}" />
                        <TextBlock Width="120" TextAlignment="Right" Text="{Binding Sum}" />
                      </StackPanel>
                    </DataTemplate>
                  </dxe:ListBoxEdit.ItemTemplate>
                </dxe:ListBoxEdit>
                <core:AsChart Name="chtBestsellers" Grid.Row="4" MinHeight="100" VerticalAlignment="Stretch" />
              </Grid>
            </dxdo:LayoutPanel>
            <dxdo:LayoutPanel Name="CashBankPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AllowClose="False" AllowDock="True" AllowFloat="False" AllowHide="True" Caption="CashBank">
              <DockPanel Name="sp2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" LastChildFill="True">
                <TextBlock Name="txtCashBankCaption" Margin="3" HorizontalAlignment="Stretch" DockPanel.Dock="Top" Text="Caption" TextAlignment="Left" />
                <core:AsChart Name="chtCashBank" VerticalAlignment="Stretch" />
              </DockPanel>
            </dxdo:LayoutPanel>
          </dxdo:LayoutGroup>
          <dxdo:LayoutGroup Name="RightGroup" DestroyOnClosingChildren="False" Orientation="Vertical">
            <dxdo:LayoutPanel Name="SalesPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AllowClose="False" AllowDock="True" AllowFloat="False" AllowHide="True" Caption="Sales">
              <DockPanel Name="sp3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" LastChildFill="True">
                <TextBlock Name="txtSalesCaption" Margin="3" HorizontalAlignment="Stretch" DockPanel.Dock="Top" Text="Caption" TextAlignment="Left" />
                <core:AsChart Name="chtSales" VerticalAlignment="Stretch" />
              </DockPanel>
            </dxdo:LayoutPanel>
            <dxdo:LayoutPanel Name="DebtorsPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AllowClose="False" AllowDock="True" AllowFloat="False" AllowHide="True" Caption="Debtors/Creditors">
              <DockPanel Name="sp4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" LastChildFill="True">
                <TextBlock Name="txtDbCrCaption" Margin="3" HorizontalAlignment="Stretch" DockPanel.Dock="Top" Text="Caption" TextAlignment="Left" />
                <core:AsChart Name="chtDebtors" VerticalAlignment="Stretch" />
              </DockPanel>
            </dxdo:LayoutPanel>
          </dxdo:LayoutGroup>
        </dxdo:LayoutGroup>
      </dxdo:DockLayoutManager>
    </Grid>
  </dxb:BarManager>
</dxdo:DocumentPanel>